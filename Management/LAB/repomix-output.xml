/******************************************************** Signature Image */
.signature-container {
    display: flex;
    align-items: center;
    gap: 10px;
}

.signature-input {
    flex: 1;
}

.signature-image-container {
    position: relative;
    display: inline-block;
    cursor: pointer;
    border: 2px dashed #ccc;
    border-radius: 4px;
    padding: 5px;
    transition: all 0.3s ease;
    min-width: 90px;
    min-height: 50px;
}

    .signature-image-container:hover {
        border-color: #337ab7;
        background-color: #f8f9fa;
    }

.signature-preview {
    width: 80px;
    height: 40px;
    object-fit: contain;
    border-radius: 2px;
    display: block;
    background-color: white;
}

.signature-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    border-radius: 2px;
    font-size: 0.75rem;
}

.signature-image-container:hover .signature-overlay {
    opacity: 1;
}

.signature-overlay i {
    font-size: 1rem;
    margin-bottom: 2px;
}

.signature-file-input {
    display: none;
}

/* Default signature placeholder */
.signature-preview[src*="default-signature"] {
    background-color: #f8f9fa;
    border: 1px solid #dee2e6;
}

.th-serviceid, .th-servicename {
    text-align: center;
}

.th-servicename, .td-servicename {
    min-width: 180px;
}

.tr-title th {
    background: #f0f0f0;
}

.tr-subtitle th {
    background: #fafafa;
    font-weight: 500;
    font-size: 13px;
}

/* ============================================================
   RESPONSIVE - TRANG QUẢN LÝ NGƯỜI DÙNG (User)
   ============================================================ */

/* ---- Tablet (≤ 992px): Layout 2 cột → 1 cột ---- */
@media (max-width: 992px) {

    /* Menu: chuyển dọc */
    .menu {
        flex-direction: column;
    }

    .menu-left {
        width: 100%;
        float: none;
    }

    .menu-right {
        width: 100%;
        float: none;
        min-width: unset;
    }

    /* Settup layout: Left + Right → stack dọc */
    .settup-left {
        width: 100% !important;
        float: none;
        padding-right: 0;
    }

    .settup-right {
        width: 100% !important;
        float: none;
        margin-top: 10px;
    }

    /* Bảng user: giảm chiều cao cố định */
    .settup-left .settup-left-list {
        height: auto;
        max-height: 50vh;
        overflow-y: auto;
    }

    /* Khoa phòng checkbox: 3 cột thay vì 5 cột */
    .settup-right .settup-right-info .div-input .div-input-child-20 {
        width: 33.33%;
    }
}

/* ---- Mobile (≤ 768px) ---- */
@media (max-width: 768px) {

    /* Navbar */
    .menu-left-height {
        height: auto;
        min-height: 2.5rem;
    }

    .navbar-brand span {
        font-size: 0.8rem;
    }

    /* Container bớt padding */
    .container-fluid {
        padding-left: 5px;
        padding-right: 5px;
    }

    /* Title bar */
    .settup-left .settup-left-title-search {
        height: auto;
        flex-direction: column;
    }

        .settup-left .settup-left-title-search .title,
        .settup-left .settup-left-title-search .search {
            width: 100%;
            float: none;
        }

        .settup-left .settup-left-title-search .search {
            margin-top: 5px;
        }

    /* Bảng User: cuộn ngang + min-width */
    .settup-left .settup-left-list .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .settup-left .settup-left-list .table {
        min-width: 550px;
    }

    /* Ẩn cột Id trên mobile - ít quan trọng */
    .settup-left .settup-left-list .th-id,
    .settup-left .settup-left-list .td-id {
        display: none;
    }

    /* Cột CKS và CCCD thu nhỏ */
    .settup-left .settup-left-list .th-cks,
    .settup-left .settup-left-list .th-cccd {
        width: 18%;
    }

    /* Buttons user: flex wrap */
    .settup-right .settup-right-button {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

        .settup-right .settup-right-button button,
        .settup-right .settup-right-button button.user {
            width: auto !important;
            min-width: 80px;
            flex: 1 1 auto;
            padding: 0.3rem 0.5rem !important;
            min-height: 2.2rem;
        }

    /* Khoa phòng checkbox: 2 cột */
    .settup-right .settup-right-info .div-input .div-input-child-20 {
        width: 50%;
    }

    /* Signature container: stack dọc */
    .signature-container {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

    .signature-input {
        width: 100%;
    }

    .signature-image-container {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .signature-preview {
        width: 120px;
        height: 60px;
    }

    /* Password rules: wrap tốt hơn */
    .rule-character-password {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 10px;
    }

        .rule-character-password .rule-item {
            flex: 1 1 45%;
            min-width: 0;
        }

    /* Form Function modal: responsive */
    .user-function-content .row-function {
        width: 50%;
    }

    .hr {
        width: 100%;
    }
}

/* ---- Small Mobile (≤ 480px) ---- */
@media (max-width: 480px) {

    html {
        font-size: 11px;
    }

    /* Menu user dropdown */
    .menu-right-bg {
        font-size: 0.75rem;
    }

    /* Input cao hơn để dễ tap */
    .settup-right .form-control.height-28,
    .settup-right .form-select.height-28 {
        height: 2.2rem;
        font-size: 0.85rem;
    }

    /* Checkbox dễ tap */
    .settup-left .settup-left-list .td-checkbox .form-check-input,
    .settup-right .settup-right-info .form-check-input {
        width: 1.2rem;
        height: 1.2rem;
    }

    /* Khoa phòng checkbox: 1 cột trên màn rất nhỏ */
    .settup-right .settup-right-info .div-input .div-input-child-20 {
        width: 100%;
        margin-bottom: 4px;
    }

        .settup-right .settup-right-info .div-input .div-input-child-20 label {
            font-size: 0.85rem;
        }

    /* Buttons: full width mỗi nút 1 hàng */
    .settup-right .settup-right-button button,
    .settup-right .settup-right-button button.user {
        flex: 1 1 100% !important;
        min-height: 2.5rem;
        font-size: 0.85rem;
    }

    /* Bảng: ẩn thêm cột CKS trên màn rất nhỏ */
    .settup-left .settup-left-list .th-cks,
    .settup-left .settup-left-list .td-cks {
        display: none;
    }

    .settup-left .settup-left-list .table {
        min-width: 400px;
    }

    /* Row click area lớn hơn */
    .settup-left .settup-left-list .row-service td {
        padding-top: 4px !important;
        padding-bottom: 4px !important;
    }

    /* Password rules: 1 cột */
    .rule-character-password .rule-item {
        flex: 1 1 100%;
    }

    /* Form Function modal: 1 cột */
    .user-function-content {
        padding: 0px 10px;
    }

        .user-function-content .row-function {
            width: 100%;
        }

    /* Signature preview to hơn */
    .signature-preview {
        width: 100%;
        max-width: 200px;
        height: 80px;
    }

    /* Login form responsive */
    .login-child {
        min-width: unset;
        width: 90%;
        left: 50%;
        transform: translate(-50%, -50%);
    }
}
.setting-tabs {
