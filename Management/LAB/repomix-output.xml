/******************************************************** RESPONSIVE MOBILE */
@media (max-width: 768px) {
    /* Container chính - layout dạng cột */
    .xn-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 2.5rem); /* trừ chiều cao menu */
        margin-top: 0;
        position: relative;
    }

    /* Nút toggle danh sách bệnh nhân - dạng floating button */
    .mobile-toggle-patient-list {
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3rem;
        height: 3rem;
        background-color: #337ab7;
        color: white;
        border: none;
        border-radius: 0 0.5rem 0.5rem 0;
        font-size: 1.5rem;
        cursor: pointer;
        z-index: 1001;
        box-shadow: 2px 0 8px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
        padding: 0;
    }

        .mobile-toggle-patient-list:hover {
            background-color: #1e65a3;
            width: 3.5rem;
        }

        .mobile-toggle-patient-list i {
            transition: transform 0.3s ease;
        }

        .mobile-toggle-patient-list.active i {
            transform: rotate(90deg);
        }

    /* Overlay khi mở danh sách */
    .mobile-patient-list-overlay {
        display: none;
        position: fixed;
        top: 2.5rem;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
        transition: opacity 0.3s ease;
    }

        .mobile-patient-list-overlay.show {
            display: block;
        }

    /* Danh sách bệnh nhân - slide từ trái */
    .xn-left {
        width: 85%;
        max-width: 400px;
        height: calc(100vh - 2.5rem);
        padding: 0;
        position: fixed;
        top: 2.5rem;
        left: -100%;
        z-index: 1000;
        background-color: white;
        box-shadow: 2px 0 10px rgba(0,0,0,0.3);
        transition: left 0.3s ease;
        overflow-y: auto;
    }

        /* Khi toggle mở danh sách */
        .xn-left.show {
            left: 0;
        }

    /* Header của danh sách bệnh nhân */
    .xn-left-header {
        width: 100%;
        height: 2.5rem;
        background-color: #337ab7;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .xn-left-header-title {
        font-weight: bold;
        font-size: 1rem;
    }

    .xn-left-header-close {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Search box trong danh sách */
    .xn-left-search {
        width: 100%;
        height: auto;
        padding: 0.5rem;
        background-color: #f8f9fa;
    }

    /* Danh sách bệnh nhân */
    .xn-left-list {
        width: 100%;
        height: auto;
        max-height: calc(100vh - 2.5rem - 2.5rem - 10rem);
        overflow-y: auto;
        padding: 0 0.25rem;
    }

        .xn-left-list .total-patient {
            margin: 0.5rem 0.3rem;
            font-size: 15px;
            font-weight: 700;
            border-bottom: 1px dashed lightgray;
            padding-bottom: 0.5rem;
