/* Toàn bộ khối chữ ký: không cho ngắt trang bên trong, tách khỏi float trước đó */
.signature-page-sat {
    clear: both;
    break-inside: avoid;
    page-break-inside: avoid;
    padding-top: 6mm; /* tạo khoảng cách an toàn với phần trên */
}

    /* 2 cột: bên trái chỉ là khoảng trống, bên phải chứa toàn bộ thông tin */
    .signature-page-sat .signature {
        display: flex;
        justify-content: flex-end; /* dồn nội dung sang phải */
        align-items: flex-start;
        gap: 16px;
    }

        /* Cột trái làm “đệm” */
        .signature-page-sat .signature .signature-left {
            flex: 1 1 auto; /* chiếm phần còn lại để đẩy cột phải sang mép phải */
        }

        /* Cột phải chứa nội dung chữ ký */
        .signature-page-sat .signature .signature-right {
            width: 420px; /* tùy trang A4 dọc, bạn có thể 380–460px */
            text-align: center;
            font-size: 19px;
        }

            /* Dòng thời gian */
            .signature-page-sat .signature .signature-right .signature-right-time {
                line-height: 24px;
                margin-bottom: 5px;
            }

            /* Tiêu đề */
            .signature-page-sat .signature .signature-right .signature-right-title {
                font-weight: 700;
                line-height: 10px;
                margin-bottom: 5px;
            }

            /* Khung ảnh chữ ký – bỏ height cố định để tránh cắt ảnh */
            .signature-page-sat .signature .signature-right .signature-right-cks {
                /* KHÔNG dùng height: 55px; */
                min-height: 50px; /* giữ không gian tối thiểu */
                display: flex;
                align-items: center;
                justify-content: center;
            }

                /* Ảnh chữ ký – tự co giãn, không méo, không tràn khung */
                .signature-page-sat .signature .signature-right .signature-right-cks img {
                    max-width: 80%;
                    max-height: 100px; /* tăng/giảm nếu ảnh nhỏ/quá to */
                    height: auto;
                    width: auto;
                    object-fit: contain;
                    image-rendering: -webkit-optimize-contrast;
                }

            /* Tên bác sĩ – to, rõ, không bị đè */
            .signature-page-sat .signature .signature-right .signature-right-user {
                font-weight: 700;
                font-size: 21px;
                line-height: 24px;
                margin-top: .1rem;
            }

/* ====== RESPONSIVE CHO MOBILE (max-width: 768px) ====== */
@media (max-width: 768px) {
    html {
        font-size: 14px;
    }

    /* Container chính */
    .sat-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 2.5rem); /* trừ chiều cao menu */
        margin-top: 0;
        position: relative;
    }

    /* Ẩn danh sách bệnh nhân mặc định trên mobile */
    /* Nút toggle danh sách bệnh nhân - dạng floating button */
    .mobile-toggle-patient-list {
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3rem;
        height: 3rem;
        background-color: #337ab7;
        color: white;
        border: none;
        border-radius: 0 0.5rem 0.5rem 0;
        font-size: 1.5rem;
        cursor: pointer;
        z-index: 1001;
        box-shadow: 2px 0 8px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
        padding: 0;
    }

        .mobile-toggle-patient-list:hover {
            background-color: #1e65a3;
            width: 3.5rem;
        }

        .mobile-toggle-patient-list i {
            transition: transform 0.3s ease;
        }

        .mobile-toggle-patient-list.active i {
            transform: rotate(90deg);
        }

    /* Overlay khi mở danh sách */
    .mobile-patient-list-overlay {
        display: none;
        position: fixed;
        top: 2.5rem;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
        transition: opacity 0.3s ease;
    }

        .mobile-patient-list-overlay.show {
            display: block;
        }

    /* Danh sách bệnh nhân - slide từ trái */
    .sat-left {
        width: 85%;
        max-width: 400px;
        height: calc(100vh - 2.5rem);
        padding: 0;
        position: fixed;
        top: 2.5rem;
        left: -100%;
        z-index: 1000;
        background-color: white;
        box-shadow: 2px 0 10px rgba(0,0,0,0.3);
        transition: left 0.3s ease;
        overflow-y: auto;
    }

        /* Khi toggle mở danh sách */
        .sat-left.show {
            left: 0;
        }

    /* Header của danh sách bệnh nhân */
    .sat-left-header {
        width: 100%;
        height: 2.5rem;
        background-color: #337ab7;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .sat-left-header-title {
        font-weight: bold;
        font-size: 1rem;
    }

    .sat-left-header-close {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Search box trong danh sách */
    .sat-left-search {
        width: 100%;
        height: auto;
        padding: 0.5rem;
        background-color: #f8f9fa;
    }

    /* Danh sách bệnh nhân */
    .sat-left-list {
        width: 100%;
        height: auto;
        max-height: calc(100vh - 2.5rem - 2.5rem - 10rem);
        overflow-y: auto;
        padding: 0 0.25rem;
    }

        .sat-left-list .total-patient {
            margin: 0.5rem 0.3rem;
            font-size: 15px;
            font-weight: 700;
            border-bottom: 1px dashed lightgray;
            padding-bottom: 0.5rem;
        }

    /* Phần bên phải - thông tin bệnh nhân */
    .sat-right {
        width: 100%;
        height: auto;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    /* Thông tin bệnh nhân - layout cột */
    .sat-right-info {
        width: 100%;
        height: auto;
        padding: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .sat-right-info-title {
        width: 100%;
        margin-bottom: 0.5rem;
    }

    /* Các div thông tin - chuyển thành cột */
    .sat-right-info-div-1,
    .sat-right-info-div-2,
    .sat-right-info-div-3 {
        width: 100%;
        float: none;
