.export-result-sat { /***************************************************** Result */
    width: 100%;
    float: left;
    font-size: 19px;
    font-family: 'Times New Roman';
}

    /* Hình ảnh */
    .export-result-sat .image {
        width: 100%;
        float: left;
    }

        .export-result-sat .image .title {
            width: 100%;
            height: 25px;
            font-weight: bold;
            margin-bottom: 10px;
            float: left;
            color: red;
            text-decoration: underline;
        }

.export-result-sat .image .content {
    width: 100%;
    float: left;
    margin-left: 80px;
    margin-right: 80px
}

    .export-result-sat .image .content.two-images .image-item {
        width: 450px;
        height: 330px;
        float: left;
        margin-right: 10px;
        object-fit: contain;
    }

    /* >2 ảnh: luôn 2 cột; tự chia 2–3 hàng theo class */
    .export-result-sat .image .content.grid-2 {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px; /* khoảng cách giữa các ảnh (ngang + dọc) */
    }

        .export-result-sat .image .content.grid-2 .image-item {
            width: 400px;
            height: 150px;
            aspect-ratio: 4/3;
            object-fit: contain;
            float: none; /* bỏ float cũ */
            margin: 0;
        }
    /* ====== Chống bị chia trang và đảm bảo vừa A4 khi in ====== */
    @page {
        size: A4;
        margin: 10mm;
    }

    .export-result-sat .image,
    .export-result-sat .image .content,
    .export-result-sat .image .content .image-item {
        break-inside: avoid;
        page-break-inside: avoid;
    }

@media print {
    /* Vùng tối đa dành cho KHỐI ẢNH khi >2 ảnh (chỉnh theo phần mô tả) */
    .export-result-sat .image .content.grid-2 {
        --img-area: 110mm;
        max-height: var(--img-area);
    }

        /* 2 hàng (tối đa 4 ảnh) */
        .export-result-sat .image .content.grid-2.rows-2 {
            grid-auto-rows: calc((var(--img-area) - 15px) / 2);
            align-content: start;
        }
        /* 3 hàng (tối đa 6 ảnh) */
        .export-result-sat .image .content.grid-2.rows-3 {
            grid-auto-rows: calc((var(--img-area) - 2*15px) / 3);
            align-content: start;
        }

        .export-result-sat .image .content.grid-2 .image-item {
            height: 100%; /* đầy ô lưới, không phình to */
        }
}
