        [HttpPost]
        [Authorize]
        public async Task<IActionResult> SaveResultAndGenPDF([FromBody] ResultCDHAModel resultCDHA)
        {
            if (resultCDHA == null)
            {
                return Json(new { success = false, message = "Thiếu dữ liệu kết quả." });
            }

            var _userLogin = this.GetUserLogin();
            if (_userLogin == null)
            {
                return Json(new { success = false, message = "Không xác định được user đăng nhập." });
            }

            var _dateTime = ToolBL.Get_DateNow();
            var _device = this.GetSession_Device();

            try
            {
                // Giữ đúng logic SaveResult cũ: update thông tin trả kết quả của Patient và update ResultCDHA.
                await _patientCDHABL.Update(resultCDHA.patientId, resultCDHA.returnResultTime, resultCDHA.userReturnResult, _userLogin.Value, _dateTime, _TDCN);
                var _saveResult = await _resultCDHABL.Update(resultCDHA, _userLogin.Value, _dateTime, _device);

                if (!_saveResult)
                {
                    return Json(new { success = false, message = "Lưu kết quả không thành công. Vui lòng kiểm tra lại." });
                }

                // Sau khi lưu dữ liệu ResultCDHA, tạo luôn file PDF theo KeyResultForHis để HIS/ReturnResult dùng lại.
                var pdfResult = await GenerateAndSaveResultPdfAsync(resultCDHA);
                if (!pdfResult.Success)
                {
                    return Json(new { success = false, message = pdfResult.Message });
                }

                return Json(new
                {
                    success = true,
                    keyResultForHis = pdfResult.KeyResultForHis,
                    fileName = pdfResult.FileName,
                    url = pdfResult.Url
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "SaveResultAndGenPDF failed for ResultCDHAId={ResultCDHAId}", resultCDHA.resultCDHAId);
                return Json(new { success = false, message = "Lưu kết quả và tạo PDF không thành công. Vui lòng kiểm tra lại." });
            }
        }

        private async Task<(bool Success, string FileBase64, string KeyResultForHis, string FileName, string Url, string Message)> GenerateAndSaveResultPdfAsync(ResultCDHAModel resultCDHA)
        {
            var _result = await _resultCDHABL.GetResultCDHAByPatientId_ForValidPrint(resultCDHA.resultCDHAId);
            if (_result == null)
            {
                return (false, string.Empty, string.Empty, string.Empty, string.Empty, "Không tìm thấy dữ liệu kết quả để tạo PDF.");
            }

            if (string.IsNullOrWhiteSpace(_result.KeyResultForHis))
            {
                return (false, string.Empty, string.Empty, string.Empty, string.Empty, "Không lấy được KeyResultForHis để tạo file PDF.");
            }

            try
            {
                if (resultCDHA.userReturnResult > 0)
                {
                    var returnUser = await _userBL.GetUser(resultCDHA.userReturnResult);
                    if (returnUser != null)
                    {
                        ViewData["ReturnUser"] = returnUser;
                    }
                }

                ViewData["ResultCDHA"] = _result;

                var _serviceCDHA = _serviceBL.GetById(_result?.Service?.Id);
                if (_serviceCDHA != null)
                {
                    ViewData["ServiceCDHA"] = _serviceCDHA.Result;
                }
                else
                {
                    ViewData["ServiceCDHA"] = null;
                }

                var _hospital = await _hospitalBL.GetHospital();
                var content = await this.RenderViewAsync("Content", _hospital);
                var header = await this.RenderViewAsync("Header", _hospital);
                var footer = await this.RenderViewAsync("Footer", _hospital);

                var _folder = Path.Combine(_environment.WebRootPath, "pdf", "tdcn");
                Directory.CreateDirectory(_folder);

                var _fileName = _result.KeyResultForHis + ".pdf";
                var _file = Path.Combine(_folder, _fileName);

                var fileBase64 = await _toolBL.ExportPdf_Result(_folder, _file, header, content, footer);
                var url = Url.Content("~/pdf/tdcn/" + _fileName);

                return (true, fileBase64, _result.KeyResultForHis, _fileName, url, string.Empty);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "GenerateAndSaveResultPdfAsync failed for ResultCDHAId={ResultCDHAId}", resultCDHA.resultCDHAId);
                return (false, string.Empty, string.Empty, string.Empty, string.Empty, "Tạo file PDF không thành công. Vui lòng kiểm tra lại.");
            }
        }

        [HttpPost]
        [Authorize]
        public async Task<IActionResult> SavePDFResult([FromForm] ResultCDHAModel resultCDHA, IFormFile resultPdf)
        {
            if (resultCDHA == null)
            {
                return Json(new { success = false, message = "Thiếu dữ liệu kết quả." });
            }

            if (resultPdf == null || resultPdf.Length == 0)
            {
                return Json(new { success = false, message = "Vui lòng chọn file PDF kết quả." });
            }

            var extension = Path.GetExtension(resultPdf.FileName)?.ToLowerInvariant();
            if (extension != ".pdf")
            {
                return Json(new { success = false, message = "File kết quả phải là định dạng PDF." });
            }

            var _dateTime = ToolBL.Get_DateNow();
            var _userLogin = this.GetUserLogin();
            var _device = this.GetSession_Device();

            try
            {
                // Giữ đúng logic SaveResult cũ: update thông tin trả kết quả của Patient và update ResultCDHA.
                await _patientCDHABL.Update(resultCDHA.patientId, resultCDHA.returnResultTime, resultCDHA.userReturnResult, _userLogin.Value, _dateTime, _TDCN);
                var _saveResult = await _resultCDHABL.Update(resultCDHA, _userLogin.Value, _dateTime, _device);

                if (!_saveResult)
                {
                    return Json(new { success = false, message = "Update kết quả không thành công." });
                }

                // Lấy lại KeyResultForHis sau khi update để lưu file đúng theo từng dịch vụ.
                var _result = await _resultCDHABL.GetResultCDHAByPatientId_ForValidPrint(resultCDHA.resultCDHAId);
                if (_result == null || string.IsNullOrWhiteSpace(_result.KeyResultForHis))
                {
                    return Json(new { success = false, message = "Không lấy được KeyResultForHis để tạo file PDF." });
                }

                var _folder = Path.Combine(_environment.WebRootPath, "pdf", "tdcn");
                Directory.CreateDirectory(_folder);

                var _fileName = _result.KeyResultForHis + ".pdf";
                var _file = Path.Combine(_folder, _fileName);

                await using (var stream = new FileStream(_file, FileMode.Create, FileAccess.Write, FileShare.None))
                {
                    await resultPdf.CopyToAsync(stream);
                }

                return Json(new
                {
                    success = true,
                    keyResultForHis = _result.KeyResultForHis,
                    fileName = _fileName,
                    url = Url.Content("~/pdf/tdcn/" + _fileName)
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "SavePDFResult failed for ResultCDHAId={ResultCDHAId}", resultCDHA.resultCDHAId);
                return Json(new { success = false, message = "Lưu PDF không thành công. Vui lòng kiểm tra lại." });
            }
        }

        [HttpPost]
        [Authorize]
        public async Task<IActionResult> MarkPatientAsDone([FromBody] List<ResultCDHAModel> resultCDHAs)
        {
            if (resultCDHAs == null || resultCDHAs.Count == 0)
            {
                return Json(new { success = false, message = "Thiếu danh sách dịch vụ TDCN." });
            }

            var resultCDHA = resultCDHAs.FirstOrDefault();
            if (resultCDHA == null || resultCDHA.patientId <= 0)
            {
                return Json(new { success = false, message = "Thiếu thông tin bệnh nhân." });
            }

            var _userLogin = this.GetUserLogin();
            if (_userLogin == null)
            {
                return Json(new { success = false, message = "Không xác định được người dùng đăng nhập." });
            }

            try
            {
                var _dateTime = ToolBL.Get_DateNow();
                var updated = await _resultCDHABL.ValidateCDHAMultipleAsync(resultCDHAs, _TDCN, _userLogin.Value, _dateTime);

                return Json(new
                {
                    success = updated,
                    totalService = resultCDHAs.Count,
                    message = updated
                        ? "Đã cập nhật trạng thái Đã thực hiện."
                        : "Cập nhật trạng thái không thành công."
                });
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "MarkPatientAsDone failed for PatientId={PatientId}", resultCDHA.patientId);
                return Json(new { success = false, message = "Cập nhật trạng thái không thành công. Vui lòng kiểm tra lại." });
            }
        }
        [HttpPost]
        [Authorize]
        public async Task<IActionResult> ValidPrint([FromBody] ResultCDHAModel resultCDHA)
        {
            if (resultCDHA != null)
            {
                var _dateTime = ToolBL.Get_DateNow();
                var _userLogin = this.GetUserLogin();
                var _device = this.GetSession_Device();
                if (await _resultCDHABL.Update(resultCDHA, _userLogin.Value, _dateTime, _device))
                {
                    if (await _resultCDHABL.ValidateCDHAAsync(resultCDHA, _TDCN, _userLogin.Value, _dateTime))
                    {
                        var _result = await _resultCDHABL.GetResultCDHAByPatientId_ForValidPrint(resultCDHA.resultCDHAId);
                        if (_result != null)
                        {
                            try
                            {
                                // === LẤY THÔNG TIN BÁC SĨ THỰC HIỆN (ReturnUser) ===
                                if (resultCDHA.userReturnResult > 0)   // vì userReturnResult là kiểu int/long
                                {
                                    var returnUser = await _userBL.GetUser(resultCDHA.userReturnResult);
                                    if (returnUser != null)
                                    {
                                        ViewData["ReturnUser"] = returnUser; // để Content/Header/Footer dùng khi in
                                    }
                                }
                                ViewData["ResultCDHA"] = _result;
                                var _serviceCDHA = _serviceBL.GetById(_result?.Service?.Id);
