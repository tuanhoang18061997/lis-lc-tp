}

.xn-results-table .table td {
    padding: 12px 15px;
    vertical-align: middle;
    border-color: #dee2e6;
}

.xn-result-row {
    transition: background-color 0.2s ease;
}

.xn-result-row:hover {
    background-color: #f8f9fa;
}

.result-value {
    font-weight: 600;
    font-size: 15px;
}

.result-value.text-success {
