    .data-left-data .data-left-list,
    .data-left-pushresulthis .data-left-list {
        height: auto;
        max-height: 60vh;
        overflow-y: auto;
    }
}

/* ---- Mobile (≤ 768px) ---- */
@media (max-width: 768px) {

    /* Navbar brand text nhỏ hơn */
    .navbar-brand span {
        font-size: 0.8rem;
    }

    .menu-left-height {
        height: auto;
        min-height: 2.5rem;
    }

    /* Form input panel: full width */
    .data-right-data .data-right-info .div-lable-input,
    .data-right-pushresulthis .data-right-info .div-lable-input {
        width: 100%;
    }

    /* Buttons: flex wrap, dễ tap trên mobile */
    .data-right-data .data-right-button,
    .data-right-pushresulthis .data-right-button {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
    }

        .data-right-data .data-right-button button,
        .data-right-pushresulthis .data-right-button button {
            width: auto;
            min-width: 90px;
            flex: 1 1 auto;
            padding: 0.3rem 0.5rem;
            min-height: 2.2rem;
        }

    /* Bảng dữ liệu: cho phép cuộn ngang */
    .data-left-data .data-left-list .table-responsive,
    .data-left-pushresulthis .data-left-list .table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    /* Bảng: min-width để không bị bóp quá nhỏ */
    .data-left-data .data-left-list .table,
    .data-left-pushresulthis .data-left-list .table {
        min-width: 700px;
    }

    /* Sticky header vẫn hoạt động khi cuộn dọc */
    .data-left-data .data-left-list .sticky-top,
    .data-left-pushresulthis .data-left-list .sticky-top {
        position: sticky;
        top: 0;
        z-index: 2;
    }

    /* Danh sách: giảm chiều cao */
    .data-left-data .data-left-list,
    .data-left-pushresulthis .data-left-list {
        height: auto;
        max-height: 50vh;
    }

    /* Container bớt padding */
    .container-fluid {
        padding-left: 5px;
        padding-right: 5px;
    }

    /* Title bar */
    .data-left-data .data-left-title-search .title,
    .data-right-data .data-right-title,
    .data-left-pushresulthis .data-left-title-search .title,
    .data-right-pushresulthis .data-right-title {
        font-size: 0.8rem;
    }
}

/* ---- Small Mobile (≤ 480px) ---- */
@media (max-width: 480px) {

    html {
        font-size: 11px;
    }

    /* Menu dropdown user */
    .menu-right {
        min-width: unset;
    }

    .menu-right-bg {
        font-size: 0.75rem;
    }

    /* Input chiều cao lớn hơn để dễ tap */
    .form-control.height-28,
    .form-select.height-28 {
        height: 2.2rem;
        font-size: 0.85rem;
    }

    /* Buttons chiếm full width */
    .data-right-data .data-right-button button,
    .data-right-pushresulthis .data-right-button button {
        flex: 1 1 100%;
        min-height: 2.5rem;
        font-size: 0.85rem;
    }

    /* Bảng: min-width nhỏ hơn cho màn rất nhỏ */
    .data-left-data .data-left-list .table,
    .data-left-pushresulthis .data-left-list .table {
        min-width: 600px;
    }

    /* Checkbox dễ tap hơn */
    .td-checkbox .form-check-input {
        width: 1.2rem;
