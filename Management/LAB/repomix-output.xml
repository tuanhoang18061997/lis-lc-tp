        [Authorize]
        public async Task<IActionResult> ValidPrintUploadedPdf([FromForm] ResultCDHAModel resultCDHA, IFormFile resultPdf)
        {
            if (resultCDHA == null || resultPdf == null || resultPdf.Length == 0)
            {
                return Content(string.Empty);
            }

            var extension = Path.GetExtension(resultPdf.FileName)?.ToLowerInvariant();
            if (extension != ".pdf")
            {
                return Content(string.Empty);
            }

            var _dateTime = ToolBL.Get_DateNow();
            var _userLogin = this.GetUserLogin();
            var _device = this.GetSession_Device();

            // Update nội dung kết quả trước, sau đó Valid đúng ResultCDHA theo service-level.
            if (!await _resultCDHABL.Update(resultCDHA, _userLogin.Value, _dateTime, _device))
            {
                return Content(string.Empty);
            }

            if (!await _resultCDHABL.ValidateCDHAAsync(resultCDHA, _TDCN, _userLogin.Value, _dateTime))
            {
                return Content(string.Empty);
            }

            var _result = await _resultCDHABL.GetResultCDHAByPatientId_ForValidPrint(resultCDHA.resultCDHAId);
            if (_result == null || string.IsNullOrWhiteSpace(_result.KeyResultForHis))
            {
                return Content(string.Empty);
            }

            try
            {
                var _folder = Path.Combine(_environment.WebRootPath, "pdf", "tdcn");
                Directory.CreateDirectory(_folder);

                // Lưu đúng cấu trúc cũ: wwwroot/pdf/tdcn/{KeyResultForHis}.pdf
                var _file = Path.Combine(_folder, _result.KeyResultForHis + ".pdf");

                await using (var stream = new FileStream(_file, FileMode.Create, FileAccess.Write, FileShare.None))
                {
                    await resultPdf.CopyToAsync(stream);
                }

                var bytes = await System.IO.File.ReadAllBytesAsync(_file);
                return Content(Convert.ToBase64String(bytes));
            }
            catch
            {
                return Content(string.Empty);
            }
        }
