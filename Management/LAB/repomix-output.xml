                //        .FirstOrDefault();

                //    // Fallback: bất kỳ dịch vụ nào chứa test này (chọn cái đầu tiên)
                //    if (serviceId == null)
                //    {
                //        serviceId = svcTests
                //            .Where(st => st.TestCodeId == objTestCode.Id)
                //            .Select(st => (long?)st.ServiceId)
