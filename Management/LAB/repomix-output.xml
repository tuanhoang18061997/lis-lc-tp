                // Tìm bệnh nhân theo MaBenhAn
                var patient = await _db.Patients
                    .Where(p => p.Active == true &&
                               p.MaBenhAn == maBenhAn &&
                               p.InsertTime >= from &&
                               p.InsertTime <= to)
                    .OrderByDescending(p => p.InsertTime)
                    .FirstOrDefaultAsync();

                return patient;
            }
            catch (Exception ex)
