        [HttpPost]
        [Authorize]
        public async Task<IActionResult> ScanFolderAndSyncImages(long resultCDHAId, string patientCode)
        {
            // 1) Thư mục CVS-03 export (đổi theo thực tế nếu khác)
            var xqFolder = Path.Combine(_environment.WebRootPath, "xq_export");
            if (!Directory.Exists(xqFolder)) return Content("False");

            // 2) Thư mục lưu dấu file đã import để tránh trùng
            var importedRoot = Path.Combine(xqFolder, "_imported");
            Directory.CreateDirectory(importedRoot);

            // 3) Chỉ nhận file ảnh
            var allowedExts = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
            { ".png", ".jpg", ".jpeg", ".bmp", ".gif", ".tif", ".tiff", ".webp" };

            // 4) Lấy các file ảnh ở ngay thư mục xq_export (không đệ quy)
            var candidates = Directory.EnumerateFiles(xqFolder, "*", SearchOption.TopDirectoryOnly)
                                      .Where(p => allowedExts.Contains(Path.GetExtension(p)))
                                      .OrderByDescending(p => new FileInfo(p).LastWriteTimeUtc)
                                      .ToList();

            if (candidates.Count == 0) return Content("False");

            // 5) Nơi lưu trữ cuối (web hiển thị)
            var destFolder = Path.Combine(_environment.WebRootPath, "images", "result", "xq");
            Directory.CreateDirectory(destFolder);

            var importedCount = 0;

            foreach (var src in candidates)
            {
                try
                {
                    // Đợi file upload/ghi xong (giữ nguyên util IsFileReady của bạn)
                    if (!IsFileReady(src))
                    {
                        Thread.Sleep(300);
                        if (!IsFileReady(src)) continue;
                    }

                    var guid = Guid.NewGuid().ToString("N");
                    var ext = Path.GetExtension(src);
                    var destName = $"{resultCDHAId}-{guid}{ext}";
                    var destPath = Path.Combine(destFolder, destName);

                    System.IO.File.Copy(src, destPath, overwrite: true);

                    // Lưu DB: web path + physical path
                    var webPath = "/images/result/xq/" + destName;
                    var ok = await _resultCDHABL.SaveImage(resultCDHAId, webPath, destPath);
                    if (ok)
                    {
                        importedCount++;

                        // 6) Move nguồn sang _imported/yyyyMMdd để đánh dấu đã dùng
                        var dayFolder = Path.Combine(importedRoot, DateTime.Now.ToString("yyyyMMdd"));
                        Directory.CreateDirectory(dayFolder);

                        var archived = Path.Combine(dayFolder, Path.GetFileName(src));
                        if (System.IO.File.Exists(archived))
                        {
                            var baseName = Path.GetFileNameWithoutExtension(archived);
                            archived = Path.Combine(dayFolder, $"{baseName}_{guid}{ext}");
                        }
                        System.IO.File.Move(src, archived);
                    }
                    else
                    {
                        // Nếu lưu DB thất bại, có thể xoá file đích để tránh rác (tuỳ nhu cầu)
                        // System.IO.File.Delete(destPath);
                    }
                }
                catch
                {
                    // Bỏ qua file lỗi, tiếp tục các file khác
                }
            }

            return Content(importedCount > 0 ? "True" : "False");
        }

        // helper: kiểm tra file đã sẵn sàng đọc (không còn bị lock)
        private bool IsFileReady(string path)
        {
            try
            {
                using var fs = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.None);
                return fs.Length > 0;
            }
            catch { return false; }
        }

