.signature-page-ns {
    clear: both;
    break-inside: avoid;
    page-break-inside: avoid;
    padding-top: 6mm; /* tạo khoảng cách an toàn với phần trên */
}

    /* 2 cột: bên trái chỉ là khoảng trống, bên phải chứa toàn bộ thông tin */
    .signature-page-ns .signature {
        display: flex;
        justify-content: flex-end; /* dồn nội dung sang phải */
        align-items: flex-start;
        gap: 16px;
    }

        /* Cột trái làm “đệm” */
        .signature-page-ns .signature .signature-left {
            flex: 1 1 auto; /* chiếm phần còn lại để đẩy cột phải sang mép phải */
        }

        /* Cột phải chứa nội dung chữ ký */
        .signature-page-ns .signature .signature-right {
            width: 420px; /* tùy trang A4 dọc, bạn có thể 380–460px */
            text-align: center;
            font-size: 19px;
        }

            /* Dòng thời gian */
            .signature-page-ns .signature .signature-right .signature-right-time {
                line-height: 24px;
                margin-bottom: 5px;
            }

            /* Tiêu đề */
            .signature-page-ns .signature .signature-right .signature-right-title {
                font-weight: 700;
                line-height: 10px;
                margin-bottom: 5px;
            }

            /* Khung ảnh chữ ký – bỏ height cố định để tránh cắt ảnh */
            .signature-page-ns .signature .signature-right .signature-right-cks {
                /* KHÔNG dùng height: 55px; */
                min-height: 50px; /* giữ không gian tối thiểu */
                display: flex;
                align-items: center;
                justify-content: center;
            }

                /* Ảnh chữ ký – tự co giãn, không méo, không tràn khung */
                .signature-page-ns .signature .signature-right .signature-right-cks img {
                    max-width: 80%;
                    max-height: 100px; /* tăng/giảm nếu ảnh nhỏ/quá to */
                    height: auto;
                    width: auto;
                    object-fit: contain;
                    image-rendering: -webkit-optimize-contrast;
                }

            /* Tên bác sĩ – to, rõ, không bị đè */
            .signature-page-ns .signature .signature-right .signature-right-user {
                font-weight: 700;
                font-size: 21px;
                line-height: 24px;
                margin-top: .1rem;
            }
/* Khi in PDF, cho phép co giãn tốt hơn để tránh bị cắt */
@media print {
    .signature-page-ns {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

        .signature-page-ns .signature .signature-right .signature-right-cks {
            min-height: 80px;
        }
}
/* ====== RESPONSIVE CHO MOBILE (max-width: 768px) ====== */
@media (max-width: 768px) {
    html {
        font-size: 14px;
    }

    /* Container chính */
    .ns-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 2.5rem);
        margin-top: 0;
        position: relative;
    }

    /* Nút toggle danh sách bệnh nhân - floating button */
    .mobile-toggle-patient-list {
        display: flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 3rem;
        height: 3rem;
        background-color: #337ab7;
        color: white;
        border: none;
        border-radius: 0 0.5rem 0.5rem 0;
        font-size: 1.5rem;
        cursor: pointer;
        z-index: 1001;
        box-shadow: 2px 0 8px rgba(0,0,0,0.3);
        transition: all 0.3s ease;
        padding: 0;
    }

        .mobile-toggle-patient-list:hover {
            background-color: #1e65a3;
            width: 3.5rem;
        }

        .mobile-toggle-patient-list i {
            transition: transform 0.3s ease;
        }

        .mobile-toggle-patient-list.active i {
            transform: rotate(90deg);
        }

    /* Overlay khi mở danh sách */
    .mobile-patient-list-overlay {
        display: none;
        position: fixed;
        top: 2.5rem;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 999;
        transition: opacity 0.3s ease;
    }

        .mobile-patient-list-overlay.show {
            display: block;
        }

    /* Danh sách bệnh nhân - slide từ trái */
    .ns-left {
        width: 85%;
        max-width: 400px;
        height: calc(100vh - 2.5rem);
        padding: 0;
        position: fixed;
        top: 2.5rem;
        left: -100%;
        z-index: 1000;
        background-color: white;
        box-shadow: 2px 0 10px rgba(0,0,0,0.3);
        transition: left 0.3s ease;
        overflow-y: auto;
    }

        .ns-left.show {
            left: 0;
        }

    /* Header của danh sách bệnh nhân */
    .ns-left-header {
        width: 100%;
        height: 2.5rem;
        background-color: #337ab7;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 1rem;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    .ns-left-header-title {
        font-weight: bold;
        font-size: 1rem;
    }

    .ns-left-header-close {
        background: none;
        border: none;
        color: white;
        font-size: 1.5rem;
        cursor: pointer;
        padding: 0;
        width: 2rem;
        height: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Search box */
    .ns-left-search {
        width: 100%;
        height: auto;
        padding: 0.5rem;
        background-color: #f8f9fa;
    }

    /* Danh sách bệnh nhân */
    .ns-left-list {
        width: 100%;
        height: auto;
        max-height: calc(100vh - 2.5rem - 2.5rem - 10rem);
        overflow-y: auto;
        padding: 0 0.25rem;
    }

        .ns-left-list .total-patient {
            margin: 0.5rem 0.3rem;
            font-size: 15px;
            padding-bottom: 0.5rem;
        }

    /* Phần bên phải */
    .ns-right {
        width: 100%;
        height: auto;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

    /* Thông tin bệnh nhân */
    .ns-right-info {
        width: 100%;
        height: auto;
        padding: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .ns-right-info-title {
        width: 100%;
        margin-bottom: 0.5rem;
    }

    .ns-right-info-div-1,
    .ns-right-info-div-2,
    .ns-right-info-div-3 {
        width: 100%;
        float: none;
        margin-bottom: 0.5rem;
        padding: 0;
    }

    /* Combo input - layout cột */
    .ns-right-info-div-combo-2 {
        width: 100%;
        float: none;
        display: flex;
        flex-direction: column;
        margin-bottom: 0.5rem;
    }

    .ns-right-info-div-combo-2-label {
        width: 100%;
        max-width: 100%;
        float: none;
        line-height: 1.5rem;
        font-weight: bold;
        margin-bottom: 0.25rem;
    }

    .ns-right-info-div-combo-2-input {
        width: 100%;
        max-width: 100%;
        float: none;
        padding: 0;
    }

    .ns-right-info-div-combo-2-input-input1,
    .ns-right-info-div-combo-2-input-input2 {
        width: 100%;
        float: none;
        margin-bottom: 0.5rem;
    }

    /* Combo 4 */
    .ns-right-info-div-combo-4 {
        width: 100%;
        float: none;
        display: flex;
        flex-direction: column;
        margin-bottom: 0.5rem;
    }

    .ns-right-info-div-combo-4-label-age-object,
    .ns-right-info-div-combo-4-label-sex-benhan {
        width: 100%;
        float: none;
        line-height: 1.5rem;
        font-weight: bold;
        margin-bottom: 0.25rem;
    }

    .ns-right-info-div-combo-4-input {
        width: 100%;
        float: none;
        margin-bottom: 0.5rem;
    }

    /* Phần dịch vụ */
    .ns-right-service {
        width: 100%;
        height: auto;
        padding: 0.5rem;
        overflow-y: auto;
    }

    .ns-right-service-group {
        width: 100%;
        height: auto;
        flex-direction: column;
        margin-bottom: 0.5rem;
    }

    .ns-right-service-group-button {
        width: 100%;
        height: auto;
        float: none;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

        .ns-right-service-group-button .btn {
            width: 100%;
            font-size: 0.75rem;
            padding: 0.5rem;
            height: auto;
        }

    .ns-right-service-group-button-title-sample {
        width: 100%;
        float: none;
        margin-bottom: 0.5rem;
    }

        .ns-right-service-group-button-title-sample .title-process,
        .ns-right-service-group-button-title-sample .title-returnresult {
            width: 100%;
            margin-bottom: 0.5rem;
        }

        .ns-right-service-group-button-title-sample .sample {
            width: 100%;
            padding: 0.5rem;
        }

    .ns-right-service-group-category,
    .ns-right-service-group-service {
        width: 100%;
        float: none;
        margin-bottom: 0.5rem;
    }

    .ns-right-service-group-category-label,
    .ns-right-service-group-service-label {
        width: 100%;
        float: none;
        padding-left: 0.5rem;
    }

    .ns-right-service-group-category-select,
    .ns-right-service-group-service-select {
        width: 100%;
        float: none;
        padding: 0 0.5rem;
    }

    /* GridView */
    .ns-right-service-gridview {
        width: 100%;
        height: auto;
        max-height: none;
        overflow-y: auto;
    }

        .ns-right-service-gridview .table-responsive {
            height: auto;
            max-height: none;
            display: flex;
            flex-direction: column;
            padding: 0;
        }

            /* Process - layout cột */
            .ns-right-service-gridview .table-responsive .left {
                width: 100%;
                float: none;
                padding: 0.5rem;
                order: 1;
            }

                .ns-right-service-gridview .table-responsive .left .list-service {
                    width: 100%;
                    margin-bottom: 1rem;
                }

                .ns-right-service-gridview .table-responsive .left .camera {
                    width: 100%;
                    height: auto;
                    aspect-ratio: 16/9;
                    margin-bottom: 1rem;
                }

                    .ns-right-service-gridview .table-responsive .left .camera .video {
                        width: 100%;
                        height: 100%;
                    }

                .ns-right-service-gridview .table-responsive .left .group-button-image {
                    width: 100%;
                    gap: 1rem;
                }

                    .ns-right-service-gridview .table-responsive .left .group-button-image .group-button {
                        display: grid;
                        grid-template-columns: 1fr 1fr;
                        gap: 0.5rem;
                    }

                        .ns-right-service-gridview .table-responsive .left .group-button-image .group-button .btn {
                            width: 100%;
                            font-size: 0.7rem;
                            padding: 0.3rem;
                        }

                    .ns-right-service-gridview .table-responsive .left .group-button-image .imageCDHA {
                        grid-template-columns: 1fr 1fr;
                        gap: 0.5rem;
                        width: 100%;
                        padding-top: 0.5rem;
                    }

                        .ns-right-service-gridview .table-responsive .left .group-button-image .imageCDHA .image-item {
                            width: 100%;
                            height: auto;
                            aspect-ratio: 4/3;
                            margin: 0;
                        }

                .ns-right-service-gridview .table-responsive .left .image-returnresult {
                    width: 100%;
                    grid-template-columns: 1fr;
                }

                    .ns-right-service-gridview .table-responsive .left .image-returnresult .image-item {
                        width: 100%;
                        margin: 0.5rem 0;
                    }

            /* Right side - Description, Result, Suggest */
            .ns-right-service-gridview .table-responsive .right {
                width: 100%;
                float: none;
                order: 2;
                padding: 0.5rem;
            }

                .ns-right-service-gridview .table-responsive .right .desscription {
                    width: 100%;
                    min-height: 200px;
                    padding: 0;
                }

                    .ns-right-service-gridview .table-responsive .right .desscription .content {
                        width: 100%;
                        height: 200px;
                    }

                        .ns-right-service-gridview .table-responsive .right .desscription .content .textarea-desscription {
                            font-size: 14px;
                        }

                .ns-right-service-gridview .table-responsive .right .result-suggest {
                    width: 100%;
                    display: flex;
                    flex-direction: column;
                    margin-top: 2.5rem;
                }

                    .ns-right-service-gridview .table-responsive .right .result-suggest .result,
                    .ns-right-service-gridview .table-responsive .right .result-suggest .suggest {
                        width: 100%;
                        float: none;
                        padding: 0;
                        margin-bottom: 0.5rem;
                    }

                        .ns-right-service-gridview .table-responsive .right .result-suggest .result .textarea-result,
                        .ns-right-service-gridview .table-responsive .right .result-suggest .suggest .textarea-suggest {
                            height: 80px;
                            font-size: 14px;
                        }

    /* Form controls */
    .form-control,
    .form-select {
        font-size: 16px;
    }

    .select2-container {
        font-size: 16px;
    }

    /* List items */
    .list-group-item {
        font-size: 0.875rem;
        padding: 0.5rem;
    }

    /* Icons trong service list */
    .digital-sign-icon,
    .result-status-icon,
    .pdf-validated-icon {
        font-size: 11px;
    }

        .digital-sign-icon i,
        .result-status-icon i,
        .pdf-validated-icon i {
            font-size: 12px;
        }

    /* Modal */
    .modal-content {
        margin: 0.5rem;
    }

    .ns-right-add-service-for-patient-service .title,
    .ns-right-select-device .title {
        width: 100%;
        float: none;
        margin-bottom: 0.25rem;
    }

    .ns-right-add-service-for-patient-service .content,
    .ns-right-select-device .content {
        width: 100%;
        float: none;
    }

    /* Export/Print - giữ nguyên cho desktop */
    .hospital-ns,
    .patient-ns,
    .service-ns,
    .export-result-ns,
    .signature-page-ns {
        font-size: 16px;
    }
}

/* Ẩn toggle button và overlay trên desktop */
@media (min-width: 769px) {
    .mobile-toggle-patient-list,
    .mobile-patient-list-overlay,
    .ns-left-header {
        display: none;
    }
}

/* Tablet - Responsive trung bình (769px - 1024px) */
@media (min-width: 769px) and (max-width: 1024px) {
    .ns-left {
        width: 300px;
    }

    .ns-right {
        width: calc(100% - 300px);
    }

    .ns-right-service-gridview .table-responsive .left {
        width: 350px;
    }

        .ns-right-service-gridview .table-responsive .left .camera .video {
            width: 350px;
        }

    .ns-right-service-gridview .table-responsive .right {
        width: calc(100% - 350px);
    }

        .ns-right-service-gridview .table-responsive .right .result-suggest .result {
            width: 350px;
        }

        .ns-right-service-gridview .table-responsive .right .result-suggest .suggest {
            width: calc(100% - 350px);
        }
}
