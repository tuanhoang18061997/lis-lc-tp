            //if (allowedIPs?.Length > 0)
            //{
            //    var clientIP = HttpContext.Connection.RemoteIpAddress?.ToString();
            //    if (!allowedIPs.Contains(clientIP))
            //    {
            //        return false;
            //    }
            //}

            return true;
        }

