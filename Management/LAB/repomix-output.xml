<file path="Views/NSCTC_GetSample/GetSample.cshtml">
@using Management.BL
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Đang chờ";
    Layout = "_LayoutNSCTC";
}

<div class="nsctc-container">
    <div class="nsctc-left">
        <div class="nsctc-left-search">
            @await Html.PartialAsync("_NSCTC_GetSample_Search")
        </div>
        <div id="listPatient" class="nsctc-left-list">
            @await Html.PartialAsync("_NSCTC_GetSample_ListPatient")
        </div>
    </div>
    <div class="nsctc-right">
        <div id="patientInfo" class="nsctc-right-info">
            @await Html.PartialAsync("_NSCTC_GetSample_PatientInfo")
        </div>
        <div id="patientService" class="nsctc-right-service">
            <div id="nsctc-right-service-group" class="nsctc-right-service-group">
                @await Html.PartialAsync("_NSCTC_GetSample_GroupButton")
            </div>
            <div id="nsctc-right-service-gridview" class="nsctc-right-service-gridview">
                @await Html.PartialAsync("_NSCTC_GetSample_ListService")
            </div>
        </div>
    </div>
</div>
</file>

<file path="Views/NSCTC_Process/_NSCTC_Process_GroupButton.cshtml">
@{
    var lstSampleResult = ViewData["lstSampleResult"] as List<Sample>;
    var _lstUserFunction = ViewData["lstUserFunction"] as List<UserFunction>;
}

<div class="nsctc-right-service-group-button">
    <button id="nsctc_process_saveresult" class="btn btn-success btn-blue" onclick="Process_SaveResult(false)">
        <i class="bi bi-download"></i> Lưu
    </button>
    <button id="nsctc_process_cancelresult" class="btn btn-success btn-blue" onclick="Process_CancelResultt()">
        <i class="bi bi-arrow-return-left"></i> Bỏ qua
    </button>
    <button id="nsctc_process_valid_in" class="btn btn-success btn-blue" onclick="Process_ValidPrint('selected')">
        <i class="bi bi-printer"></i> Valid & In
    </button>
    <button id="nsctc_process_getsample" class="btn btn-success btn-blue" onclick="Process_GetSample()">
        <i class="bi bi-arrow-left"></i> Đang chờ
    </button>
    @{
        foreach (var item in _lstUserFunction)
        {
            if (item.Function.Code == "ValidAndKySoMySign")
            {
                <button id="nsctc_process_signpdf"
                        type="button"
                        class="btn btn-warning btn-md nsctc_process_signpdf"
                        onclick="Process_SignPdf_Multi('selected')">
                    <i class="fa fa-certificate"></i> In & Ký số
                </button>
            }
        }
    }
</div>
<div class="nsctc-right-service-group-button-title-sample">
    <div class="title-process">MÔ TẢ</div>
    <div class="sample">
        <select id="nsctc_process_sampleresult" name="nsctc_process_sampleresult" class="form-select height-28" onchange="GetSampleForService(this.value)">
            @if (lstSampleResult != null)
            {
                foreach (var item in lstSampleResult)
                {
                    <option value="@item.Id" data-serviceid="@item.ServiceId" data-gender="@item.Gender">@item.Name</option>
                }
            }
        </select>
    </div>
</div>
</file>

<file path="Views/NSCTC_Process/_NSCTC_Process_ListPatient.cshtml">
@{
    var lstPatient = ViewData["lstPatient"] as List<Patient>;
    var totalPatient = lstPatient.Count();
}
<div class="total-patient">Tổng: @totalPatient</div>
<div class="list-group list-group-flush">
    @{
        if (lstPatient != null || lstPatient.Count > 0)
        {
            var index = 0;
            foreach (var patient in lstPatient)
            {
                index++;
                if (index % 2 == 0)
                {
                    <a href="#" class="list-group-item list-group-item-action" onclick="Process_GetPatientInfo(@patient.Id)" data-id="@patient.Id">
                        <div class="list-group-item-pid-age-sex">
                            <div class="list-group-item-pid-age-sex-pid">@patient.PatientId</div>
                            <div class="list-group-item-pid-age-sex-age">@patient.Age?.ToString("dd/MM/yyyy")</div>
                            <div class="list-group-item-pid-age-sex-sex">
                                @{
                                    @patient.Sex
                                }
                            </div>
                        </div>
                        <div class="list-group-item-name-maBenhAn">
                            <div class="list-group-item-name-maBenhAn-name"> @patient.PatientName.ToUpper()</div>
                            <div class="list-group-item-name-maBenhAn-maBenhAn"> @patient.MaBenhAn</div>
                        </div>
                        <div class="list-group-item-seq-sid">
                            <div class="list-group-item-seq-sid-seq">
                                <label class="title">Barcode(Seq): </label>
                                <span class="seq">@patient.Seq</span>
                            </div>
                            <div class="list-group-item-seq-sid-index">
                                <label class="title">STT: </label>
                                <span class="index">@index</span>
                            </div>
                        </div>
                        <div class="list-group-item-seq-sid">
                            <div class="list-group-item-seq-sid-seq">
                                <span class="seq" style="color: green; font-size: 11px">@patient.MaDotKham</span>
                            </div>
                        </div>
                    </a>
                }
                else
                {
                    <a href="#" class="list-group-item list-group-item-action" onclick="Process_GetPatientInfo(@patient.Id)" data-id="@patient.Id">
                        <div class="list-group-item-pid-age-sex">
                            <div class="list-group-item-pid-age-sex-pid">@patient.PatientId</div>
                            <div class="list-group-item-pid-age-sex-age">@patient.Age?.ToString("dd/MM/yyyy")</div>
                            <div class="list-group-item-pid-age-sex-sex">
                                @{
                                    @patient.Sex
                                }
                            </div>
                        </div>
                        <div class="list-group-item-name-maBenhAn">
                            <div class="list-group-item-name-maBenhAn-name"> @patient.PatientName.ToUpper()</div>
                            <div class="list-group-item-name-maBenhAn-maBenhAn"> @patient.MaBenhAn</div>
                        </div>
                        <div class="list-group-item-seq-sid">
                            <div class="list-group-item-seq-sid-seq">
                                <label class="title">Barcode(Seq): </label>
                                <span class="seq">@patient.Seq</span>
                            </div>
                            <div class="list-group-item-seq-sid-index">
                                <label class="title">STT: </label>
                                <span class="index">@index</span>
                            </div>
                        </div>
                        <div class="list-group-item-seq-sid">
                            <div class="list-group-item-seq-sid-seq">
                                <span class="seq" style="color: green; font-size: 11px">@patient.MaDotKham</span>
                            </div>
                        </div>
                    </a>
                }
            }
        }
    }
</div>
</file>

<file path="Views/NSCTC_Process/_NSCTC_Process_ListService.cshtml">
@{
    var lstresultCDHAs = ViewData["lstresultCDHAs"] as List<ResultCDHA>;
}

<div class="table-responsive">
    <div class="left">
        <div class="list-service">
            <div class="table-responsive">
                <table class="table table-hover table-bordered" id="nsctc_list_service">
                    <thead>
                        <tr class="tr-title">
                            <th class="th-check" style="width: 30px; text-align: center;">
                                <input class="form-check-input" type="checkbox" id="nsctc_chk_all" title="Chọn tất cả">
                            </th>
                            <th class="th-service" style="text-align: center;">Dịch vụ</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-gridview-service" class="tbody-service">
                        @{
                            if (lstresultCDHAs != null && lstresultCDHAs.Count > 0)
                            {
                                var index = 0;
                                foreach (var item in lstresultCDHAs)
                                {
                                    index++;
                                    var isPdfValidated = false;
                                    if (!string.IsNullOrEmpty(item.KeyResultForHis))
                                    {
                                        var categoryCode = item.KeyResultForHis.Split('-').FirstOrDefault()?.ToLower() ?? "nsctc";
                                        var pdfPath = System.IO.Path.Combine("wwwroot", "pdf", categoryCode, $"{item.KeyResultForHis}.pdf");
                                        isPdfValidated = System.IO.File.Exists(pdfPath);
                                    }
                                    <tr id="start-camera" class="row-service" data-resultid="@item.Id">
                                        <td class="td-check">
                                            <input class="form-check-input nsctc-chk-service" type="checkbox" value="@item.Id" data-serviceid="@item.ServiceId" id="flexCheckChecked">
                                        </td>
                                        <td class="td-name" onclick="Process_CheckedBoxOnRow(@item.Id)">
                                            <div class="service-info">
                                                <span class="serviceName">@item.Service.Name</span>
                                                <span class="serviceId">Mã dv: @item.Id</span>
                                            </div>
                                            @if (item.SignStoreId != 0 && item.SignStatus == 1)
                                            {
                                                <span class="digital-sign-icon" title="Đã ký chữ ký điện tử">
                                                    <i class="bi bi-shield-check text-success"></i>
                                                    <small class="text-success">Đã ký số</small>
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Description) || !string.IsNullOrEmpty(item.Result))
                                            {
                                                <span class="result-status-icon" title="Đã có kết quả (mô tả | kết luận)">
                                                    <i class="bi bi-check-circle-fill text-info"></i>
                                                    <small class="text-info">Đã có kết quả (mô tả | kết luận)</small>
                                                    <small class="text-info-image-count">&nbsp;&nbsp;&nbsp;&nbsp; @item?.ImageCDHAs.Count() hình ảnh</small>
                                                </span>
                                            }
                                            @if (isPdfValidated)
                                            {
                                                <span class="pdf-validated-icon" title="Đã Valid (PDF đã tồn tại)">
                                                    <i class="bi bi-file-earmark-pdf-fill text-success"></i>
                                                    <small class="text-success">Đã Valid (PDF)</small>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="camera">
            <video id="video" class="video" autoplay></video>
        </div>
        <div class="group-button-image">
            <div class="group-button">
                <button id="nsctc_process_startcamera" class="btn btn-success margin-top-2 with-2" onclick="StartCamera()">
                    <i class="bi bi-play-btn"></i><br /> Mở camera
                </button>
                <button id="nsctc_process_snapshot" class="btn btn-primary margin-top-2 with-2" onclick="SnapShot()" style="display:none" title="Chụp hình">
                    <i class="bi bi-camera"></i><br /> Chụp ảnh
                </button>
                <button id="nsctc_process_xem" class="btn btn-success margin-top-2 with-2" onclick="XemHinh()" title="Xem hình">
                    <i class="bi bi-eye"></i><br /> Xem ảnh
                </button>
                <button id="nsctc_process_deletephoto" class="btn btn-danger margin-top-2 with-2" onclick="DeletePhoto()" title="Xoá hình">
                    <i class="bi bi-trash"></i><br /> Xóa ảnh
                </button>
                <a id="nsctc_process_downloadvideo_a" download="test.webm" style="display:none"></a>
            </div>
            <div hidden><canvas id="canvas" class="canvas"></canvas></div>
            <div id="imageCDHA" class="imageCDHA"></div>
            <!-- Modal Bootstrap -->
            <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 65rem;">
                    <div class="modal-content" style="width: 100%;">
                        <div class="modal-header">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding: 1.5rem 1.5rem;"></button>
                        </div>
                        <div class="modal-body text-center" style="overflow: hidden;">
                            <img id="modalImage" src="" style="display: block; margin: 1rem; width: 95%;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="right">
        <div class="desscription">
            <div class="content">
                <textarea id="nsctc_process_description" class="form-control textarea-desscription pading-left-5 pading-right-5" placeholder="Mô tả ..."></textarea>
                <script>
                    CKEDITOR.replace('nsctc_process_description', {
                        customConfig: '@Url.Content("~/lib/ckeditor/config.js")',
                        toolbar: 'Full',
                        extraPlugins: 'image,table,specialchar'
                    });
                </script>
            </div>
        </div>
        <div class="result-suggest">
            <div class="result">
                <textarea id="nsctc_process_result" class="form-control textarea-result pading-left-5 pading-right-5" placeholder="Kết luận ..."></textarea>
            </div>
            <div class="suggest">
                <textarea id="nsctc_process_suggest" class="form-control textarea-suggest pading-left-5 pading-right-5" placeholder="Đề nghị ..."></textarea>
            </div>
        </div>
    </div>
</div>
</file>

<file path="Views/NSCTC_Process/_NSCTC_Process_PatientInfo.cshtml">
@using Management.BL
@{
    var patientInfo = ViewData["patientInfo"] as Patient;
    var lstUser = ViewData["lstUser"] as List<User>;
    var lstBenhAnModel = ViewData["lstBenhAnModel"] as List<BenhAnModel>;
    var userLoginId = ViewData["userLoginId"] as long?;

    var age = (patientInfo != null && patientInfo.Age != null) ? patientInfo?.Age?.ToString("dd/MM/yyyy") : string.Empty;
    var getSampleTimeNSCTC = (patientInfo != null && patientInfo.GetSampleTimeNSCTC != null) ? patientInfo?.GetSampleTimeNSCTC?.ToString("dd/MM/yyy HH:mm") : string.Empty;
    var returnResultTimeNSCTC = (patientInfo != null && patientInfo.ReturnResultTimeNSCTC != null) ? patientInfo?.ReturnResultTimeNSCTC : DateTime.Now;
}
<div class="nsctc-right-info-title">THÔNG TIN BỆNH NHÂN</div>
<div class="nsctc-right-info-div-1">
    <div class="nsctc-right-info-div-combo-4">
        <div class="nsctc-right-info-div-combo-4-label-age-object">
            <label>Mã bệnh nhân</label>
        </div>
        <div class="nsctc-right-info-div-combo-4-input">
            <input type="text" id="nsctc_process_id" hidden value="@patientInfo?.Id" />
            <input type="text" id="nsctc_process_patientId" value="@patientInfo?.PatientId" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="nsctc-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Mã BA</label>
        </div>
        <div class="nsctc-right-info-div-combo-4-input">
            <input type="text" id="nsctc_process_maBenhAn" value="@patientInfo?.MaBenhAn" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Mã bệnh phẩm</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <div class="nsctc-right-info-div-combo-2-input-input1">
                <input type="text" id="nsctc_process_seq" value="@patientInfo?.Seq" class="form-control height-28 pading-left-5 pading-right-5" disabled />
            </div>
            <div class="nsctc-right-info-div-combo-2-input-input2">
                <input type="text" id="nsctc_process_sid" value="@patientInfo?.Sid" class="form-control height-28 pading-left-5 pading-right-5 border-left-none" disabled />
            </div>
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Tên bệnh nhân</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <input type="text" id="nsctc_process_patientName" value="@patientInfo?.PatientName" class="form-control height-28 pading-left-5 pading-right-5 " disabled />
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-4 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-4-label-age-object">
            <label>Ngày sinh</label>
        </div>
        <div class="nsctc-right-info-div-combo-4-input">
            <input type="text" id="nsctc_process_age" value="@age" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="nsctc-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Giới tính</label>
        </div>
        <div class="nsctc-right-info-div-combo-4-input">
            <input type="text" id="nsctc_process_sex" value="@patientInfo?.Sex" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-4 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-4-label-age-object">
            <label>Đối tượng</label>
        </div>
        <div class="nsctc-right-info-div-combo-4-input">
            <input type="text" id="nsctc_process_obj" value="@patientInfo?.Object.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
        <div class="nsctc-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label> Bệnh án</label>
        </div>
        <div class="nsctc-right-info-div-combo-4-input">
            @{
                if (lstBenhAnModel != null)
                {
                    var benhan = lstBenhAnModel.Where(p => p.Id == patientInfo?.BenhAn).FirstOrDefault();
                    if (benhan != null)
                    {
                        <input type="text" id="nsctc_process_type" value="@benhan.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                    else
                    {
                        <input type="text" id="nsctc_process_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                }
                else
                {
                    <input type="text" id="nsctc_process_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                }
            }
        </div>
    </div>
</div>
<div class="nsctc-right-info-div-2 pading-left-10">
    <div class="nsctc-right-info-div-combo-2">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Nơi chỉ định</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <input type="text" id="nsctc_process_location" value="@patientInfo?.Location?.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Giờ thực hiện</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <input type="text" id="nsctc_process_getSampleTime" value="@getSampleTimeNSCTC" class="form-control height-28 pading-left-5" disabled />
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Giờ trả KQ</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <input type="datetime-local" id="nsctc_process_returnResultTime" value="@returnResultTimeNSCTC?.ToString("yyyy-MM-dd HH:mm")" class="form-control height-28 pading-left-5 valid" onchange="Process_HideButton(true, false, true, false, true, true)" data-toggle="tooltip" title="Giờ trả kết quả là bắt buộc" data-placement="top" />
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>BS thực hiện</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <input type="hidden" id="nsctc_process_userLoginId" value="@ViewData["userLoginId"]" />
            <select id="nsctc_process_userReturnResultNSCTC" name="userReturnResultNSCTC" class="form-select height-28 valid" data-toggle="tooltip" title="Người trả kết quả là bắt buộc" data-placement="top">
                @if (lstUser != null)
                {
                    var isUserReturnResultNSCTC = false;
                    foreach (var item in lstUser)
                    {
                        if (item.Id == patientInfo?.UserNSCTC?.Id)
                        {
                            <option selected value="@item.Id">@item.Name</option>
                            isUserReturnResultNSCTC = true;
                        }
                        else
                        {
                            if (isUserReturnResultNSCTC == false && userLoginId != null && userLoginId == item.Id)
                            {
                                <option selected value="@item.Id">@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    }
                }
            </select>
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>CCCD</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input">
            <input id="nsctc_process_signerCCCD" class="form-control height-28 pading-left-5 valid" />
        </div>
    </div>
</div>
<div class="nsctc-right-info-div-3 pading-left-10">
    <div class="nsctc-right-info-div-combo-2">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Địa chỉ</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input pading-left-10">
            <textarea id="nsctc_process_address" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Address</textarea>
        </div>
    </div>
    <div class="nsctc-right-info-div-combo-2 div-margin-top-5">
        <div class="nsctc-right-info-div-combo-2-label">
            <label>Chẩn đoán</label>
        </div>
        <div class="nsctc-right-info-div-combo-2-input pading-left-10">
            <textarea id="nsctc_process_diagnostic" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Diagnostic</textarea>
        </div>
    </div>
</div>
</file>

