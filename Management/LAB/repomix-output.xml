.password-container {
    position: relative;
    width: 100%;
}

.password-input {
    padding-right: 35px;
}

.password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    color: #666;
}

    .password-toggle:hover {
        color: #000;
    }
.rule-item {
    font-size: 13px;
    color: #dc3545;
    position: relative;
    padding-left: 22px;
    margin-top: 3px;
}

    .rule-item::before {
        position: absolute;
        left: 0;
        font-weight: bold;
    }

/* FAIL */

.rule-fail {
    color: #dc3545;
}

    .rule-fail::before {
        content: "✖";
        color: #dc3545;
    }

/* OK */

.rule-ok {
    color: #28a745;
}

    .rule-ok::before {
        content: "✔";
        color: #28a745;
    }

