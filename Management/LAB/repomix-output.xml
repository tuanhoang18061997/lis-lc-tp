                currentRow++;

                ws.Cell(currentRow, 1).Value =
                    $"Từ ngày {model.FromDate:dd/MM/yyyy} đến {model.ToDate:dd/MM/yyyy}";
                ws.Range(currentRow, 1, currentRow, 9).Merge().Style
                    .Alignment.SetHorizontal(XLAlignmentHorizontalValues.Center);

