function UploadHinh(fileInput) {
    if (fileInput.files.length === 0) {
        SwalHelper.Toast.warning('Vui lòng chọn file!');
        return;
    }

    var resultCDHAId = null;
    $(".row-service").each(function () { // Lấy value trên từng Row
