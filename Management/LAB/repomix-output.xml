<file path="Views/XQ_ReturnResult/_XQ_ReturnResult_GroupButton.cshtml">
@{
    var _lstUserFunction = ViewData["lstUserFunction"] as List<UserFunction>;
}
<div class="xq-right-service-group-button">
    <button id="xq_returnresult_print" class="btn btn-success btn-blue" onclick="ReturnResult_Print()">
        <i class="bi bi-printer"></i> Print
    </button>

    <button id="xq_returnresult_invalid" class="btn btn-success btn-blue" onclick="ReturnResult_Invalid()">
        <i class="bi bi-arrow-left"></i> Invalid
    </button>
    @{
