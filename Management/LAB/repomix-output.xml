/* Wrapper cho table scroll ngang v?i c?t c? d?nh */
.table-fixed-columns {
    position: relative;
    overflow-x: auto;
    overflow-y: visible;
    max-width: 100%;
}

    .table-fixed-columns table {
        border-collapse: separate;
        border-spacing: 0;
        width: max-content;
    }

    /* C? d?nh các c?t d?u tiên (STT, SEQ, Mã B?nh Án, Mã b?nh nhân, Tên b?nh nhân) */
    .table-fixed-columns thead th:nth-child(1),
    .table-fixed-columns thead th:nth-child(2),
    .table-fixed-columns thead th:nth-child(3),
    .table-fixed-columns thead th:nth-child(4),
    .table-fixed-columns thead th:nth-child(5),
    .table-fixed-columns tbody td:nth-child(1),
    .table-fixed-columns tbody td:nth-child(2),
    .table-fixed-columns tbody td:nth-child(3),
    .table-fixed-columns tbody td:nth-child(4),
    .table-fixed-columns tbody td:nth-child(5) {
        position: sticky;
        background-color: white;
        z-index: 10;
    }

    /* V? trí c? d?nh cho t?ng c?t - STT */
    .table-fixed-columns thead th:nth-child(1),
    .table-fixed-columns tbody td:nth-child(1) {
        left: 0;
        min-width: 40px;
    }

    /* SEQ */
    .table-fixed-columns thead th:nth-child(2),
    .table-fixed-columns tbody td:nth-child(2) {
        left: 40px;
        min-width: 80px;
    }

    /* Mã B?nh Án */
    .table-fixed-columns thead th:nth-child(3),
    .table-fixed-columns tbody td:nth-child(3) {
        left: 120px;
        min-width: 80px;
    }

    /* Mã b?nh nhân */
    .table-fixed-columns thead th:nth-child(4),
    .table-fixed-columns tbody td:nth-child(4) {
        left: 200px;
        min-width: 120px;
    }

    /* Tên b?nh nhân */
    .table-fixed-columns thead th:nth-child(5),
    .table-fixed-columns tbody td:nth-child(5) {
        left: 320px;
        min-width: 200px;
    }

    /* Header c?a các c?t c? d?nh */
    .table-fixed-columns thead th:nth-child(1),
    .table-fixed-columns thead th:nth-child(2),
    .table-fixed-columns thead th:nth-child(3),
    .table-fixed-columns thead th:nth-child(4),
    .table-fixed-columns thead th:nth-child(5) {
        z-index: 11;
        background-color: #dce0e0;
    }

    /* Border và shadow cho c?t cu?i cùng du?c c? d?nh (Tên b?nh nhân) */
    .table-fixed-columns thead th:nth-child(5),
    .table-fixed-columns tbody td:nth-child(5) {
        border-right: 2px solid #999;
        box-shadow: 2px 0 5px -2px rgba(0, 0, 0, 0.2);
    }

    /* Các c?t d?ch v? - có th? scroll */
    .table-fixed-columns thead th:nth-child(n+6),
    .table-fixed-columns tbody td:nth-child(n+6) {
        min-width: 100px;
        position: relative;
        overflow-y: scroll;
    }

    /* Ð?m b?o hover v?n ho?t d?ng */
    .table-fixed-columns tbody tr:hover td {
        background-color: #f5f5f5;
    }

    .table-fixed-columns tbody tr:hover td:nth-child(1),
    .table-fixed-columns tbody tr:hover td:nth-child(2),
    .table-fixed-columns tbody tr:hover td:nth-child(3),
    .table-fixed-columns tbody tr:hover td:nth-child(4),
    .table-fixed-columns tbody tr:hover td:nth-child(5) {
        background-color: #f5f5f5;
    }

    /* Ð?m b?o border v?n hi?n th? dúng */
    .table-fixed-columns .table-bordered th,
    .table-fixed-columns .table-bordered td {
        border: 1px solid #c5c5c5;
    }

