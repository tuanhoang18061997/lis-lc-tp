                int currentRow = 1;

                // Title
                ws.Cell(currentRow, 1).Value = $"BÁO CÁO XÉT NGHIỆM";
                ws.Range(currentRow, 1, currentRow, 9).Merge().Style
                    .Font.SetBold()
                    .Font.SetFontSize(16)
