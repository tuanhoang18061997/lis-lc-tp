        .patient-sa .sid-obj .sid {
            width: 50%;
        }

        .patient-sa .sid-obj .obj {
            width: 50%;
        }

    /* ===== Hàng 2 cột: Bác sĩ chỉ định / Nơi chỉ định ===== */
    .patient-sa .doctor-location {
        white-space: nowrap;
    }

        .patient-sa .doctor-location .doctor,
        .patient-sa .doctor-location .location {
            display: inline-block;
            vertical-align: top;
            white-space: nowrap;
            box-sizing: border-box;
        }

        .patient-sa .doctor-location .doctor {
            width: 50%;
        }

        .patient-sa .doctor-location .location {
            width: 50%;
        }

    /* ===== Hàng full-width: Địa chỉ / Chẩn đoán ===== */
    .patient-sa .address,
    .patient-sa .diagnostic {
        white-space: normal; /* cho phép xuống dòng nếu dài */
    }
/*Dịch vụ Siêu Âm*/
.service-sa {
    clear: both;
    margin-bottom: 3mm;
}

    .service-sa .title {
        font-size: 17px;
        text-decoration: underline;
        font-weight: bold;
        color: red;
    }
.description-sa {
    clear: both;
    margin-bottom: 3mm;
}
    .description-sa .title {
        font-size: 17px;
        text-decoration: underline;
        font-weight: bold;

        color: red;
    }
