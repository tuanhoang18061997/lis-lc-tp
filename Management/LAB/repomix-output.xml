        @{
            if (obj != null)
            {
                if (obj.Active)
                {
                    <input class="form-check-input valid" type="checkbox" id="object-active" onclick="Object_HideButton(true, false, true, false)" checked>
                    <label for="object-active">Active</label>
                }
                else
                {
                    <input class="form-check-input valid" type="checkbox" id="object-active" onclick="Object_HideButton(true, false, true, false)">
                    <label for="object-active">Active</label>
                }              
            }
            else
            {
                <input class="form-check-input valid" type="checkbox" id="object-active" onclick="Object_HideButton(true, false, true, false)">
                <label for="object-active">Active</label>
            }
        }       
    </div>
</div>
</file>

<file path="Views/NS_ReturnResult/Object/_Object_List.cshtml">
@{
    var lstObject = ViewData["lstObject"] as List<Management.Models.Object>;
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-checkbox" scope="col"></th>
                <th class="th-number" scope="col">Stt</th>
                <th class="th-id" scope="col">Id</th>
                <th class="th-code" scope="col">Mã</th>
                <th class="th-name" scope="col">Tên</th> 
                <th class="th-active" scope="col">Active</th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-service">
            @{
                if (lstObject != null && lstObject.Count > 0)
                {
                    var index = 0;
                    foreach (var item in lstObject)
                    {
                        index++;
                        <tr class="row-service" onclick="Object_CheckedBoxOnRow('@item.Code')">
                            <td class="td-checkbox">
                                <input class="form-check-input" type="checkbox" value="@item.Code" id="flexCheckChecked">
                            </td>
                            <td class="td-number">@index</td>
                            <td class="td-id">@item.Id</td>
                            <td class="td-code">@item.Code</td>
                            <td class="td-name">@item.Name</td>
                            <td class="td-active">@item.Active</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
</file>

