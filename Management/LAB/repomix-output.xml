        min-width: 70px; /* độ rộng tối thiểu cho label, để không dính vào value */
    }

    .patient-sa .label2 {
        width: 115px;
    }
        /* label2 nhỏ hơn */
        .patient-sa .label1::after,
        .patient-sa .label2::after {
            content: ":";
            margin: 0 4px;
        }

    /* Hủy các float cũ để tránh rớt dòng */
    .patient-sa .label1,
    .patient-sa .label2,
    .patient-sa .name-sex-age .name,
    .patient-sa .name-sex-age .sex,
