/* Toàn bộ khối chữ ký: không cho ngắt trang bên trong, tách khỏi float trước đó */
.signature-page-sa {
    clear: both;
    break-inside: avoid;
    page-break-inside: avoid;
    padding-top: 2mm; /* tạo khoảng cách an toàn với phần trên */
}

    /* 2 cột: bên trái chỉ là khoảng trống, bên phải chứa toàn bộ thông tin */
    .signature-page-sa .signature {
        display: flex;
        justify-content: flex-end; /* dồn nội dung sang phải */
        align-items: flex-start;
        gap: 16px;
    }

        /* Cột trái làm “đệm” */
        .signature-page-sa .signature .signature-left {
            flex: 1 1 auto; /* chiếm phần còn lại để đẩy cột phải sang mép phải */
        }

        /* Cột phải chứa nội dung chữ ký */
        .signature-page-sa .signature .signature-right {
            width: 420px; /* tùy trang A4 dọc, bạn có thể 380–460px */
            text-align: center;
            font-size: 19px;
        }

            /* Dòng thời gian */
            .signature-page-sa .signature .signature-right .signature-right-time {
                line-height: 24px;
                margin-bottom: 5px;
            }

            /* Tiêu đề */
            .signature-page-sa .signature .signature-right .signature-right-title {
                font-weight: 700;
                line-height: 10px;
                margin-bottom: 5px;
            }

            /* Khung ảnh chữ ký – bỏ height cố định để tránh cắt ảnh */
            .signature-page-sa .signature .signature-right .signature-right-cks {
                /* KHÔNG dùng height: 55px; */
                min-height: 50px; /* giữ không gian tối thiểu */
                display: flex;
                align-items: center;
                justify-content: center;
            }

                /* Ảnh chữ ký – tự co giãn, không méo, không tràn khung */
                .signature-page-sa .signature .signature-right .signature-right-cks img {
                    max-width: 80%;
                    max-height: 100px; /* tăng/giảm nếu ảnh nhỏ/quá to */
                    height: auto;
                    width: auto;
                    object-fit: contain;
                    image-rendering: -webkit-optimize-contrast;
                }

            /* Tên bác sĩ – to, rõ, không bị đè */
            .signature-page-sa .signature .signature-right .signature-right-user {
                font-weight: 700;
                font-size: 21px;
                line-height: 24px;
                margin-top: .1rem;
            }

/* Khi in PDF, cho phép co giãn tốt hơn để tránh bị cắt */
@media print {
    .signature-page-sa {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

        .signature-page-sa .signature .signature-right .signature-right-cks {
            min-height: 80px;
        }
}
