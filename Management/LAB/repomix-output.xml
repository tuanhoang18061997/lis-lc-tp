                                                <i class="bi bi-file-earmark-pdf-fill"></i>
                                                <small>PDF</small>
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-muted text-center py-3">Không có dịch vụ TDCN.</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
