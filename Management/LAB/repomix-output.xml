}

.result-value.text-primary {
    color: #0d6efd !important;
}

.result-value.text-danger {
    color: #dc3545 !important;
}

.table-info td {
    background-color: #d1ecf1 !important;
    border-color: #bee5eb !important;
    font-weight: 600;
}

.table-warning td {
    background-color: #fff3cd !important;
    border-color: #ffecb5 !important;
    font-weight: 700;
    font-size: 16px;
}

/* Category Section Styles */
.category-section {
    margin-bottom: 40px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 15px rgba(0,0,0,0.08);
    overflow: hidden;
}

.category-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 20px 25px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
}

.category-header h4 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
}

.category-header i {
    font-size: 20px;
}

.category-header .badge {
    font-size: 12px;
    padding: 6px 12px;
    background: rgba(255,255,255,0.2) !important;
}

/* Category-specific header colors */
.category-header.category-hs {
    background: linear-gradient(135deg, #3498db 0%, #2980b9 100%);
}

.category-header.category-hh {
    background: linear-gradient(135deg, #e74c3c 0%, #c0392b 100%);
}

.category-header.category-vs {
    background: linear-gradient(135deg, #f39c12 0%, #e67e22 100%);
}

.category-header.category-md {
    background: linear-gradient(135deg, #27ae60 0%, #229954 100%);
}

.category-header.category-ns {
    background: linear-gradient(135deg, #9b59b6 0%, #8e44ad 100%);
}

.category-header.category-nt {
    background: linear-gradient(135deg, #34495e 0%, #2c3e50 100%);
}

/* Service header within category */
.table-secondary td {
    background-color: #e9ecef !important;
    border-color: #dee2e6 !important;
    font-weight: 600;
    color: #495057;
}

/* Category badge colors */
.badge.bg-purple {
    background-color: #6f42c1 !important;
}

.badge.bg-info {
    background-color: #0dcaf0 !important;
}

/* Hierarchical indentation styling */
.category-row td {
    border-left: 5px solid #ffc107;
    background: #fff3cd;
}

.service-row td {
    border-left: 5px solid #0dcaf0;
    background: #d1ecf1;
}

.test-row td:first-child {
    border-left: 3px solid #6c757d;
    padding-left: 50px;
}

/* Status badges for XN results */
.badge.bg-success {
    background-color: #198754 !important;
}

.badge.bg-primary {
    background-color: #0d6efd !important;
}

.badge.bg-danger {
    background-color: #dc3545 !important;
}

.badge.bg-secondary {
    background-color: #6c757d !important;
}

/* Category icons styling */
.category-icon {
    margin-right: 8px;
    width: 16px;
    text-align: center;
}

/* Enhanced table styling for category view */
.category-section .table {
    margin-bottom: 0;
}

.category-section .table-striped > tbody > tr:nth-of-type(odd) > td {
    background-color: rgba(0,0,0,.02);
}

.category-section .table-hover > tbody > tr:hover > td {
    background-color: rgba(102, 126, 234, 0.05);
}

/* Service group styling */
.service-group-header {
    background: linear-gradient(45deg, #f8f9fa, #e9ecef);
    border-left: 4px solid #667eea;
}

/* Tab content styling */
.tab-content {
    border: none;
    padding: 20px 0;
}

.nav-tabs .nav-link {
    border: none;
    border-radius: 8px 8px 0 0;
    margin-right: 5px;
    padding: 12px 20px;
    color: #666;
    font-weight: 500;
    transition: all 0.3s ease;
}

.nav-tabs .nav-link:hover {
    border-color: transparent;
    background-color: #f8f9fa;
    color: #667eea;
}

.nav-tabs .nav-link.active {
    background-color: #667eea;
    color: white;
    border-color: #667eea;
}

/* Responsive category table */
@media (max-width: 768px) {
    .test-row td:first-child {
        padding-left: 30px;
    }
    
    .table-warning td,
    .table-info td {
        font-size: 14px;
    }
    
    .category-header {
        font-size: 14px;
        padding: 15px 20px;
    }
    
    .category-header h4 {
        font-size: 16px;
    }
    
    .category-section {
        margin-bottom: 25px;
    }
}

/* Responsive cho mobile */
@media (max-width: 768px) {
    .image-thumbnail {
        width: 60px;
        height: 60px;
    }

    .image-thumbnails {
        gap: 8px;
    }

    .thumbnail-overlay {
        opacity: 1;
        background: rgba(0,0,0,0.4);
    }

    .xn-results-table {
        font-size: 12px;
    }

    .xn-results-table .table th,
    .xn-results-table .table td {
        padding: 8px 10px;
    }

    .nav-tabs .nav-link {
        padding: 10px 15px;
        font-size: 14px;
    }
}

/* Animation cho loading thumbnails */
.image-thumbnail.loading {
    background: #f8f9fa;
}

    .image-thumbnail.loading::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        width: 20px;
        height: 20px;
        margin: -10px 0 0 -10px;
        border: 2px solid #dee2e6;
        border-top: 2px solid #007bff;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

@keyframes spin {
    0% {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }
}

/* Print Styles */
@media print {
    .print-button, .btn, .nav-tabs {
        display: none !important;
    }

    .result-card {
        break-inside: avoid;
        margin-bottom: 20px;
        box-shadow: none;
        border: 1px solid #ddd;
    }

    .portal-header {
        background: #f8f9fa !important;
        color: #333 !important;
        -webkit-print-color-adjust: exact;
    }

    .date-section, .category-section {
        break-inside: avoid;
    }

    .xn-results-table {
        break-inside: avoid;
    }

    .tab-content .tab-pane {
        display: block !important;
        opacity: 1 !important;
    }
    
    .category-header {
        background: #f8f9fa !important;
        color: #333 !important;
        -webkit-print-color-adjust: exact;
    }
}

/* Responsive */
@media (max-width: 768px) {
    .portal-container {
        padding: 10px;
    }

    .results-grid {
        grid-template-columns: 1fr;
    }

    .patient-details {
        grid-template-columns: 1fr;
    }

    .results-summary {
        justify-content: center;
    }

    .result-footer {
        flex-direction: column;
        align-items: flex-start;
    }
}
