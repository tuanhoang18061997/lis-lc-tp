/* Toàn bộ khối chữ ký: không cho ngắt trang bên trong, tách khỏi float trước đó */
.signature-page-xn {
    clear: both;
    break-inside: avoid;
    page-break-inside: avoid;
    padding-top: 4mm; /* tạo khoảng cách an toàn với phần trên */

}

    /* 2 cột: bên trái chỉ là khoảng trống, bên phải chứa toàn bộ thông tin */
    .signature-page-xn .signature {
        display: flex;
        justify-content: flex-end; /* dồn nội dung sang phải */
        align-items: flex-start;
        gap: 8px;
    }

        /* Cột trái làm “đệm” */
        .signature-page-xn .signature .signature-left {
            flex: 1 1 auto; /* chiếm phần còn lại để đẩy cột phải sang mép phải */
        }

        /* Cột phải chứa nội dung chữ ký */
        .signature-page-xn .signature .signature-right {
            width: 420px; /* tùy trang A4 dọc, bạn có thể 380–460px */
            text-align: center;
            font-size: 16px;
        }
            /* Dòng thời gian */
            .signature-page-xn .signature .signature-right .signature-right-user-check {
                line-height: 24px;
                /*margin-bottom: 3px;*/
                font-size: 16px;
            }

                .signature-page-xn .signature .signature-right .signature-right-user-check > label {
                    font-style: italic;
                }

            /* Dòng thời gian */
            .signature-page-xn .signature .signature-right .signature-right-time {
                line-height: 24px;
                margin-bottom: 5px;
                font-style: italic
            }

            /* Tiêu đề */
            .signature-page-xn .signature .signature-right .signature-right-title {
                font-weight: 700;
                line-height: 10px;
                margin-bottom: 5px;
            }

            /* Khung ảnh chữ ký – bỏ height cố định để tránh cắt ảnh */
            .signature-page-xn .signature .signature-right .signature-right-cks {
                /* KHÔNG dùng height: 55px; */
                min-height: 30px; /* giữ không gian tối thiểu */
                display: flex;
                align-items: center;
                justify-content: center;
            }

                /* Ảnh chữ ký – tự co giãn, không méo, không tràn khung */
                .signature-page-xn .signature .signature-right .signature-right-cks img {
                    max-width: 80%;
                    max-height: 100px; /* tăng/giảm nếu ảnh nhỏ/quá to */
                    height: auto;
                    width: auto;
                    object-fit: contain;
                    image-rendering: -webkit-optimize-contrast;
                }

            /* Tên bác sĩ – to, rõ, không bị đè */
            .signature-page-xn .signature .signature-right .signature-right-user {
                font-weight: 700;
                font-size: 18px;
                line-height: 20px;
                /*margin-top: .1rem;*/
            }

/* Khi in PDF, cho phép co giãn tốt hơn để tránh bị cắt */
