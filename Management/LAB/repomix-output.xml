                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a id="3" class="nav-link text-white bg-dark hover @(ViewContext.RouteData.Values["controller"]?.ToString() == "XQ_ReturnResult" ? "active" : "")" asp-controller="XQ_ReturnResult" asp-action="ReturnResult">
                                        Đã xong <span id="countReturnResult" class="badge badge-success">@ViewData["countReturnResult"]</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </nav>
            </div>
            <div class="menu-right">
                <div class="dropdown menu-right-width menu-right-margin-padding">
