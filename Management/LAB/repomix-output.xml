                                <td>@row.PatientName</td>
                                <td>@row.Gender</td>
                                <td>@row.Age?.ToString("dd/MM/yyyy")</td>
                                <td>@row.SoCccd</td>
                                <td>@row.MaDotKham</td>
                                <td>@row.MaBenhAn</td>
