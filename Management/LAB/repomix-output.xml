}

/* ✅ QUAN TRỌNG: Đảm bảo modal body có thể scroll cả 2 chiều */
#imageModal .modal-body {
    position: relative;
    overflow: auto !important; /* Cho phép scroll cả ngang và dọc */
    cursor: default;
    min-height: 300px;
    /* Đảm bảo có không gian để ảnh zoom */
    white-space: nowrap; /* Ngăn wrap khi zoom */
}

    /* Custom scrollbar */
    #imageModal .modal-body::-webkit-scrollbar {
        width: 12px;
        height: 12px;
    }

    #imageModal .modal-body::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 6px;
    }

    #imageModal .modal-body::-webkit-scrollbar-thumb {
        background: #c1c1c1;
        border-radius: 6px;
    }

        #imageModal .modal-body::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

    /* Corner where scrollbars meet */
    #imageModal .modal-body::-webkit-scrollbar-corner {
        background: #f1f1f1;
    }

/* Responsive modal */
@media (max-width: 768px) {
    .zoom-controls .btn {
        padding: 4px 8px;
        font-size: 12px;
        min-width: 35px;
    }

