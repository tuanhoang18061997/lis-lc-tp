<file path="Views/CK/CkBrowseImages.cshtml">
@{
    Layout = null;
}
@model List<string>
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Browse Images</title>
    <style>
        body { font-family: system-ui, sans-serif; padding: 12px; }
        ul { list-style: none; padding: 0; }
        li { margin: 8px 0; display: flex; align-items: center; gap: 8px; }
        img { height: 40px; border-radius: 4px; }
        a { text-decoration: none; }
    </style>
</head>
<body>
    <h3>Chọn ảnh</h3>
    <ul>
        @foreach (var url in Model)
        {
            <li>
                <img src="@url" alt="" />
                <a href="#" onclick="selectFile('@url');return false;">@url</a>
            </li>
        }
    </ul>

    <script>
        function getUrlParam(name) {
          var re = new RegExp('[?&]' + name + '=([^&]+)', 'i');
          var m = location.search.match(re);
          return m && m[1] ? decodeURIComponent(m[1]) : null;
        }
        function selectFile(url) {
          var funcNum = getUrlParam('CKEditorFuncNum');
          window.opener.CKEDITOR.tools.callFunction(funcNum, url);
          window.close();
        }
    </script>
</body>
</html>
</file>

