<file path="Views/SA_Process/_SA_Process_ListService.cshtml">
@{
    var lstresultCDHAs = ViewData["lstresultCDHAs"] as List<ResultCDHA>;
}

<div class="table-responsive">
    <div class="left">
        <div class="list-service">
            <div class="table-responsive">
                <table class="table table-hover table-bordered" id="sa_list_service">
                    <thead>
                        <tr>
                            <th style="width:32px; text-align:center;">
                                <input type="checkbox" id="sa_chk_all" />
                            </th>
                            <th>Dịch vụ</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-gridview-service" class="tbody-service">
                        @{
                            if (lstresultCDHAs != null && lstresultCDHAs.Count > 0)
                            {
                                var index = 0;
                                foreach (var item in lstresultCDHAs)
                                {
                                    index++;
                                    // Kiểm tra xem file PDF đã tồn tại chưa
                                    var isPdfValidated = false;
                                    if (!string.IsNullOrEmpty(item.KeyResultForHis))
                                    {
                                        var categoryCode = item.KeyResultForHis.Split('-').FirstOrDefault()?.ToLower() ?? "sa";
                                        var pdfPath = System.IO.Path.Combine("wwwroot", "pdf", categoryCode, $"{item.KeyResultForHis}.pdf");
                                        isPdfValidated = System.IO.File.Exists(pdfPath);
                                    }
                                    <tr id="start-camera" class="row-service" data-resultid="@item.Id">
                                        <td class="td-check">
                                            <input class="form-check-input sa-chk-service" type="checkbox" value="@item.Id" data-serviceid="@item.ServiceId" data-bs-thuc-hien="@item.UserUpdateId" id="flexCheckChecked">
                                        </td>
                                        <td class="td-name" onclick="Process_CheckedBoxOnRow(@item.Id)">
                                            <div class="service-info">
                                                <span class="serviceName">@item.Service.Name</span>
                                                <span class="serviceId">Mã dv: @item.Id</span>
                                            </div>
                                            @if (item.SignStoreId != 0 && item.SignStatus == 1)
                                            {
                                                <span class="digital-sign-icon" title="Đã ký chữ ký điện tử">
                                                    <i class="bi bi-shield-check text-success"></i>
                                                    <small class="text-success">Đã ký số</small>
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Description) || !string.IsNullOrEmpty(item.Result))
                                            {
                                                <span class="result-status-icon" title="Đã có kết quả (mô tả | kết luận)">
                                                    <i class="bi bi-check-circle-fill text-info"></i>
                                                    <small class="text-info">Đã có kết quả (mô tả | kết luận)</small>
                                                    <small class="text-info-image-count">&nbsp;&nbsp;&nbsp;&nbsp; @item?.ImageCDHAs.Count() hình ảnh</small>
                                                </span>
                                            }
                                            @* Icon đã Valid (PDF) - MỚI THÊM *@
                                            @if (isPdfValidated)
                                            {
                                                <span class="pdf-validated-icon" title="Đã Valid (PDF đã tồn tại)">
                                                    <i class="bi bi-file-earmark-pdf-fill text-success"></i>
                                                    <small class="text-success">Đã Valid (PDF)</small>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="camera">
            <video id="video" class="video" autoplay></video>
        </div>
        <div class="group-button-image">
            <div class="group-button">
                <button id="sa_process_startcamera" class="btn btn-success margin-top-2 with-2" onclick="StartCamera()">
                    <i class="bi bi-play-btn"></i><br /> Mở camera
                </button>
                <button id="sa_process_snapshot" class="btn btn-primary margin-top-2 with-2" onclick="SnapShot()" style="display:none" title="Chụp hình">
                    <i class="bi bi-camera"></i><br/> Chụp ảnh <b>(F2)</b>
                </button>
                <button id="sa_process_xem" class="btn btn-success margin-top-2 with-2" onclick="XemHinh()" title="Xem hình">
                    <i class="bi bi-eye"></i><br /> Xem ảnh
                </button>
                <button id="sa_process_deletephoto" class="btn btn-danger margin-top-2 with-2" onclick="DeletePhoto()" title="Xoá hình">
                    <i class="bi bi-trash"></i><br /> Xóa ảnh
                </button>
                <label for="fileInput" class="btn btn-danger margin-top-2 with-2 custom-upload"><i class="bi bi-upload" style="display: block;"></i>Tải hình</label>
                <input type="file" id="fileInput" name="file" onchange="UploadHinh(this)" title="Tải hình" accept="image/png, image/jpeg">
@*                <button id="sa_process_startvideo" class="btn btn-success margin-top-2 with-2" onclick="StartVideo()" style="display:none">
                    <i class="bi bi-camera-video"></i><br /> Ghi video
                </button>
                <button id="sa_process_stopvideo" class="btn btn-success margin-top-2 with-2" onclick="StopVideo()" style="display:none">
                    <i class="bi bi-camera-video-fill"></i><br /> Dừng video
                </button>
                 <button id="sa_process_downloadvideo" class="btn btn-success margin-top-2 with-2 margin-4" onclick="DownloadVideo()" value="" style="display:none" title="Lưu video">
                    <i class="bi bi-download"></i><br /> Lưu Video
                </button>
                <button id="sa_process_deletevideo" class="btn btn-danger margin-top-2 with-2" onclick="DeleteVideo()" style="display:none" title="Xoá video">
                    <i class="bi bi-camera-video-off"></i><br /> Xóa Video
                </button>  *@                 
                <a id="sa_process_downloadvideo_a" download="test.webm" style="display:none"></a>
            </div>
            <div hidden> <canvas id="canvas" class="canvas"></canvas></div>
            <div id="imageCDHA" class="imageCDHA"></div>
            <!-- Modal Bootstrap -->
            <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 65rem;">
                    <div class="modal-content" style="width: 100%;">
                        <div class="modal-header">
                            <button type="button" class="btn-close" data-bs-dismiss="modal" style="padding: 1.5rem 1.5rem;"></button>
                        </div>
                        <div class="modal-body text-center" style="overflow: hidden;">
                            <img id="modalImage" src="" style="display: block; margin: 1rem; width: 95%;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="right">
        <div class="desscription">
            <div class="content">
                <textarea id="sa_process_description" class="form-control textarea-desscription pading-left-5 pading-right-5" placeholder="Mô tả ..."></textarea>
                <script>
                    CKEDITOR.replace('sa_process_description', {
                        customConfig: '@Url.Content("~/lib/ckeditor/config.js")',
                        toolbar: 'Full',
                        extraPlugins: 'image,table,specialchar' // ép nạp plugin nếu cần
                    });
                </script>
            </div>
        </div>
        <div class="result-suggest">
            <div class="result">
                <div class="result-title">Kết luận:</div>
                <textarea id="sa_process_result" class="form-control textarea-result pading-left-5 pading-right-5" placeholder="Kết luận ..."></textarea>
            </div>
            <div class="suggest">
                <div class="suggest-title">Đề nghị:</div>
                <textarea id="sa_process_suggest" class="form-control textarea-suggest pading-left-5 pading-right-5" placeholder="Đề nghị ..."></textarea>
            </div>
        </div>
    </div>
</div>
