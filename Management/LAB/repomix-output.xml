.settup-container {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(320px, 400px); /* trái co giãn, phải cố định */
    gap: 0.75rem;
    align-items: flex-start;
}

/* Bên trái: full height + scroll nội bộ như cũ */
.settup-left-testcode {
    padding-right: 0; /* đã có gap, không cần padding phải */
    min-width: 0; /* cho phép bảng co trong grid */
}

/* Bên phải: bỏ width cứng, để grid control */
.settup-right-testcode {
    width: 100%;
    max-width: 400px;
    flex-shrink: 0; /* nếu có flex fallback */
}

/* Mobile / tablet: stack 1 cột */
@media (max-width: 991.98px) {
    .settup-container {
        display: grid;
        grid-template-columns: 1fr;
    }

    .settup-left-testcode{
        order: 1;
        width: 100%;
    }

    .settup-right-testcode{
        order: 2; /* info trên */
        width: 100%;
        max-width: 100%;
    }
}
