    /* Patient block & mô tả nối tiếp dưới header */
/* ==== PATIENT INFO: label + value trên cùng 1 dòng (không dùng flex/grid) ==== */
.patient-sa {
    clear: both;
    font-size: 16px;
    margin-bottom: 3mm;
}
.patient-sa .title {
    font-size: 17px;
    text-decoration: underline;
    font-weight: bold;
    margin-bottom: 1mm;
    color: red;
}
    /* Label chung */
    .patient-sa .label1,
    .patient-sa .label2 {
        display: inline-block;
