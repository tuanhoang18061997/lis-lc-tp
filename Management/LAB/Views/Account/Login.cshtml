@using Management.BL
@inject IHttpContextAccessor HttpContextAccessor
@{
    var hospitalName = HttpContextAccessor.HttpContext.Request.Cookies[SessionKeyModel._sessionHospital];
    if (!string.IsNullOrEmpty(hospitalName)) ViewData["Title"] = hospitalName;
    Layout = "_LayoutAccount";
}
@model User

<div class="login-parent">
    <div class="login-child">
        <form asp-controller="Account" asp-action="Logged" method="post" id="login" onsubmit="return ValidateInput('login')">
            <div class="form-outline mb-4">
                <i class="bi bi-person"></i> <label asp-for="Code" class="form-label">Tên đăng nhập</label>
                <input asp-for="Code" type="text" class="form-control valid" data-toggle="tooltip" title="Tên đang nhập là bắt buộc" data-placement="top" />
            </div>
            <div class="form-outline mb-4">
                <i class="bi bi-key"></i> <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control valid" data-toggle="tooltip" title="Mật khẩu là bắt buộc" data-placement="top" />
            </div>
            <div class="form-outline mb-4">
                @if (ViewData["Login"] != null)
                {
                    <div class="margin-bottom-10 text-red">@ViewData["Login"]</div>
                }
                <div class="div-center">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-box-arrow-right"></i> Đăng nhập
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>