@using Management.BL
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = HttpContextAccessor.HttpContext.Request.Cookies[SessionKeyModel._sessionHospital];
    Layout = "_LayoutAccount";
}
@model User
<style>
    .rule-password {
        border-radius: 10px;
        border: 1px solid #d1bfbf;
        padding: 0.8rem;
    }
    .rule-item {
        font-size: 13px;
        color: #dc3545;
        position: relative;
        padding-left: 22px;
        margin-top: 3px;
    }

        .rule-item::before {
            position: absolute;
            left: 0;
            font-weight: bold;
        }

    /* FAIL */

    .rule-fail {
        color: #dc3545;
    }

        .rule-fail::before {
            content: "✖";
            color: #dc3545;
        }

    /* OK */

    .rule-ok {
        color: #28a745;
    }

        .rule-ok::before {
            content: "✔";
            color: #28a745;
        }
</style>
<div class="login-parent">
    <div class="login-child">
        <form asp-controller="Account" asp-action="ChangedPassword" method="post" id="changedPassword" onsubmit="return ValidateInput('changedPassword')">
            <input asp-for="Code" type="text" hidden />
            <div class="form-outline mb-3">
                <i class="bi bi-key"></i> <label asp-for="Password" class="form-label">Mật khẩu cũ</label>
                <div class="input-group">
                    <input asp-for="Password" type="password" class="form-control valid" data-toggle="tooltip" title="Mật khẩu cũ là bắt buộc" data-placement="top" />
                    <span class="input-group-text toggle-password" style="cursor: pointer;">
                        <i class="bi bi-eye-slash"></i>
                    </span>
                </div>
            </div>
            <div class="form-outline mb-3">
                <i class="bi bi-key"></i> <label asp-for="Password" class="form-label">Mật khẩu mới</label>
                <div class="input-group">
                    <input type="password" name="passwordNew1" class="form-control valid" data-toggle="tooltip" title="Mật khẩu mới là bắt buộc" data-placement="top" />
                    <span class="input-group-text toggle-password" style="cursor: pointer;">
                        <i class="bi bi-eye-slash"></i>
                    </span>
                </div>
            </div>
            <!-- RULE -->
            <div class="rule-password">

                <div id="required-pass" class="rule-item rule-fail">
                    Bắt buộc nhập
                </div>

                <div id="minLength-pass" class="rule-item rule-fail">
                    Tối thiểu 8 ký tự
                </div>

                <div class="rule-character-password">

                    <span id="character-lower" class="rule-item rule-fail">
                        Ký tự thường
                    </span>

                    <span id="character-upper" class="rule-item rule-fail">
                        Ký tự hoa
                    </span>

                    <span id="character-isNumber" class="rule-item rule-fail">
                        Ký tự số
                    </span>

                    <span id="character-special" class="rule-item rule-fail">
                        Ký tự đặc biệt
                    </span>

                </div>

                <div id="notIncluded-username-pass" class="rule-item rule-fail">
                    Không chứa username
                </div>

                <div id="khong-chua-chuoi-ky-tu-lien-tuc-pass" class="rule-item rule-fail">
                    Không chứa chuỗi liên tục : abc,123
                </div>

            </div>
            <div class="form-outline mb-3">
                <i class="bi bi-key"></i> <label asp-for="Password" class="form-label">Nhập lại mật khẩu mới</label>
                <div class="input-group">
                    <input type="password" name="passwordNew2" class="form-control valid" data-toggle="tooltip" title="Xác nhận mật khẩu mới là bắt buộc" data-placement="top" />
                    <span class="input-group-text toggle-password" style="cursor: pointer;">
                        <i class="bi bi-eye-slash"></i>
                    </span>
                </div>
                <small id="password-match" class="rule-fail">
                    Mật khẩu nhập lại phải khớp với mật khẩu mới
                </small>
            </div>
            <div class="form-outline mb-3">
                @if (ViewData["ChangePassword"] != null)
                {
                    <div class="margin-bottom-10 text-red"> @ViewData["ChangePassword"]</div>                      
                }
                <div class="div-center">
                    <button type="submit" class="btn btn-success margin-right-10">
                        <i class="bi bi-save"></i> Lưu
                    </button>
                    <a class="btn btn btn-danger" asp-controller="Account" asp-action="Logout" data-toggle="collapse" role="button" aria-expanded="false" aria-controls="collapseExample">
                        <i class="bi bi-x-square"></i> Huỷ
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <script>
        // Toggle ẩn/hiện password — dùng PasswordValidation chung
        document.querySelectorAll('.toggle-password').forEach(function (toggle) {
            toggle.addEventListener('click', function () {
                PasswordValidation.togglePasswordByElement(this);
            });
        });

        // Validate password mới realtime
        $("input[name='passwordNew1']").on("input", function () {
            var password = $(this).val();
            var username = $("#Code").val();
            PasswordValidation.validateRealtime(password, username);

            // Cập nhật trạng thái khớp khi thay đổi password mới
            var confirmPassword = $("input[name='passwordNew2']").val();
            PasswordValidation.checkPasswordMatch(password, confirmPassword);
        });

        // Validate nhập lại password realtime
        $("input[name='passwordNew2']").on("input", function () {
            var password = $("input[name='passwordNew1']").val();
            var confirmPassword = $(this).val();
            PasswordValidation.checkPasswordMatch(password, confirmPassword);
        });

        // Kiểm tra trước khi submit
        $("#changedPassword").on("submit", function () {
            var passwordNew = $("input[name='passwordNew1']").val();
            var confirmPassword = $("input[name='passwordNew2']").val();
            var username = $("#Code").val();

            if (!PasswordValidation.isPasswordValid(passwordNew, username)) {
                return false;
            }
            if (passwordNew !== confirmPassword) {
                PasswordValidation.checkPasswordMatch(passwordNew, confirmPassword);
                return false;
            }
        });
    </script>
}