@{
    var lstresultCDHAs = ViewData["lstresultCDHAs"] as List<ResultCDHA>;
    var patientInfos = ViewData["patientInfos"] as Patient;
}

<div class="table-responsive">
    <div class="left">
        <div class="list-service">
            <div class="table-responsive">
                <table class="table table-hover table-bordered" id="xq_list_service">
                    <thead>
                        <tr class="tr-title">
                            <th class="th-check" style="width: 30px; text-align: center;">
                                <input class="form-check-input" type="checkbox" id="xq_chk_all" title="Chọn tất cả" />
                            </th>
                            <th class="th-service" style="text-align: center;">Dịch vụ</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-gridview-service" class="tbody-service">
                        @{
                            if (lstresultCDHAs != null && lstresultCDHAs.Count > 0)
                            {
                                var index = 0;
                                foreach (var item in lstresultCDHAs)
                                {
                                    index++;
                                    // Kiểm tra xem file PDF đã tồn tại chưa
                                    var isPdfValidated = false;
                                    if (!string.IsNullOrEmpty(item.KeyResultForHis))
                                    {
                                        var categoryCode = item.KeyResultForHis.Split('-').FirstOrDefault()?.ToLower() ?? "xq";
                                        var pdfPath = System.IO.Path.Combine("wwwroot", "pdf", categoryCode, $"{item.KeyResultForHis}.pdf");
                                        isPdfValidated = System.IO.File.Exists(pdfPath);
                                    }
                                    <tr id="start-camera" class="row-service" data-resultid="@item.Id">
                                        <td class="td-check">
                                            <input class="form-check-input xq-chk-service" type="checkbox" value="@item.Id" data-serviceid="@item.ServiceId" data-bs-thuc-hien="@item.UserUpdateId" id="flexCheckChecked">
                                        </td>
                                        <td class="td-name" onclick="Process_CheckedBoxOnRow(@item.Id)">
                                            <div class="service-info">
                                                <span class="serviceName">@item.Service.Name</span>
                                                <span class="serviceId">Mã dv: @item.Id</span>
                                            </div>
                                            @if (item.SignStoreId != 0 && item.SignStatus == 1)
                                            {
                                                <span class="digital-sign-icon" title="Đã ký chữ ký điện tử">
                                                    <i class="bi bi-shield-check text-success"></i>
                                                    <small class="text-success">Đã ký số</small>
                                                </span>
                                            }
                                            @if (!string.IsNullOrEmpty(item.Description) || !string.IsNullOrEmpty(item.Result))
                                            {
                                                <span class="result-status-icon" title="Đã có kết quả (mô tả | kết luận)">
                                                    <i class="bi bi-check-circle-fill text-info"></i>
                                                    <small class="text-info">Đã có kết quả (mô tả | kết luận)</small>
                                                </span>
                                            }
                                            @* Icon đã Valid (PDF) - MỚI THÊM *@
                                            @if (isPdfValidated)
                                            {
                                                <span class="pdf-validated-icon" title="Đã Valid (PDF đã tồn tại)">
                                                    <i class="bi bi-file-earmark-pdf-fill text-success"></i>
                                                    <small class="text-success">Đã Valid (PDF)</small>
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>  
        <div class="contain-hinh">
            
        </div>
        <!-- Modal Bootstrap -->
        <div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center" style="overflow: hidden;">
                        <img id="modalImage" src="" style="display: block; margin: auto;">
                    </div>
                </div>
            </div>
        </div>
        <!-- Modal Bootstrap -->
        <div style="float: left; height: 40px">
            <label for="fileInput" class="custom-upload"><i class="bi bi-upload"></i></label>
            <input type="file" id="fileInput" name="file" onchange="UploadHinh(this)" title="Tải hình" accept="image/png, image/jpeg">
            <button id="xq_process_xem" class="btn btn-success with-2" onclick="XemHinh()" title="Xem hình" style="font-size: 14px">
                <i class="bi bi-eye"></i>
            </button>
            <button id="xq_process_delete" class="btn btn-danger with-2" onclick="DeleteHinh()" title="Xoá hình" style="font-size: 14px">
                <i class="bi bi-trash"></i>
            </button>
        </div>
        <div class="xq-tools-row">
            @{
                if (patientInfos != null) {
                    <input id="xq_text_key" class="form-control" placeholder="Nhập Mã Hồ Sơ Khám (ví dụ: BA0000001)" value="@patientInfos.MaBenhAn">
                }
                else
                {
                    <input id="xq_text_key" class="form-control" placeholder="Nhập Mã Hồ Sơ Khám (ví dụ: BA0000001)">
                }
            }
            <button id="xq_process_reload"
                    class="btn btn-warning xq-btn"
                    onclick="XQFS.Reload()">
                <i class="bi bi-arrow-clockwise"></i> Reload ảnh XQ <b>(F5)</b>
            </button>

            <button id="xq_process_changefolder"
                    class="btn btn-secondary xq-btn"
                    onclick="XQFS.ChangeFolder()">
                <i class="bi bi-folder2-open"></i> Đổi thư mục XQ
            </button>
            <!-- Nhãn hiển thị thư mục đang chọn -->
            <span id="xq_current_folder" class="xq-folder-badge">Chưa chọn thư mục</span>
        </div>
    </div>
    <div class="right">
        <div class="desscription">
            <div class="content">
                <textarea id="xq_process_description" class="form-control textarea-desscription pading-left-5 pading-right-5" placeholder="Mô tả ..."></textarea>
                <script>
                    CKEDITOR.replace('xq_process_description', {
                        customConfig: '@Url.Content("~/lib/ckeditor/config.js")',
                        toolbar: 'Full',
                        extraPlugins: 'image,table,specialchar' // ép nạp plugin nếu cần
                    });
                </script>
            </div>
        </div>
        <div class="result-suggest">
            <div class="result">
                <div class="result-title">Kết luận:</div>
                <textarea id="xq_process_result" class="form-control textarea-result pading-left-5 pading-right-5" placeholder="Kết luận ..."></textarea>
            </div>
            <div class="suggest">
                <div class="suggest-title">Đề nghị:</div>
                <textarea id="xq_process_suggest" class="form-control textarea-suggest pading-left-5 pading-right-5" placeholder="Đề nghị ..."></textarea>
            </div>
        </div>
    </div>
</div>
<script>
    // XQFS.SetSelectors({ textKey: '#xq_text_key' });
    $(function () {
        XQFS.MountFolderLabel('#xq_current_folder');
        // nếu ID input khác, nhớ cấu hình lại:
        XQFS.SetSelectors({ textKey: '#xq_text_key' });
        XQFS.EnableBarcodeAutoReload({
            minLen: 6,      // điều chỉnh theo độ dài mã của bạn
            fastMs: 35,     // 25–45ms là hợp lý tùy scanner
            endGapMs: 120,  // thời gian nghỉ để kết thúc một lần quét
            enableGlobalCapture: true
        });
    });
</script>
