@{
    var _lstUserFunction = ViewData["lstUserFunction"] as List<UserFunction>;
}
<div class="sa-right-service-group-button">
    <button id="sa_returnresult_print" class="btn btn-success btn-blue" onclick="ReturnResult_Print()">
        <i class="bi bi-printer"></i> Print
    </button>
    <button id="sa_returnresult_invalid" class="btn btn-success btn-blue" onclick="ReturnResult_Invalid()">
        <i class="bi bi-arrow-left"></i> Invalid
    </button>
    @{
        foreach (var item in _lstUserFunction)
        {
            if (item.Function.Code == "ValidAndKySoMySign")
            {
                <button id="sa_returnresult_sign_pdf"
                        type="button"
                        class="btn btn-warning btn-md sa_returnresult_print_signed"
                        onclick="ReturnResult_SignPdf_Multi('selected')">
                    <i class="fa fa-signature"></i> Ký số
                </button>
                <button id="sa_returnresult_print_signed"
                        type="button"
                        class="btn btn-primary btn-md sa_returnresult_print_signed"
                        onclick="ReturnResult_ViewSignedPdf()">
                    <i class="fa fa-download"></i> Xem PDF đã ký
                </button>
                <button id="sa_returnresult_invalid_removedigitalsign" class="btn btn-danger btn-md sa_returnresult_invalid_removedigitalsign" onclick="ReturnResult_Invalid_RemoveDigitalSign()">
                    <i class="bi bi-arrow-left"></i> Invalid & Xóa Ký Số
                </button>
            }
        }
    }

    @*<a asp-action="Print" asp-controller="SA_ReturnResult">Test In HTML</a>*@
</div>
<div class="sa-right-service-group-button-title-sample">
    <div class="title-returnresult"> MÔ TẢ KẾT QUẢ </div>
</div>