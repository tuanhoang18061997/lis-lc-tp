@{
    ViewData["Title"] = "Đã xong";
    Layout = "_LayoutSA";   
}

<div class="sa-container">
    <div class="sa-left">
        <div class="sa-left-search">
            @await Html.PartialAsync("_SA_ReturnResult_Search")
        </div>
        <div id="returnresult_listPatient" class="sa-left-list">
            @await Html.PartialAsync("_SA_ReturnResult_ListPatient")
        </div>
    </div>
    <div class="sa-right">
        <div id="returnresult_patientInfo" class="sa-right-info">
            @await Html.PartialAsync("_SA_ReturnResult_PatientInfo")
        </div>
        <div id="returnresult_patientService" class="sa-right-service">
            <div id="returnresult_sa-right-service-group" class="sa-right-service-group">
                @await Html.PartialAsync("_SA_ReturnResult_GroupButton")
            </div>
            <div id="returnresult_sa-right-service-gridview" class="sa-right-service-gridview">
                @await Html.PartialAsync("_SA_ReturnResult_ListService")
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_Loading")