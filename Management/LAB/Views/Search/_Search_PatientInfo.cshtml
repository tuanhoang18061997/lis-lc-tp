@using Management.BL
@{
    var patientInfo = ViewData["patientInfo"] as Patient;
    var lstBenhAnModel = ViewData["lstBenhAnModel"] as List<BenhAnModel>;

    var age = (patientInfo != null && patientInfo.Age != null) ? patientInfo?.Age?.ToString("dd/MM/yyyy") : string.Empty;
    var getSampleTimeNS = (patientInfo != null && patientInfo.GetSampleTimeNS != null) ? patientInfo?.GetSampleTimeNS?.ToString("yyyy-MM-dd HH:mm") : string.Empty;
    var returnResultTimeNS = (patientInfo != null && patientInfo.ReturnResultTimeNS != null) ? patientInfo?.ReturnResultTimeNS : DateTime.Now;
}
<div class="search-right-info-title">THÔNG TIN BỆNH NHÂN</div>
<div class="search-right-info-div-1">
    <div class="search-right-info-div-combo-4">
        <div class="search-right-info-div-combo-4-label-age-object">
            <label>Mã bệnh nhân</label>
        </div>
        <div class="search-right-info-div-combo-4-input">
            <input type="text" id="search_id" hidden value="@patientInfo?.Id" />
            <input type="text" id="search_patientId" value="@patientInfo?.PatientId" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="search-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Mã BA</label>
        </div>
        <div class="search-right-info-div-combo-4-input">
            <input type="text" id="search_maBenhAn" value="@patientInfo?.MaBenhAn" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="search-right-info-div-combo-2 div-margin-top-5">
        <div class="search-right-info-div-combo-2-label">
            <label>Mã bệnh phẩm</label>
        </div>
        <div class="search-right-info-div-combo-2-input">
            <div class="search-right-info-div-combo-2-input02">
                <input type="text" id="search_seq" value="@patientInfo?.Seq" class="form-control height-28 pading-left-5 pading-right-5" disabled />
            </div>
            <div class="search-right-info-div-combo-2-input03">
                <input type="text" id="search_sid" value="@patientInfo?.Sid" class="form-control height-28 pading-left-5 pading-right-5 border-left-none" disabled />
            </div>
        </div>
    </div>
    <div class="search-right-info-div-combo-2 div-margin-top-5">
        <div class="search-right-info-div-combo-2-label">
            <label>Tên bệnh nhân</label>
        </div>
        <div class="search-right-info-div-combo-2-input">
            <input type="text" id="search_patientName" value="@patientInfo?.PatientName" class="form-control height-28 pading-left-5 pading-right-5 " disabled />
        </div>
    </div>
    <div class="search-right-info-div-combo-4 div-margin-top-5">
        <div class="search-right-info-div-combo-4-label-age-object">
            <label>Ngày sinh</label>
        </div>
        <div class="search-right-info-div-combo-4-input">
            <input type="text" id="search_age" value="@age" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="search-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Giới tính</label>
        </div>
        <div class="search-right-info-div-combo-4-input">
            <input type="text" id="search_sex" value="@patientInfo?.Sex" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="search-right-info-div-combo-4 div-margin-top-5">
        <div class="search-right-info-div-combo-4-label-age-object">
            <label>Đối tượng</label>
        </div>
        <div class="search-right-info-div-combo-4-input">
            <input type="text" id="search_obj" value="@patientInfo?.Object.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
        <div class="search-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label> Bệnh án</label>
        </div>
        <div class="search-right-info-div-combo-4-input">
            @{
                if (lstBenhAnModel != null)
                {
                    var benhan = lstBenhAnModel.Where(p => p.Id == patientInfo?.BenhAn).FirstOrDefault();
                    if(benhan != null)
                    {
                            <input type="text" id="search_type" value="@benhan.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                    else
                    {
                            <input type="text" id="search_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                }
                else
                {
                        <input type="text" id="search_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                }
            }
        </div>
    </div>
</div>
<div class="search-right-info-div-3 pading-left-10">
    <div class="search-right-info-div-combo-2">
        <div class="search-right-info-div-combo-2-label01">
            <label>Địa chỉ</label>
        </div>
        <div class="search-right-info-div-combo-2-input01 pading-left-10">
            <textarea id="search_address" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Address</textarea>
        </div>
    </div>
    <div class="search-right-info-div-combo-2 div-margin-top-5">
        <div class="search-right-info-div-combo-2-label01">
            <label>Chẩn đoán</label>
        </div>
        <div class="search-right-info-div-combo-2-input01 pading-left-10">
            <textarea id="search_diagnostic" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Diagnostic</textarea>
        </div>
    </div>
</div>