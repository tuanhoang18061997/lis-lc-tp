@{
    Layout = "_LayoutPortal";
    ViewData["Title"] = "Lỗi";
}

<div class="portal-container">
    <div class="alert alert-danger">
        <h4><i class="fas fa-exclamation-circle"></i> Có lỗi xảy ra</h4>
        <p>@ViewBag.ErrorMessage</p>
        <div class="mt-3">
            <button onclick="history.back()" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Quay lại
            </button>
            <button onclick="window.location.reload()" class="btn btn-outline-primary">
                <i class="fas fa-redo"></i> Thử lại
            </button>
        </div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h5><i class="fas fa-info-circle"></i> Thông tin hỗ trợ</h5>
        </div>
        <div class="card-body">
            <p>Nếu lỗi tiếp tục xảy ra, vui lòng:</p>
            <ul>
                <li>Kiểm tra lại mã bệnh án</li>
                <li>Đảm bảo token còn hiệu lực</li>
                <li>Liên hệ bộ phận IT để được hỗ trợ</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/portal.js"></script>
}