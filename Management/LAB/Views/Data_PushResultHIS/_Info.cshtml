<div class="div-lable-input">
    <div class="div-lable">Từ ngày</div>
    <div class="div-input">
        <input type="date" id="pushresulthis-from" class="form-control height-28" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>
</div>
<div class="div-lable-input">
    <div class="div-lable">Đến ngày</div>
    <div class="div-input">
        <input type="date" id="pushresulthis-to" class="form-control height-28" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>
</div>
<div class="div-lable-input">
    <div class="div-lable">Mã bệnh nhân</div>
    <div class="div-input">
        <input type="text" id="pushresulthis-patientid" class="form-control height-28" value="" />
    </div>
</div>

<div class="div-lable-input">
    <div class="div-lable">Push (0 or 1)</div>
    <div class="div-input">
        <input type="text" id="pushresulthis-push" class="form-control height-28" value="" />
    </div>
</div>