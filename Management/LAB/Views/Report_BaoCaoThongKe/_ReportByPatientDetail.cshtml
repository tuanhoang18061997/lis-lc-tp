@using Management.BL
@model List<ReportPatientDetail>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover table-sm">
        <thead class="table-light sticky-top">
            <tr>
                <th scope="col" style="width: 50px;">STT</th>
                <th scope="col">Mã BN</th>
                <th scope="col">Họ và tên</th>
                <th scope="col">SID</th>
                <th scope="col">Seq</th>
                <th scope="col">Mã bệnh án</th>
                @* <th scope="col">Đối tượng</th> *@
                <th scope="col">Thời gian tiếp nhận</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                var stt = 0;
                foreach (var item in Model)
                {
                    stt++;
                    <tr>
                        <td class="text-center">@stt</td>
                        <td>@item.PatientID</td>
                        <td>@item.PatientName</td>
                        <td>@item.Sid</td>
                        <td>@item.Seq</td>
                        <td>@item.MaBenhAn</td>
@*                         <td>
                            @switch (item.ObjectCode)
                            {
                                case "BHYT":
                                    <span class="badge bg-primary">BHYT</span>
                                    break;
                                case "BHBL":
                                    <span class="badge bg-secondary">BHBL</span>
                                    break;
                                default:
                                    <span class="badge bg-light text-dark">@item.ObjectCode</span>
                                    break;
                            }
                        </td> *@
                        <td>@(item.InsertTime?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model != null && Model.Count > 0)
{
    <div class="mt-3 text-end">
        <strong>Tổng số: @Model.Count ca</strong>
    </div>
}
