@using Management.BL
@{
    var lstReportResult = ViewData["lstReportResult"] as List<TotalReportService>;
    double sumBHYT = 0, sumTP = 0, sumBHYTNT = 0, sumTPNT = 0, sumBHYTNGT = 0, sumTPNGT = 0, sumTP_Out = 0, sumTP_Pakage = 0;
    if (lstReportResult != null && lstReportResult.Count > 0)
    {
        foreach (var item in lstReportResult)
        {
            sumBHYT += item.TotalBHYT;
            sumBHYTNT += item.TotalBHYT_NoiTru;
            sumBHYTNGT += item.TotalBHYT_NgoaiTru;
            sumTP += item.TotalTP;
            sumTP_Pakage += item.TotalTP_Pakage;
            sumTP_Out += item.TotalTP_Out;
            sumTPNT += item.TotalTP_NoiTru;
            sumTPNGT += item.TotalTP_NgoaiTru;
        }
    }
}
