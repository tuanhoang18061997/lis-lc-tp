<div class="table-responsive">
    <table id="table-export-to-excel" class="table table-bordered table-striped table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-total-patient" scope="col">TỔNG SỐ CA</th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-patient">
            @{
                if (lstReportResult != null && lstReportResult.Count > 0)
                {
                    foreach (var item in lstReportResult)
                    {
                        <tr>
                            <td class="td-total-patient">
                                <a href="javascript:void(0)" 
                                   onclick="Report_ViewPatientDetail(@item.Total)" 
                                   class="text-primary fw-bold"
                                   style="cursor: pointer; text-decoration: none;"
                                   title="Click để xem chi tiết">
                                    @item.Total
                                    <span> => Click xem chi tiết</span>
                                </a>

                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td class="text-center text-muted">Không có dữ liệu</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Modal hiển thị chi tiết danh sách bệnh nhân -->
<div class="modal fade" id="modal-patient-detail" tabindex="-1" aria-labelledby="patientDetailLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="patientDetailLabel">Chi tiết danh sách bệnh nhân</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="report-patient-detail">
                <!-- Nội dung chi tiết sẽ được load vào đây -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="Report_ExportPatientDetailToExcel()">
                    <i class="bi bi-file-earmark-excel"></i> Xuất Excel
                </button>
            </div>
        </div>
    </div>
</div>