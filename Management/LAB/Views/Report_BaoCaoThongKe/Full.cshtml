@using Management.BL
@{
    Layout = "_LayoutExport_Report";
    var lstReportResult = ViewData["lstReportResult"] as List<ReportCovid>;
    var time = "";
    if (lstReportResult != null && lstReportResult.Count > 0)
    {
        time = "Từ ngày " + lstReportResult[0].FromDate + " đến ngày " + lstReportResult[0].ToDate;
    }
    var _printTimeString = "Ngày " + DateTime.Now.Day.ToString().PadLeft(2, '0') + " tháng " + DateTime.Now.Month.ToString().PadLeft(2, '0') + " năm " + DateTime.Now.Year;
    var _userReturnResult = (lstReportResult != null && lstReportResult.Count > 0) ? lstReportResult[0].User : string.Empty;
}
@model Hospital
<div class="hospital-covid">
    <div class="hospital-logo">
        <img class="image" src="~/images/logo/logo.png" />
    </div>
    <div class="hospital-info">
        <div class="hospital-info-name">
            @Model.Name.ToUpper()
        </div>
        <div class="hospital-info-address">
            @Model.Address
        </div>
        <div class="hospital-info-phonemail">
            @Model.Phone -  @Model.Email -  @Model.Website
        </div>
        <div class="hospital-info-title">
            <div class="hospital-info-title-text">
                BÁO CÁO CHI TIẾT TEST COVID 19
            </div>
            <div class="hospital-info-title-time">
                @time
            </div>
        </div>
    </div>
</div>
<div class="result-covid">
    <table class="table-result">
        <thead class="thead">
            <tr class="tr-title">
                <th class="th-code" scope="col">Mã</th>
                <th class="th-name" scope="col">Họ Tên</th>
                <th class="th-age" scope="col">Tuổi</th>
                <th class="th-sex" scope="col">GT</th>
                <th class="th-address" scope="col">Địa Chỉ</th>
                <th class="th-result" scope="col">Kết Quả</th>
                <th class="th-time" scope="col">Giờ Trả KQ</th>
            </tr>
        </thead>
        <tbody class="tbody">
            @{
                foreach (var item in lstReportResult)
                {
                    <tr class="tr-content">
                        <td class="td-code">@item.PatientID</td>
                        <td class="td-name">@item.PatientName</td>
                        <td class="td-age">@item.Age?.ToString("dd/MM/yyyy")</td>
                        <td class="td-sex">@item.Sex</td>
                        <td class="td-address">@item.Address</td>
                        <td class="td-result">@item.Result</td>
                        <td class="td-time">@item.ReturnResultTime.ToString("dd/MM/yyyy HH:mm:ss")</td>
                    </tr>
                }
            }
    </table>
</div>
<div class="signature-page-covid">
    <div class="signature">
        <div class="signature-left">
        </div>
        <div class="signature-right">
            <div class="signature-right-time">
                @_printTimeString
            </div>
            <div class="signature-right-title">
                NGƯỜI BÁO CÁO
            </div>
            <div class="signature-right-user">
                @_userReturnResult
            </div>
        </div>
    </div>
    @*<div class="page">
    Trang 1/1
    </div>*@
</div>