@{
    var _lstHospital = ViewData["Hospital"] as List<Hospital>;
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-checkbox" scope="col"></th>
                <th class="th-number" scope="col">Stt</th>
                <th class="th-id" scope="col">Id</th>
                <th class="th-code" scope="col">Mã BV</th>
                <th class="th-name" scope="col">Tên Bệnh Viện</th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-service">
            @if (_lstHospital != null && _lstHospital.Count > 0)
            {
                foreach(var _hospital in _lstHospital)
                {
                    <tr class="row-service" onclick="Hospital_CheckedBoxOnRow('@_hospital?.Code')">
                        <td class="td-checkbox">
                            <input class="form-check-input" type="checkbox" value="@_hospital?.Code" id="flexCheckChecked">
                        </td>
                        <td class="td-number">1</td>
                        <td class="td-id">@_hospital?.Id</td>
                        <td class="td-code">@_hospital?.Code</td>
                        <td class="td-name">@_hospital?.Name</td>
                    </tr>
                }
            }          
        </tbody>
    </table>
</div>
