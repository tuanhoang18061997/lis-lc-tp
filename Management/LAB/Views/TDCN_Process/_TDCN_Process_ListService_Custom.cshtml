@{
    var patientInfos = ViewData["patientInfos"] as Patient;
}
<!-- Modal: Import kết quả ngoài -->
<div class="modal fade" id="modal-import-external" tabindex="-1" role="dialog" aria-labelledby="importExternalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="importExternalLabel">Import kết quả ngoài (PDF)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true ">&times;</span>
                </button>
            </div>

            <div class="modal-body pt-2">
                <form id="form-import-external" onsubmit="return false;">
                    <!-- patientId lấy từ màn hình xử lý -->
                    <input type="hidden" id="import_patientId" />
                    <input type="hidden" id="import_idTablePatient" />
                    <input type="hidden" id="import_patientName" />
                    <input type="hidden" id="import_maBenhAn" />

                    <div class="form-row row">
                        <!-- CỘT TRÁI: các input -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Tệp PDF kết quả (từ cơ sở ngoài):</label>
                                <input type="file"
                                       id="import_pdf_file"
                                       accept="application/pdf"
                                       class="form-control"
                                       onchange="Process_HandlePdfPreview(this)" />
                                <small class="form-text text-muted">
                                    Chỉ nhận PDF. Dung lượng lớn vui lòng chờ sau khi nhấn "Import".
                                </small>
                            </div>
                            <div class="form-group">
                                <label>Tùy chọn:</label>
                                <div class="custom-control custom-checkbox" style="display: none">
                                    <input type="checkbox" checked class="custom-control-input" id="import_overwrite">
                                    <label class="custom-control-label" for="import_overwrite">
                                        Ghi đè giá trị đang có (nếu trùng mã xét nghiệm)
                                    </label>
                                </div>
                                <div class="custom-control custom-checkbox mt-2" style="display: none">
                                    <input type="checkbox" checked class="custom-control-input" id="import_mark_valid">
                                    <label class="custom-control-label" for="import_mark_valid">
                                        Đặt trạng thái <em>Valid</em> cho các chỉ số import
                                    </label>
                                </div>
                                <div class="custom-control custom-switch mt-2">
                                    <input type="checkbox" checked class="custom-control-input" id="import_is_visible_to_user">
                                    <label class="custom-control-label" for="import_is_visible_to_user">
                                        Cho phép hiển thị file này cho người dùng
                                    </label>
                                </div>
                                <small class="form-text text-muted ml-1">
                                    Bật: file sẽ hiển thị trong danh sách cho người dùng. Tắt: chỉ lưu nội bộ trên hệ thống.
                                </small>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: danh sách PDF đã import -->
                        <div class="col-md-8">
                            <label>Các tệp đã import gần đây:</label>
                            <div id="imported_pdf_list"
                                 class="border rounded"
                                 style="height: 180px; overflow:auto; background:#fff;">
                                <div class="text-muted p-2">Chưa tải danh sách…</div>
                            </div>
                            <small class="text-muted">Bấm vào tên tệp để xem trước ở khung dưới.</small>
                        </div>
                    </div>
                    <div class="border rounded p-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Preview PDF</strong>
                            <span class="text-muted small">Hiển thị ngay khi bạn chọn file</span>
                        </div>
                        <div id="pdfPreview" class="w-100" style="height:70vh; background:#f8f9fa; display:flex; align-items:center; justify-content:center; border:1px dashed #ced4da;">
                            <em class="text-muted">Chưa có tệp được chọn…</em>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn_reset_modal_pdf_setting" class="btn btn-success"
                        onclick="Process_ResetExternalImportMode()" style="margin-right: 3rem;">
                    Làm mới
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="Process_ResetExternalImportMode()">Đóng</button>
                <button type="button" id="btn_import_external_pdf" class="btn btn-primary" onclick="Process_SubmitExternalImport()">
                    <i class="fa fa-cloud-upload mr-1"></i> Import
                </button>
                <button type="button" id="btn_save_imported_pdf_setting" class="btn btn-success" onclick="Process_SaveImportedPdfSetting()" style="display:none;">
                    Lưu
                </button>

            </div>
        </div>
    </div>
</div>

<div class="tdcn-process-mode-wrapper">
    <input type="hidden" id="tdcn_process_result_mode" value="normal" />
    <input type="hidden" id="tdcn_upload_pdf_resultCDHAId" />

    <div class="tdcn-process-mode-toolbar">
        <div class="tdcn-mode-title">
            <i class="bi bi-sliders"></i>
            <span>Chế độ nhập kết quả</span>
            <small id="tdcn_mode_context_badge" class="tdcn-mode-context-badge">Chưa chọn dịch vụ</small>
        </div>
        <div class="tdcn-mode-toggle btn-group" role="group" aria-label="Chọn chế độ nhập kết quả TDCN">
            <button type="button"
                    id="tdcn_mode_btn_normal"
                    class="btn btn-sm btn-primary active"
                    onclick="TDCN_Process_SetResultMode('normal')">
                <i class="bi bi-pencil-square"></i> Nhập kết quả
            </button>
            <button type="button"
                    id="tdcn_mode_btn_upload_pdf"
                    class="btn btn-sm btn-outline-primary"
                    onclick="TDCN_Process_SetResultMode('uploadPdf')">
                <i class="bi bi-file-earmark-pdf"></i> Upload PDF
            </button>
        </div>
    </div>

    <div class="tdcn-process-unified-layout">
        <div class="tdcn-process-left-col">
            @await Html.PartialAsync("_TDCN_Process_ListService")

            <div id="tdcn-process-mode-normal-left" class="tdcn-left-mode-panel">
                <div class="tdcn-card tdcn-image-card">
                    <div class="tdcn-card-title tdcn-card-title-between">
                        <div>
                            <i class="bi bi-images"></i>
                            <span>Hình ảnh kết quả</span>
                        </div>
                        <small class="tdcn-muted-text">Dùng cho kết quả nhập tay</small>
                    </div>
                    <div class="contain-hinh tdcn-image-list"></div>
                    <div class="tdcn-image-actions">
                        <label for="fileInput" class="btn btn-outline -primary btn-sm mb-0">
                            <i class="bi bi-upload"></i> Tải hình
                        </label>
                        <input type="file" id="fileInput" name="file" onchange="UploadHinh(this)" title="Tải hình" accept="image/png, image/jpeg" style="display:none;">
                        <button id="tdcn_process_xem" class="btn btn-success btn-sm" onclick="XemHinh()" title="Xem hình">
                            <i class="bi bi-eye"></i> Xem
                        </button>
                        <button id="tdcn_process_delete" class="btn btn-danger btn-sm" onclick="DeleteHinh()" title="Xoá hình">
                            <i class="bi bi-trash"></i> Xóa
                        </button>
                    </div>
                </div>

                @* <div class="tdcn-card tdcn-folder-card">
                    <div class="tdcn-card-title">
                        <i class="bi bi-folder2-open"></i>
                        <span>Thư mục kết quả TDCN</span>
                    </div>
                    <div class="tdcn-folder-body">
                        @if (patientInfos != null)
                        {
                            <input id="tdcn_text_key" class="form-control" placeholder="Nhập Mã Hồ Sơ Khám (ví dụ: BA0000001)" value="@patientInfos.MaBenhAn">
                        }
                        else
                        {
                            <input id="tdcn_text_key" class="form-control" placeholder="Nhập Mã Hồ Sơ Khám (ví dụ: BA0000001)">
                        }
                        <div class="tdcn-folder-actions">
                            <button id="tdcn_process_reload" class="btn btn-warning btn-sm" onclick="ECGFS.Reload()">
                                <i class="bi bi-arrow-clockwise"></i> Reload file TDCN
                            </button>
                            <button id="tdcn_process_changefolder" class="btn btn-secondary btn-sm" onclick="ECGFS.ChangeFolder()">
                                <i class="bi bi-folder2-open"></i> Đổi thư mục
                            </button>
                        </div>
                        <span id="ecg_current_folder" class="ecg-folder-badge tdcn-folder-badge">Chưa chọn thư mục TDCN</span>
                    </div>
                </div> *@
            </div>

            <div id="tdcn-process-mode-upload-left" class="tdcn-left-mode-panel" style="display:none;">
                <div class="tdcn-card tdcn-upload-box-card">
                    <div class="tdcn-card-title">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <span>Upload file PDF kết quả</span>
                    </div>

                    <div id="tdcn_pdf_dropzone" class="tdcn-pdf-dropzone">
                        <div class="tdcn-pdf-dropzone-icon">
                            <i class="bi bi-file-earmark-pdf"></i>
                        </div>
                        <div class="tdcn-pdf-dropzone-title">Kéo thả file PDF vào đây</div>
                        <div class="tdcn-pdf-dropzone-subtitle">hoặc bấm nút bên dưới để chọn file từ máy</div>
                        <label for="tdcn_process_result_pdf" class="btn btn-warning btn-sm tdcn-pdf-choose-btn">
                            <i class="bi bi-folder2-open"></i> Chọn file PDF
                        </label>
                        <input type="file"
                               id="tdcn_process_result_pdf"
                               name="resultPdf"
                               accept="application/pdf"
                               style="display:none"
                               onchange="TDCN_Process_HandleUploadPdfFile(this.files && this.files.length ? this.files[0] : null)" />
                    </div>

                    <div id="tdcn_pdf_file_info" class="tdcn-pdf-file-info" style="display:none;">
                        <div class="tdcn-pdf-file-main">
                            <i class="bi bi-file-earmark-pdf-fill"></i>
                            <div>
                                <div id="tdcn_pdf_file_name" class="tdcn-pdf-file-name"></div>
                                <div id="tdcn_pdf_file_size" class="tdcn-pdf-file-size"></div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-sm" onclick="TDCN_Process_ClearUploadPdf()">
                            <i class="bi bi-x-circle"></i> Bỏ chọn
                        </button>
                    </div>

                    <div class="tdcn-upload-note">
                        <i class="bi bi-info-circle"></i>
                        PDF sẽ được lưu theo từng dịch vụ bằng <b>KeyResultForHis</b>. Một khách làm nhiều dịch vụ thì mỗi dịch vụ một file riêng.
                    </div>
                </div>
            </div>
        </div>

        <div class="tdcn-process-right-col">
            <div id="tdcn-process-mode-normal" class="tdcn-process-mode-panel">
                @await Html.PartialAsync("_TDCN_Process_ListService_Normal")
            </div>

            <div id="tdcn-process-mode-upload-pdf" class="tdcn-process-mode-panel" style="display:none;">
                @await Html.PartialAsync("_TDCN_Process_ListService_UploadPdf")
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" style="max-width: 100%;">
        <div class="modal-content">
            <div class="modal-header d-flex justify-content-between align-items-center">
                <div class="zoom-controls">
                    <button type="button" class="btn btn-outline-secondary" id="zoomOut" title="Thu nhỏ"><i class="bi bi-zoom-out"></i></button>
                    <span id="zoomLevel" class="mx-2">100%</span>
                    <button type="button" class="btn btn-outline-secondary" id="zoomIn" title="Phóng to"><i class="bi bi-zoom-in"></i></button>
                    <button type="button" class="btn btn-outline-secondary" id="resetZoom" title="Đặt lại"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center" style="overflow: hidden;">
                <img id="modalImage" src="" style="display: block; margin: auto;">
            </div>
        </div>
    </div>
</div>

<style>
    .tdcn-process-mode-wrapper {
        width: 100%;
    }

    .tdcn-process-mode-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 6px 8px;
        margin-bottom: 6px;
        background: #f4f7fb;
        border: 1px solid #d7dde5;
        border-radius: 4px;
    }

    .tdcn-mode-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-weight: 700;
        color: #1f2937;
        font-size: 13px;
        text-transform: uppercase;
    }

    .tdcn-mode-context-badge {
        padding: 2px 8px;
        border-radius: 999px;
        background: #e5e7eb;
        color: #374151;
        font-size: 11px;
        text-transform: none;
    }

    .tdcn-mode-toggle .btn {
        min-width: 128px;
        font-weight: 600;
    }

    .tdcn-process-unified-layout {
        display: grid;
        grid-template-columns: 390px minmax(0, 1fr);
        gap: 8px;
        min-height: 560px;
    }

    .tdcn-process-left-col, .tdcn-process-right-col {
        min-width: 0;
    }

    .tdcn-card {
        background: #fff;
        border: 1px solid #d7dde5;
        border-radius: 4px;
        margin-bottom: 8px;
        overflow: hidden;
    }

    .tdcn-card-title {
        min-height: 32px;
        padding: 6px 8px;
        display: flex;
        align-items: center;
        gap: 6px;
        background: #e9eef3;
        font-weight: 700;
        text-transform: uppercase;
        font-size: 13px;
        color: #111827;
    }

    .tdcn-card-title-between {
        justify-content: space-between;
    }

        .tdcn-card-title-between > div {
            display: flex;
            align-items: center;
            gap: 6px;
        }

    .tdcn-muted-text {
        color: #6b7280;
        font-weight: 500;
        text-transform: none;
    }

    .tdcn-service-table-wrap {
        max-height: 260px;
        overflow: auto;
    }

    .tdcn-service-table {
        margin-bottom: 0;
        font-size: 13px;
    }

        .tdcn-service-table th, .tdcn-service-table td {
            padding: 5px 7px;
            vertical-align: middle;
        }

    .tdcn-shared-service-row {
        cursor: pointer;
    }

        .tdcn-shared-service-row.active {
            background: #dbeafe !important;
        }

    .service-info {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .serviceName {
        font-weight: 700;
        color: #111827;
    }

    .serviceId {
        color: #6b7280;
        font-size: 12px;
    }

    .tdcn-service-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 4px;
        margin-top: 4px;
        margin-bottom: 4px;
    }

    .tdcn-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        padding: 1px 6px;
        border-radius: 999px;
        font-size: 11px;
    }

    .tdcn-status-signed {
        color: #047857;
        background: #ecfdf5;
    }

    .tdcn-status-normal {
        color: #0369a1;
        background: #e0f2fe;
    }

    .tdcn-status-pdf {
        color: #b91c1c;
        background: #fee2e2;
    }

    .tdcn-image-list {
        min-height: 110px;
        max-height: 180px;
        overflow: auto;
        padding: 8px;
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        background: #f8fafc;
    }

    .contain-hinh .hinh img {
        width: 82px;
        height: 82px;
        object-fit: cover;
        border: 1px solid #d1d5db;
        border-radius: 4px;
        cursor: pointer;
    }

        .contain-hinh .hinh img.selected {
            outline: 3px solid #2563eb;
        }

    .tdcn-image-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px;
        border-top: 1px solid #e5e7eb;
    }

    .tdcn-folder-body {
        padding: 8px;
    }

    .tdcn-folder-actions {
        display: flex;
        gap: 6px;
        margin-top: 6px;
    }

    .tdcn-folder-badge {
        display: block;
        margin-top: 6px;
    }

    .tdcn-normal-editor-body {
        padding: 8px;
    }

    .tdcn-editor-block {
        margin-bottom: 8px;
    }

    .tdcn-field-title {
        font-weight: 700;
        margin-bottom: 4px;
        color: #111827;
    }

    .tdcn-result-suggest-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
    }

    .tdcn-description-block {
        min-height: 330px;
    }

    #cke_tdcn_process_description {
        min-height: 320px;
    }

    #tdcn_process_result, #tdcn_process_suggest {
        min-height: 140px;
        resize: vertical;
    }

    .tdcn-preview-card {
        height: 560px;
        display: flex;
        flex-direction: column;
    }

    .tdcn-pdf-preview-empty {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: #6b7280;
        background: #f8fafc;
        border: 1px dashed #d1d5db;
        margin: 8px;
        border-radius: 6px;
    }

        .tdcn-pdf-preview-empty i {
            font-size: 46px;
            color: #dc2626;
            margin-bottom: 8px;
        }

    .tdcn-pdf-dropzone {
        margin: 8px;
        padding: 18px 12px;
        min-height: 190px;
        border: 2px dashed #c7cdd5;
        background: #f8fafc;
        border-radius: 6px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        transition: .15s ease-in-out;
    }

        .tdcn-pdf-dropzone.dragover {
            border-color: #0d6efd;
            background: #eff6ff;
        }

    .tdcn-pdf-dropzone-icon {
        font-size: 42px;
        line-height: 1;
        color: #dc2626;
        margin-bottom: 8px;
    }

    .tdcn-pdf-dropzone-title {
        font-weight: 700;
        color: #111827;
    }

    .tdcn-pdf-dropzone-subtitle {
        color: #6b7280;
        font-size: 12px;
        margin: 3px 0 10px;
    }

    .tdcn-pdf-file-info {
        margin: 0 8px 8px;
        padding: 8px;
        border: 1px solid #d7dde5;
        background: #fff;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

    .tdcn-pdf-file-main {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

        .tdcn-pdf-file-main i {
            font-size: 24px;
            color: #dc2626;
        }

    .tdcn-pdf-file-name {
        max-width: 210px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
        font-weight: 700;
        color: #111827;
    }

    .tdcn-pdf-file-size {
        font-size: 12px;
        color: #6b7280;
    }

    .tdcn-upload-note {
        margin: 0 8px 8px;
        padding: 8px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 4px;
        color: #9a3412;
        font-size: 12px;
    }

    @@media (max-width: 992px) {
        .tdcn-process-unified-layout {
            grid-template-columns: 1fr;
        }

        .tdcn-result-suggest-grid {
            grid-template-columns: 1fr;
        }

        .tdcn-preview-card {
            height: 520px;
        }
    }

    @@media (max-width: 768px) {
        .tdcn-process-mode-toolbar {
            align-items: stretch;
            flex-direction: column;
        }

        .tdcn-mode-toggle {
            width: 100%;
        }

            .tdcn-mode-toggle .btn {
                flex: 1;
                min-width: unset;
            }
    }
</style>

<script>
    window.TDCN_PROCESS_RESULT_MODE = 'normal';

    function TDCN_Process_SetResultMode(mode) {
        mode = mode === 'uploadPdf' ? 'uploadPdf' : 'normal';
        window.TDCN_PROCESS_RESULT_MODE = mode;
        $('#tdcn_process_result_mode').val(mode);

        if (mode === 'uploadPdf') {
            $('#tdcn-process-mode-normal, #tdcn-process-mode-normal-left').hide();
            $('#tdcn-process-mode-upload-pdf, #tdcn-process-mode-upload-left').show();
            $('#tdcn_mode_btn_normal').removeClass('btn-primary active').addClass('btn-outline-primary');
            $('#tdcn_mode_btn_upload_pdf').removeClass('btn-outline-primary').addClass('btn-primary active');
            $('#tdcn_mode_context_badge').text('Upload PDF theo dịch vụ');
            $('#tdcn_service_mode_hint').text('Dịch vụ PDF đang được chọn');
        } else {
            $('#tdcn-process-mode-upload-pdf, #tdcn-process-mode-upload-left').hide();
            $('#tdcn-process-mode-normal, #tdcn-process-mode-normal-left').show();
            $('#tdcn_mode_btn_upload_pdf').removeClass('btn-primary active').addClass('btn-outline-primary');
            $('#tdcn_mode_btn_normal').removeClass('btn-outline-primary').addClass('btn-primary active');
            $('#tdcn_mode_context_badge').text('Nhập mô tả/kết luận');
            $('#tdcn_service_mode_hint').text('Dịch vụ nhập tay đang được chọn');
        }
    }

    $(function () {
        TDCN_Process_SetResultMode('normal');
        if (window.ECGFS) {
            ECGFS.MountFolderLabel('#ecg_current_folder');
            ECGFS.SetSelectors({ textKey: '#tdcn_text_key' });
            ECGFS.EnableBarcodeAutoReload({
                minLen: 6,
                fastMs: 35,
                endGapMs: 120,
                enableGlobalCapture: true
            });
        }
    });
</script>
