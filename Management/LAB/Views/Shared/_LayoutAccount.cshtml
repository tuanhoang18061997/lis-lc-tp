<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/xn.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
</head>
<body class="account">
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/helpers/password-validation.js"></script>
    @* <script src="~/js/xn.js" asp-append-version="true"></script> *@
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        // Khi load trang Login sau khi logout => xóa toàn bộ localStorage
        window.addEventListener("load", function () {
            try {
                localStorage.clear();
                console.log("LocalStorage cleared on logout");
            } catch (e) { console.warn("Cannot clear localStorage:", e); }
        });
    </script>
</body>
</html>
