@using Management.BL
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/settup.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/global-loading.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.5.0/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<style>
    .nav-link.active {
        background-color: #c0c0c0 !important;
        color: #000000 !important;
        font-weight: bold;
    }

    .loading-text-container {
        text-align: center;
        margin-top: 20px;
        padding: 0 20px;
    }

    .loading-text {
        color: white;
        font-size: 14px;
        margin: 0;
        font-weight: 700;
    }

    #showWaitting.modal {
        opacity: 1 !important;
        background-color: rgba(0, 0, 0, 0.6) !important;
    }
</style>
<body class="main-bg">
    <header>
        <div class="menu">
            <div class="menu-left">
                <nav class="navbar navbar-expand-lg navbar-dark bg-dark menu-left-height">
                    <div class="container-fluid">
                        <a class="navbar-brand menu-left-color" asp-controller="Main" asp-action="Index">
                            <i class="bi bi-house-door"></i>
                            <span>Cấu hình</span>
                        </a>
                        <a class="navbar-brand menu-left-color" asp-controller="Main" asp-action="Index">
                            <i class="bi bi-house-door"></i>
                        </a>
                    </div>
                </nav>
            </div>
            <div class="menu-right">
                <div class="dropdown menu-right-width menu-right-margin-padding">
                    <button class="btn btn-secondary dropdown-toggle menu-right-width menu-right-bg" type="button" id="dropdownMenuButton2" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person"></i>
                        @{
                            var userName = HttpContextAccessor.HttpContext?.User?.Claims?.FirstOrDefault(p => p.Type == "UserName")?.Value;
                            @userName;
                        }
                    </button>
                    <ul class="dropdown-menu menu-right-width menu-right-height-64" aria-labelledby="dropdownMenuButton2">
                        <li>
                            <a class="dropdown-item menu-right-width menu-right-height-20" asp-controller="Account" asp-action="ChangePassword">
                                <i class="bi bi-key"></i> Đổi mật khẩu
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item menu-right-width menu-right-height-20" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-left"></i> Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3 renderBody">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/settup.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/swal-helper.js"></script>
    <script src="~/js/global-loading.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Html.PartialAsync("_GlobalLoading")
</body>
</html>
