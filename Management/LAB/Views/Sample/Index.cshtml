@{
    ViewData["Title"] = "Quản lý mẫu kết quả";
    Layout = "_LayoutSettupDetail";
    var sample = ViewData["Sample"] as Sample;
}

<div class="settup-container">
    <div class="settup-left-sample">
        <div class="settup-left-title-search">
            <div class="title">
                DANH SÁCH MẪU KẾT QUẢ
            </div>
            <div class="search">
                <input type="text" id="sample-search" class="form-control height-28" onkeyup="Sample_Search(this.value)" placeholder="Nhập tên cần tìm kiếm ..." />
            </div>
        </div>
        <div id="sample-settup-left-list" class="settup-left-list">
            @await Html.PartialAsync("_Sample_List")
        </div>
    </div>
    <div class="settup-right-sample">
        <div class="settup-right-title">
            THÔNG TIN MẪU KẾT QUẢ
        </div>
        <div id="sample-settup-right-info" class="settup-right-info">
            @await Html.PartialAsync("_Sample_Info")
        </div>
        <div id="sample-settup-right-button" class="settup-right-button">
            <button id="sample-new" class="btn btn-success btn-blue" onclick="Sample_New()">
                <i class="bi bi-person-plus"></i> Mới
            </button>
            <button id="sample-save" class="btn btn-success btn-blue" onclick="Sample_Save()">
                <i class="bi bi-download"></i> Lưu
            </button>
            <button id="sample-delete" class="btn btn-success btn-blue" onclick="Sample_Delete()">
                <i class="bi bi-person-x"></i> Xoá
            </button>
            <button id="sample-cancel" class="btn btn-success btn-blue" onclick="Sample_Cancel()">
                <i class="bi bi-arrow-return-left"></i> Bỏ qua
            </button>
        </div>
    </div>
</div>