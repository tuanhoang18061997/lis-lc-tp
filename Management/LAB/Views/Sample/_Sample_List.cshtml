@{
    var lstSample = ViewData["lstSample"] as List<Sample>;
    var lstService = ViewData["lstService"] as List<Service>;
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th rowspan="2" class="th-checkbox"></th>
                <th rowspan="2" class="th-number">Stt</th>
                <th rowspan="2" class="th-id">Id</th>
                <th rowspan="2" class="th-code">Mã</th>
                <th rowspan="2" class="th-name">Tên</th>
                <th rowspan="2" class="th-gender">Giới tính</th>
                <th colspan="2" class="text-center">Dịch vụ liên kết</th>
                <th rowspan="2" class="th-active">Active</th>
            </tr>
            <tr class="tr-subtitle">
                <th class="th-serviceid">ServiceId</th>
                <th class="th-servicename">Tên dịch vụ</th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-service">
            @{
                if (lstSample != null && lstSample.Count > 0)
                {
                    var index = 0;
                    foreach (var item in lstSample)
                    {
                        index++;
                        <tr class="row-service" onclick="Sample_CheckedBoxOnRow('@item.Code')">
                            <td class="td-checkbox">
                                <input class="form-check-input" type="checkbox" value="@item.Code" id="flexCheckChecked">
                            </td>
                            <td class="td-number">@index</td>
                            <td class="td-id">@item.Id</td>
                            <td class="td-code">@item.Code</td>
                            <td class="td-name">@item.Name</td>
                            <td class="td-gender">
                            @(
                                string.IsNullOrEmpty(item.Gender)
                                ? ""
                                : (item.Gender == "M" ? "Nam" :
                                item.Gender == "F" ? "Nữ" : "Nam & Nữ")
                            )
                            </td>
                            <td>@item.ServiceId</td>
                            <td>
                                @{
                                    var serviceName = "";
                                    if (lstService != null && item.ServiceId != null)
                                    {
                                        var service = lstService.FirstOrDefault(s => s.Id == item.ServiceId);
                                        if (service != null)
                                        {
                                            serviceName = service.Name;
                                        }
                                    }
                                }
                                @serviceName
                            </td>
                            <td>@(item.Active ? "✔" : "✖")</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
