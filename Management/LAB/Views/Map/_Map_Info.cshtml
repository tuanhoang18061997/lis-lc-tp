@{
    var lstMap = ViewData["lstMap"] as List<Map>;
}

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-checkbox" scope="col"></th>
                <th class="th-testcode" scope="col">Mã XN</th>
                <th class="th-testcodein" scope="col">Mã máy 1</th>
                <th class="th-testcodein2" scope="col">Mã máy 2</th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-map">
            @{
                if (lstMap != null && lstMap.Count > 0)
                {
                    var index = 0;
                    foreach (var item in lstMap)
                    {
                        index++;
                        <tr class="row-map-testcode" onclick="Map_TestCode_CheckedBoxOnRow('@item?.Id')">
                            <td class="td-checkbox">
                                <input class="form-check-input" type="checkbox" value="@item?.Id" id="flexCheckChecked">
                            </td>
                            <td class="td-testcode">@item?.TestCode?.Name</td>
                            <td class="td-testcodein">@item?.TestcodeIn</td>
                            <td class="td-testcodein2">@item?.TestcodeIn2</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
