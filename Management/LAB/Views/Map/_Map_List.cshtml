@{
    var lstDevice = ViewData["lstDevice"] as List<Device>;
}

<div class="table-responsive">
    <table class="table table-bordered table-striped table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-checkbox" scope="col"></th>
                <th class="th-id" scope="col">Id</th>
                <th class="th-code" scope="col">Mã</th>
                <th class="th-name" scope="col">Tên</th> 
            </tr>
        </thead>
        <tbody id="tbody-gridview-device">
            @{
                if (lstDevice != null && lstDevice.Count > 0)
                {
                    var index = 0;
                    foreach (var item in lstDevice)
                    {
                        index++;
                        <tr class="row-map-device" onclick="Map_Device_CheckedBoxOnRow('@item?.Id')">
                            <td class="td-checkbox">
                                <input class="form-check-input" type="checkbox" value="@item?.Id" id="flexCheckChecked">
                            </td>
                            <td class="td-id">@item?.Id</td>
                            <td class="td-code">@item?.Code</td>
                            <td class="td-name">@item?.Name</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
