@using Management.BL
@{
    var patientInfo = ViewData["patientInfo"] as Patient;
    var lstUser = ViewData["lstUser"] as List<User>;
    var lstBenhAnModel = ViewData["lstBenhAnModel"] as List<BenhAnModel>;
    var userLoginId = ViewData["userLoginId"] as long?;

    var age = (patientInfo != null && patientInfo.Age != null) ? patientInfo?.Age?.ToString("dd/MM/yyyy") : string.Empty;
    var getSampleTimeNS = (patientInfo != null && patientInfo.GetSampleTimeNS != null) ? patientInfo?.GetSampleTimeNS?.ToString("dd/MM/yyy HH:mm") : string.Empty;
    var returnResultTimeNS = (patientInfo != null && patientInfo.ReturnResultTimeNS != null) ? patientInfo?.ReturnResultTimeNS : DateTime.Now;
}
<div class="ns-right-info-title">THÔNG TIN BỆNH NHÂN</div>
<div class="ns-right-info-div-1">
    <div class="ns-right-info-div-combo-4">
        <div class="ns-right-info-div-combo-4-label-age-object">
            <label>Mã bệnh nhân</label>
        </div>
        <div class="ns-right-info-div-combo-4-input">
            <input type="text" id="ns_process_id" hidden value="@patientInfo?.Id" />
            <input type="text" id="ns_process_patientId" value="@patientInfo?.PatientId" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="ns-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Mã BA</label>
        </div>
        <div class="ns-right-info-div-combo-4-input">
            <input type="text" id="ns_process_maBenhAn" value="@patientInfo?.MaBenhAn" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>Mã bệnh phẩm</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <div class="ns-right-info-div-combo-2-input-input1">
                <input type="text" id="ns_process_seq" value="@patientInfo?.Seq" class="form-control height-28 pading-left-5 pading-right-5" disabled />
            </div>
            <div class="ns-right-info-div-combo-2-input-input2">
                <input type="text" id="ns_process_sid" value="@patientInfo?.Sid" class="form-control height-28 pading-left-5 pading-right-5 border-left-none" disabled />
            </div>
        </div>
    </div>
    <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>Tên bệnh nhân</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input type="text" id="ns_process_patientName" value="@patientInfo?.PatientName" class="form-control height-28 pading-left-5 pading-right-5 " disabled />
        </div>
    </div>
    <div class="ns-right-info-div-combo-4 div-margin-top-5">
        <div class="ns-right-info-div-combo-4-label-age-object">
            <label>Ngày sinh</label>
        </div>
        <div class="ns-right-info-div-combo-4-input">
            <input type="text" id="ns_process_age" value="@age" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="ns-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Giới tính</label>
        </div>
        <div class="ns-right-info-div-combo-4-input">
            <input type="text" id="ns_process_sex" value="@patientInfo?.Sex" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="ns-right-info-div-combo-4 div-margin-top-5">
        <div class="ns-right-info-div-combo-4-label-age-object">
            <label>Đối tượng</label>
        </div>
        <div class="ns-right-info-div-combo-4-input">
            <input type="text" id="ns_process_obj" value="@patientInfo?.Object.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
        <div class="ns-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label> Bệnh án</label>
        </div>
        <div class="ns-right-info-div-combo-4-input">
            @{
                if (lstBenhAnModel != null)
                {
                    var benhan = lstBenhAnModel.Where(p => p.Id == patientInfo?.BenhAn).FirstOrDefault();
                    if(benhan != null)
                    {
                            <input type="text" id="ns_process_type" value="@benhan.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                    else
                    {
                            <input type="text" id="ns_process_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                }
                else
                {
                        <input type="text" id="ns_process_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                }
            }
        </div>
    </div>
</div>
<div class="ns-right-info-div-2 pading-left-10">
    <div class="ns-right-info-div-combo-2">
        <div class="ns-right-info-div-combo-2-label">
            <label>Nơi chỉ định</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input type="text" id="ns_process_location" value="@patientInfo?.Location?.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
@*     <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>BS chỉ định</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input type="text" id="ns_process_doctor" value="@patientInfo?.Doctor?.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div> *@
    <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>Giờ thực hiện</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input type="text" id="ns_process_getSampleTime" value="@getSampleTimeNS" class="form-control height-28 pading-left-5" disabled />
        </div>
    </div>
    <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>Giờ trả KQ</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input type="datetime-local" id="ns_process_returnResultTime" value="@returnResultTimeNS?.ToString("yyyy-MM-dd HH:mm")" class="form-control height-28 pading-left-5 valid" onchange="Process_HideButton(true, false, true, false, true, true)" data-toggle="tooltip" title="Giờ trả kết quả là bắt buộc" data-placement="top" />
        </div>
    </div>
     <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>BS thực hiện</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input type="hidden" id="ns_process_userLoginId" value="@ViewData["userLoginId"]" />
            <select id="ns_process_userReturnResultNS" name="userReturnResultNS" class="form-select height-28 valid" data-toggle="tooltip" title="Người trả kết quả là bắt buộc" data-placement="top">
                @if (lstUser != null)
                {
                    var isUserReturnResultNS = false;
                    foreach (var item in lstUser)
                    {
                        if (item.Id == patientInfo?.UserReturnResultNS)
                        {
                            <option selected value="@item.Id">@item.Name</option>
                            isUserReturnResultNS = true;
                        }
                        else
                        {
                            if (isUserReturnResultNS == false && userLoginId != null && userLoginId == item.Id)
                            {
                                <option selected value="@item.Id">@item.Name</option>
                            }
                            else
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    }
                }
            </select>
        </div>
    </div>
    <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>CCCD</label>
        </div>
        <div class="ns-right-info-div-combo-2-input">
            <input id="ns_process_signerCCCD" class="form-control height-28 pading-left-5 valid" />
        </div>
    </div>
</div>
<div class="ns-right-info-div-3 pading-left-10">
    <div class="ns-right-info-div-combo-2">
        <div class="ns-right-info-div-combo-2-label">
            <label>Địa chỉ</label>
        </div>
        <div class="ns-right-info-div-combo-2-input pading-left-10">
            <textarea id="ns_process_address" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Address</textarea>
        </div>
    </div>
    <div class="ns-right-info-div-combo-2 div-margin-top-5">
        <div class="ns-right-info-div-combo-2-label">
            <label>Chẩn đoán</label>
        </div>
        <div class="ns-right-info-div-combo-2-input pading-left-10">
            <textarea id="ns_process_diagnostic" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Diagnostic</textarea>
        </div>
    </div>
</div>