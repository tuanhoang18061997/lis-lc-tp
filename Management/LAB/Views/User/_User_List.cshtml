@{
    var lstUser = ViewData["lstUser"] as List<User>;
}

<div class="table-responsive">
    <table class="table table-bordered table-hover">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-checkbox" scope="col"></th>
                @* <th class="th-number" scope="col">Stt</th> *@
                <th class="th-id" scope="col">Id</th>
                <th class="th-code" scope="col">Mã</th>
                <th class="th-name" scope="col">Tên</th>
                @* <th class="th-code" scope="col">Mã BHYT</th> *@
                <th class="th-cks" scope="col">Cks SignMark</th>
                <th class="th-cccd" scope="col">Cccd</th>
                <th class="th-his" scope="col">Mã HIS</th>
                <th class="th-active" scope="col">Active</th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-service">
            @{
                if (lstUser != null && lstUser.Count > 0)
                {
                    var index = 0;
                    foreach (var item in lstUser)
                    {
                        index++;
                        <tr class="row-service" onclick="User_CheckedBoxOnRow('@item.Code')">
                            <td class="td-checkbox">
                                <input class="form-check-input" type="checkbox" value="@item.Code" id="flexCheckChecked">
                            </td>
                            @* <td class="td-number">@index</td>*@
                            <td class="td-id">@item.Id</td>
                            <td class="td-code">@item.Code</td>
                            <td class="td-name">@item.Name</td>
                            @* <td class="td-code">@item.MaBHYT</td>*@
                            <td class="td-cks">@item.Cks</td>
                            <td class="td-cccd">@item.Cccd</td>
                            <td class="td-his">@item.HisEmployeeId</td>
                            <td class="td-active">@item.Active</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>