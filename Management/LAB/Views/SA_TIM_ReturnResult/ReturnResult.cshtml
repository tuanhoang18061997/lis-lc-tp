@{
    ViewData["Title"] = "Đã xong";
    Layout = "_LayoutSAT";   
}

<div class="sat-container">
    <div class="sat-left">
        <div class="sat-left-search">
            @await Html.PartialAsync("_SA_TIM_ReturnResult_Search")
        </div>
        <div id="returnresult_listPatient" class="sat-left-list">
            @await Html.PartialAsync("_SA_TIM_ReturnResult_ListPatient")
        </div>
    </div>
    <div class="sat-right">
        <div id="returnresult_patientInfo" class="sat-right-info">
            @await Html.PartialAsync("_SA_TIM_ReturnResult_PatientInfo")
        </div>
        <div id="returnresult_patientService" class="sat-right-service">
            <div id="returnresult_sat-right-service-group" class="sat-right-service-group">
                @await Html.PartialAsync("_SA_TIM_ReturnResult_GroupButton")
            </div>
            <div id="returnresult_sat-right-service-gridview" class="sat-right-service-gridview">
                @await Html.PartialAsync("_SA_TIM_ReturnResult_ListService")
            </div>
        </div>
    </div>
</div>
@await Html.PartialAsync("_Loading")