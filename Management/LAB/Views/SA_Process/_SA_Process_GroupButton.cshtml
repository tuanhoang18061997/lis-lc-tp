@{
    var lstSampleResult = ViewData["lstSampleResult"] as List<Sample>;
    var _lstUserFunction = ViewData["lstUserFunction"] as List<UserFunction>;
}

<div class="sa-right-service-group-button">
    <button id="sa_process_saveresult" class="btn btn-success btn-blue" onclick="Process_SaveResult()">
        <i class="bi bi-download"></i> Lưu
    </button>
    <button id="sa_process_cancelresult" class="btn btn-success btn-blue" onclick="Process_CancelResultt()">
        <i class="bi bi-arrow-return-left"></i> Bỏ qua
    </button>
    <button id="sa_process_valid_in" class="btn btn-success btn-blue" onclick="Process_ValidPrint('selected')">
        <i class="bi bi-printer"></i> Valid & In
    </button>
    <button id="sa_process_getsample" class="btn btn-success btn-blue" onclick="Process_GetSample()">
        <i class="bi bi-arrow-left"></i> Đang chờ
    </button>
    @{
        foreach (var item in _lstUserFunction)
        {
            if (item.Function.Code == "ValidAndKySoMySign")
            {
                <button id="sa_process_signpdf"
                        type="button"
                        class="btn btn-warning btn-md sa_process_signpdf"
                        onclick="Process_SignPdf_Multi('selected')">
                    <i class="fa fa-certificate"></i> In & Ký số
                </button>
            }
        }
    }

</div>
<div class="sa-right-service-group-button-title-sample"> 
    <div class="title-process">
        MÔ TẢ
    </div>
    <div class="sample">
        <select id="sa_process_sampleresult" name="sa_process_sampleresult" class="form-select height-28" onchange="GetSampleForService(this.value)">
            @if (lstSampleResult != null)
            {
                foreach (var item in lstSampleResult)
                {
                    <option value="@item.Id" data-serviceid="@item.ServiceId" data-gender="@item.Gender">@item.Name</option>
                }
            }
        </select>
    </div>   
</div>