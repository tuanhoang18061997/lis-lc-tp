@using Management.BL
@{
    var patientInfo = ViewData["patientInfo"] as Patient;
    var lstBenhAnModel = ViewData["lstBenhAnModel"] as List<BenhAnModel>;

    var age = (patientInfo != null && patientInfo.Age != null) ? patientInfo?.Age?.ToString("dd/MM/yyyy") : string.Empty;
    var getSampleTimeDDT = (patientInfo != null && patientInfo.GetSampleTimeDDT != null) ? patientInfo?.GetSampleTimeDDT?.ToString("dd/MM/yyy HH:mm") : string.Empty;
    var returnResultTimeDDT = (patientInfo != null && patientInfo.ReturnResultTimeDDT != null) ? patientInfo?.ReturnResultTimeDDT?.ToString("dd/MM/yyy HH:mm") : string.Empty;
}
<div class="ddt-right-info-title">THÔNG TIN BỆNH NHÂN</div>
<div class="ddt-right-info-div-1">
    <div class="ddt-right-info-div-combo-4">
        <div class="ddt-right-info-div-combo-4-label-age-object">
            <label>Mã bệnh nhân</label>
        </div>
        <div class="ddt-right-info-div-combo-4-input">
            <input type="text" id="ddt_returnresult_id" hidden value="@patientInfo?.Id" />
            <input type="text" id="ddt_returnresult_patientId" value="@patientInfo?.PatientId" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="ddt-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Mã BA</label>
        </div>
        <div class="ddt-right-info-div-combo-4-input">
            <input type="text" id="ddt_returnresult_maBenhAn" value="@patientInfo?.MaBenhAn" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Mã bệnh phẩm</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <div class="ddt-right-info-div-combo-2-input-input1">
                <input type="text" id="ddt_returnresult_seq" value="@patientInfo?.Seq" class="form-control height-28 pading-left-5 pading-right-5" disabled />
            </div>
            <div class="ddt-right-info-div-combo-2-input-input2">
                <input type="text" id="ddt_returnresult_sid" value="@patientInfo?.Sid" class="form-control height-28 pading-left-5 pading-right-5 border-left-none" disabled />
            </div>
        </div>
    </div>
    <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Tên bệnh nhân</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input type="text" id="ddt_returnresult_patientName" value="@patientInfo?.PatientName" class="form-control height-28 pading-left-5 pading-right-5 " disabled />
        </div>
    </div>
    <div class="ddt-right-info-div-combo-4 div-margin-top-5">
        <div class="ddt-right-info-div-combo-4-label-age-object">
            <label>Ngày sinh</label>
        </div>
        <div class="ddt-right-info-div-combo-4-input">
            <input type="text" id="ddt_returnresult_age" value="@age" class="form-control height-28 pading-left-5 " disabled />
        </div>
        <div class="ddt-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label>Giới tính</label>
        </div>
        <div class="ddt-right-info-div-combo-4-input">
            <input type="text" id="ddt_returnresult_sex" value="@patientInfo?.Sex" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="ddt-right-info-div-combo-4 div-margin-top-5">
        <div class="ddt-right-info-div-combo-4-label-age-object">
            <label>Đối tượng</label>
        </div>
        <div class="ddt-right-info-div-combo-4-input">
            <input type="text" id="ddt_returnresult_obj" value="@patientInfo?.Object.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
        <div class="ddt-right-info-div-combo-4-label-sex-benhan pading-left-5">
            <label> Bệnh án</label>
        </div>
        <div class="ddt-right-info-div-combo-4-input">
            @{
                if (lstBenhAnModel != null)
                {
                    var benhan = lstBenhAnModel.Where(p => p.Id == patientInfo?.BenhAn).FirstOrDefault();
                    if(benhan != null)
                    {
                            <input type="text" id="ddt_returnresult_type" value="@benhan.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                    else
                    {
                            <input type="text" id="ddt_returnresult_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                    }
                }
                else
                {
                        <input type="text" id="ddt_returnresult_type" value="" class="form-control height-28 pading-left-5 pading-right-5" disabled />
                }
            }
        </div>
    </div>
</div>
<div class="ddt-right-info-div-2 pading-left-10">
    <div class="ddt-right-info-div-combo-2">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Nơi chỉ định</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input type="text" id="ddt_returnresult_location" value="@patientInfo?.Location?.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
@*     <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>BS chỉ định</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input type="text" id="ddt_returnresult_doctor" value="@patientInfo?.Doctor?.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div> *@
    <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Giờ thực hiện</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input type="text" id="ddt_returnresult_getSampleTime" value="@getSampleTimeDDT" class="form-control height-28 pading-left-5" disabled />
        </div>
    </div>
    <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Giờ trả KQ</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input type="text" id="ddt_returnresult_returnResultTime" value="@returnResultTimeDDT" class="form-control height-28 pading-left-5" disabled />
        </div>
    </div>
     <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>BS trả KQ</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input type="hidden" id="ddt_returnresult_userLoginId" value="@patientInfo?.UserReturnResultDDT" />
            <input type="text" id="ddt_returnresult_userReturnResultDDT" value="@patientInfo?.UserDDT?.Name" class="form-control height-28 pading-left-5 pading-right-5" disabled />
        </div>
    </div>
    <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>CCCD</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input">
            <input id="ddt_returnresult_signerCCCD" class="form-control height-28 pading-left-5 valid" />
        </div>
    </div>
</div>
<div class="ddt-right-info-div-3 pading-left-10">
    <div class="ddt-right-info-div-combo-2">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Địa chỉ</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input pading-left-10">
            <textarea id="ddt_returnresult_address" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Address</textarea>
        </div>
    </div>
    <div class="ddt-right-info-div-combo-2 div-margin-top-5">
        <div class="ddt-right-info-div-combo-2-label">
            <label>Chẩn đoán</label>
        </div>
        <div class="ddt-right-info-div-combo-2-input pading-left-10">
            <textarea id="ddt_returnresult_diagnostic" class="form-control height-30 pading-left-5 pading-right-5" disabled>@patientInfo?.Diagnostic</textarea>
        </div>
    </div>
</div>