@using Management.BL
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Đang chờ";
    Layout = "_LayoutSA";   
}

<div class="sa-container">
    <div class="sa-left">
        <div class="sa-left-search">
            @await Html.PartialAsync("_SA_GetSample_Search")
        </div>
        <div id="listPatient" class="sa-left-list">
            @await Html.PartialAsync("_SA_GetSample_ListPatient")
        </div>
    </div>
    <div class="sa-right">
        <div id="patientInfo" class="sa-right-info">
            @await Html.PartialAsync("_SA_GetSample_PatientInfo")
        </div>
        <div id="patientService" class="sa-right-service">
            <div id="sa-right-service-group" class="sa-right-service-group">
                @await Html.PartialAsync("_SA_GetSample_GroupButton")
            </div>
            <div id="sa-right-service-gridview" class="sa-right-service-gridview">
                @await Html.PartialAsync("_SA_GetSample_ListService")
            </div>
        </div>
    </div>
</div>