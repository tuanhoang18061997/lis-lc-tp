@{
    Layout = ViewData["UseNoLayout"] != null ? null : "_LayoutExport";
    var _lstResultXN = ViewData["ListResultXN"] as List<ResultXN>;
    var _note = ViewData["Note"] as String;
    var _groupResultByCategory = _lstResultXN.GroupBy(p => p.Service.CategoryId);

    var _showNote = ViewData["ShowNote"] == null || Convert.ToBoolean(ViewData["ShowNote"]);

    // Khi render riêng nước tiểu, không dùng <thead>
    // để tránh SelectPdf tự kéo header table lên cuối trang trước.
    var _disableThead = ViewData["DisableThead"] != null && Convert.ToBoolean(ViewData["DisableThead"]);
}
@model Hospital
<div class="result-xn">
    <table class="table-result">
        @if (!_disableThead)
        {
            <thead class="thead">
                <tr class="tr-title">
                    <th class="th-name" scope="col">TÊN XÉT NGHIỆM</th>
                    <th class="th-result" scope="col">KẾT QUẢ</th>
                    <th class="th-normalresult" scope="col">CHỈ SỐ BÌNH THƯỜNG</th>
                    <th class="th-unit" scope="col">ĐƠN VỊ</th>
                </tr>
            </thead>
        }
        <tbody class="tbody tr-title-body">
            @if (_disableThead)
            {
                <tr style="height:60px; font-weight:bold;">
                    <td style="width:440px; text-align:center; vertical-align:middle; border:1px solid black; font-weight:bold; height:60px;">
                        TÊN XÉT NGHIỆM
                    </td>
                    <td style="width:150px; text-align:center; vertical-align:middle; border:1px solid black; font-weight:bold; height:60px;">
                        KẾT QUẢ
                    </td>
                    <td style="width:210px; text-align:center; vertical-align:middle; border:1px solid black; font-weight:bold; height:60px;">
                        CHỈ SỐ BÌNH THƯỜNG
                    </td>
                    <td style="width:160px; text-align:center; vertical-align:middle; border:1px solid black; font-weight:bold; height:60px; white-space:nowrap;">
                        ĐƠN VỊ
                    </td>
                </tr>
            }
            @if (_groupResultByCategory != null)
            {
                foreach (var _group in _groupResultByCategory)
                {
                    var _results = _group.ToList();
                    if (_results != null)
                    {
                        <tr class="tr-category">
                            <td class="td-category" colspan="4">@_results[0].Service?.Category?.Name.ToUpper()</td>
                        </tr>
                        foreach (var _result in _results)
                        {
                            <tr class="tr-content">
                                @if (_result.TestCode.IsTestChild)
                                {
                                    if (_result?.Status == 1 || _result?.Status == 2)
                                    {
                                        <td class="td-name bold">&nbsp;&nbsp;&nbsp; @_result?.TestCode?.Name</td>
                                    }
                                    else
                                    {
                                        <td class="td-name">&nbsp;&nbsp;&nbsp; @_result?.TestCode?.Name</td>
                                    }
                                }
                                else
                                {
                                    <td class="td-name">@_result?.TestCode?.Name</td>
                                }
                                @if (_result?.Status == 1 || _result?.Status == 2)
                                {
                                    <td class="td-result bold">@_result?.Result</td>
                                }
                                else
                                {
                                    <td class="td-result">@_result?.Result</td>
                                }
                                @if (_result?.Patient?.Sex == "Nam" && !String.IsNullOrEmpty(_result?.TestCode?.NormalRangeM))
                                {
                                    <td class="td-normalresult">@_result?.TestCode?.NormalRangeM</td>
                                }
                                else if (_result?.Patient?.Sex == "Nữ" && !String.IsNullOrEmpty(_result?.TestCode?.NormalRangeF))
                                {
                                    <td class="td-normalresult">@_result?.TestCode?.NormalRangeF</td>
                                }
                                else
                                {
                                    <td class="td-normalresult">@_result?.TestCode?.NormalResult</td>
                                }
                                <td class="td-unit"><unit text="@_result?.TestCode.Unit"></unit></td>
                            </tr>
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>
@if (_showNote)
{
    <div class="result-xn-note">
        <div class="result-xn-note-label">
            <label>*Ghi chú: </label>
        </div>
        <div class="result-xn-note-text">
            <span>@_note</span>
        </div>
    </div>
}