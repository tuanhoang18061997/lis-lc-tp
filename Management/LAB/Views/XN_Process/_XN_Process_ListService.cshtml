@using Management.Extensions
@{
    var lstresultXNs = ViewData["lstResultXNs"] as List<ResultXN>;
    var note = ViewData["note"] as String;
    var patientInfo = ViewData["patientInfo"] as Patient;

    var _groupResultByCategory = lstresultXNs?.GroupBy(p => p.Service.CategoryId); // Bật hiển thị xét nghiệm theo nhóm danh mục
}
<!-- Modal: Import xét nghiệm ngoài -->
<div class="modal fade" id="modal-import-external" tabindex="-1" role="dialog" aria-labelledby="importExternalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="importExternalLabel">Import xét nghiệm ngoài (PDF)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true ">&times;</span>
                </button>
            </div>

            <div class="modal-body pt-2">
                <form id="form-import-external" onsubmit="return false;">
                    <!-- patientId lấy từ màn hình xử lý -->
                    <input type="hidden" id="import_patientId" />
                    <input type="hidden" id="import_idTablePatient" />
                    <input type="hidden" id="import_patientName" />
                    <input type="hidden" id="import_maBenhAn" />

                    <div class="form-row row">
                        <!-- CỘT TRÁI: các input -->
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Tệp PDF kết quả (từ cơ sở ngoài):</label>
                                <input type="file"
                                       id="import_pdf_file"
                                       accept="application/pdf"
                                       class="form-control"
                                       onchange="Process_HandlePdfPreview(this)" />
                                <small class="form-text text-muted">
                                    Chỉ nhận PDF. Dung lượng lớn vui lòng chờ sau khi nhấn "Import".
                                </small>
                            </div>

                            <div class="form-group">
                                <label>Tùy chọn:</label>
                                <div class="custom-control custom-checkbox" style="display: none">
                                    <input type="checkbox" checked class="custom-control-input" id="import_overwrite">
                                    <label class="custom-control-label" for="import_overwrite">
                                        Ghi đè giá trị đang có (nếu trùng mã xét nghiệm)
                                    </label>
                                </div>
                                <div class="custom-control custom-checkbox mt-2" style="display: none">
                                    <input type="checkbox" checked class="custom-control-input" id="import_mark_valid">
                                    <label class="custom-control-label" for="import_mark_valid">
                                        Đặt trạng thái <em>Valid</em> cho các chỉ số import
                                    </label>
                                </div>
                                <div class="custom-control custom-switch mt-2">
                                    <input type="checkbox" class="custom-control-input" id="import_is_visible_to_user">
                                    <label class="custom-control-label" for="import_is_visible_to_user">
                                        Cho phép hiển thị file này cho người dùng
                                    </label>
                                </div>
                                <small class="form-text text-muted ml-1">
                                    Bật: file sẽ hiển thị trong danh sách cho người dùng. Tắt: chỉ lưu nội bộ trên hệ thống.
                                </small>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: danh sách PDF đã import -->
                        <div class="col-md-8">
                            <label>Các tệp đã import gần đây:</label>
                            <div id="imported_pdf_list"
                                 class="border rounded"
                                 style="height: 180px; overflow:auto; background:#fff;">
                                <div class="text-muted p-2">Chưa tải danh sách…</div>
                            </div>
                            <small class="text-muted">Bấm vào tên tệp để xem trước ở khung dưới.</small>
                        </div>
                    </div>
                    <div class="border rounded p-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Preview PDF</strong>
                            <span class="text-muted small">Hiển thị ngay khi bạn chọn file</span>
                        </div>
                        <div id="pdfPreview" class="w-100" style="height:70vh; background:#f8f9fa; display:flex; align-items:center; justify-content:center; border:1px dashed #ced4da;">
                            <em class="text-muted">Chưa có tệp được chọn…</em>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" id="btn_reset_modal_pdf_setting" class="btn btn-success"
                        onclick="Process_ResetExternalImportMode()" style="margin-right: 3rem;">
                    Làm mới
                </button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" onclick="Process_ResetExternalImportMode()">Đóng</button>
                <button type="button" id="btn_import_external_pdf" class="btn btn-primary" onclick="Process_SubmitExternalImport()">
                    <i class="fa fa-cloud-upload mr-1"></i> Import
                </button>
                <button type="button" id="btn_save_imported_pdf_setting" class="btn btn-success" onclick="Process_SaveImportedPdfSetting()" style="display:none;">
                    Lưu
                </button>

            </div>
        </div>
    </div>
</div>
<div class="xn-note">
    <div class="xn-note-label">
        <label>Ghi chú</label>
    </div>
    <div class="xn-note-input">
        <input type="text" id="xn_process_note" value="@note" class="form-control height-28 pading-left-5" />
    </div>
</div>
<div class="table-responsive">
    <table class="table table-bordered">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-number" scope="col"></th>
                <th class="th-name" scope="col">TÊN XÉT NGHIỆM</th>
                <th class="th-result" scope="col">KẾT QUẢ</th>
                <th class="th-previous-result" scope="col">KẾT QUẢ GẦN NHẤT</th>
                <th class="th-defaultvalue" scope="col">CHỈ SỐ BÌNH THƯỜNG</th>
                <th class="th-unit" scope="col">ĐƠN VỊ</th>
                <th class="th-editor" scope="col">NGƯỜI CHỈNH SỬA</th>
                <th class="th-validPrint" scope="col">
                    <div class="d-flex align-items-center" style="flex-direction: column;">
                        <span>VALID & IN</span>
                        <input class="form-check-input ms-2"
                               type="checkbox"
                               id="checkAllValidPrint"
                               onchange="Process_ToggleAllValidPrint(this)"
                               title="Chọn tất cả">
                    </div>
                </th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-service">
            @{
                if (_groupResultByCategory != null)
                {
                    var index = 0;
                    var idResult = string.Empty;
                    var result_posneg = string.Empty;
                    var tabInddex = 0;
                    
                    foreach (var _group in _groupResultByCategory)
                    {
                        var _results = _group.ToList();
                        if (_results != null && _results.Count > 0)
                        {
                            // Hiển thị tên danh mục
                            <tr class="tr-category">
                                <td class="td-category" colspan="8">@_results[0].Service?.Category?.Name.ToUpper()</td>
                            </tr>
                            
                            foreach (var item in _results)
                            {
                                index++;
                                tabInddex++;
                                idResult = "result" + index;
                                if (!string.IsNullOrEmpty(item.Result) && !string.IsNullOrEmpty(item.PosNeg))
                                {
                                    result_posneg = item.PosNeg + " (" + item.Result + ")";
                                }
                                else if (!string.IsNullOrEmpty(item.Result) && string.IsNullOrEmpty(item.PosNeg))
                                {
                                    result_posneg = item.Result;
                                }
                                else if (string.IsNullOrEmpty(item.Result) && !string.IsNullOrEmpty(item.PosNeg))
                                {
                                    result_posneg = item.PosNeg;
                                }
                                else
                                {
                                    result_posneg = string.Empty;
                                }

                                // Lấy kết quả gần nhất từ extension method
                                var previousResult = item.GetPreviousResult();
                                var previousReturnResultTime = item.GetPreviousReturnResultTime();
                                var previousStatus = item.GetPreviousStatus();

                                // Xác định màu cho previous result dựa theo previousStatus
                                var previousResultColor = previousStatus switch
                                {
                                    1 => "color:blue",
                                    2 => "color:red", 
                                    0 => "color:black",
                                    _ => "color:gray"
                                };

                                if (index % 2 != 0)
                                {
                                    <tr class="tr-content process-row-result">
                                        <td class="td-id" hidden>@item.Id</td>
                                        <td class="td-number">@index</td>
                                        <td class="td-name-process">@item.TestCode.Name</td>
                                        @{
                                            if (item?.Status == 0)
                                            {
                                                <td class="td-result">
                                                    <div class="status">
                                                        <button style="color:dimgrey" class="btn-status" onclick="Process_SetStatus_ClickButtonStatus(this, this.value, @index)" value="@item?.Status"><i class="bi bi-square-fill"></i></button>
                                                    </div>
                                                    <div class="result">
                                                        <input tabindex="@tabInddex" style="color:black" id="@idResult" type="text" class="form-control input-result" value="@result_posneg" />
                                                    </div>
                                                </td>
                                            }
                                            else if (item?.Status == 1)
                                            {
                                                <td class="td-result">
                                                    <div class="status">
                                                        <button style="color:blue" class="btn-status" onclick="Process_SetStatus_ClickButtonStatus(this, this.value, @index)" value="@item?.Status"><i class="bi bi-square-fill"></i></button>
                                                    </div>
                                                    <div class="result">
                                                        <input tabindex="@tabInddex" style="color:blue" id="@idResult" type="text" class="form-control input-result" value="@result_posneg" />
                                                    </div>
                                                </td>
                                            }
                                            else if (item?.Status == 2)
                                            {
                                                <td class="td-result">
                                                    <div class="status">
                                                        <button style="color:red" class="btn-status" onclick="Process_SetStatus_ClickButtonStatus(this, this.value, @index)" value="@item?.Status"><i class="bi bi-square-fill"></i></button>
                                                    </div>
                                                    <div class="result">
                                                        <input tabindex="@tabInddex" style="color:red" id="@idResult" type="text" class="form-control input-result" value="@result_posneg" />
                                                    </div>
                                                </td>
                                            }
                                        }
                                        <td class="td-previous-result">
                                            <span class="previous-result-text" style="@previousResultColor">@previousResult</span>
                                            <span class="previous-return-result-time">@previousReturnResultTime</span>
                                        </td>
                                        @{
                                            if (patientInfo.Sex == "Nam" && !String.IsNullOrEmpty(@item.TestCode.NormalRangeM))
                                            {
                                                <td class="td-defaultvalue">@item.TestCode.NormalRangeM</td>
                                            }
                                            else if (patientInfo.Sex == "Nữ" && !String.IsNullOrEmpty(@item.TestCode.NormalRangeF))
                                            {
                                                <td class="td-defaultvalue">@item.TestCode.NormalRangeF</td>
                                            } else
                                            {
                                                <td class="td-defaultvalue">@item.TestCode.NormalResult</td>
                                            }
                                        }
                                        <td class="td-unit"><unit text="@item.TestCode.Unit"></unit></td>
                                        <td class="td-editor">
                                            @if (item.UserUpdateId.HasValue)
                                            {
                                                <span title="User ID: @item.UserUpdateId">@(item.UserUpdate?.Name ?? item.UserUpdateId.ToString())</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="td-validPrint">
                                            @{
                                                if (item.ValidPrint)
                                                {
                                                    <input class="form-check-input validPrint" type="checkbox" value="@item.ValidPrint" checked id="flexCheckDefault" onchange="Process_UpdateCheckAllState()">
                                                }
                                                else
                                                {
                                                    <input class="form-check-input validPrint" type="checkbox" value="@item.ValidPrint" id="flexCheckDefault" onchange="Process_UpdateCheckAllState()">
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="process-row-result">
                                        <td class="td-id" hidden>@item.Id</td>
                                        <td class="td-number">@index</td>
                                        <td class="td-name-process">@item.TestCode.Name</td>
                                        @{
                                            if (item?.Status == 0)
                                            {
                                                <td class="td-result">
                                                    <div class="status">
                                                        <button style="color:dimgrey" class="btn-status" onclick="Process_SetStatus_ClickButtonStatus(this, this.value, @index)" value="@item?.Status"><i class="bi bi-square-fill"></i></button>
                                                    </div>
                                                    <div class="result">
                                                        <input tabindex="@tabInddex" style="color:black" id="@idResult" type="text" class="form-control input-result" value="@result_posneg" />
                                                    </div>
                                                </td>
                                            }
                                            else if (item?.Status == 1)
                                            {
                                                <td class="td-result">
                                                    <div class="status">
                                                        <button style="color:blue" class="btn-status" onclick="Process_SetStatus_ClickButtonStatus(this, this.value, @index)" value="@item?.Status"><i class="bi bi-square-fill"></i></button>
                                                    </div>
                                                    <div class="result">
                                                        <input tabindex="@tabInddex" style="color:blue" id="@idResult" type="text" class="form-control input-result" value="@result_posneg" />
                                                    </div>
                                                </td>
                                            }
                                            else if (item?.Status == 2)
                                            {
                                                <td class="td-result">
                                                    <div class="status">
                                                        <button style="color:red" class="btn-status" onclick="Process_SetStatus_ClickButtonStatus(this, this.value, @index)" value="@item?.Status"><i class="bi bi-square-fill"></i></button>
                                                    </div>
                                                    <div class="result">
                                                        <input tabindex="@tabInddex" style="color:red" id="@idResult" type="text" class="form-control input-result" value="@result_posneg" />
                                                    </div>
                                                </td>
                                            }
                                        }
                                        <td class="td-previous-result">
                                            <span class="previous-result-text" style="@previousResultColor">@previousResult</span>
                                            <span class="previous-return-result-time">@previousReturnResultTime</span>
                                        </td>
                                        @{
                                            if (patientInfo.Sex == "Nam" && !String.IsNullOrEmpty(@item.TestCode.NormalRangeM))
                                            {
                                                <td class="td-defaultvalue">@item.TestCode.NormalRangeM</td>
                                            }
                                            else if (patientInfo.Sex == "Nữ" && !String.IsNullOrEmpty(@item.TestCode.NormalRangeF))
                                            {
                                                <td class="td-defaultvalue">@item.TestCode.NormalRangeF</td>
                                            } else
                                            {
                                                <td class="td-defaultvalue">@item.TestCode.NormalResult</td>
                                            }
                                        }
                                        <td class="td-unit"><unit text="@item.TestCode.Unit"></unit></td>
                                        <td class="td-editor">
                                            @if (item.UserUpdateId.HasValue)
                                            {
                                                <span title="User ID: @item.UserUpdateId">@(item.UserUpdate?.Name ?? item.UserUpdateId.ToString())</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="td-validPrint">
                                            @{
                                                if (item.ValidPrint)
                                                {
                                                    <input class="form-check-input validPrint" type="checkbox" value="@item.ValidPrint" checked id="flexCheckDefault" onchange="Process_UpdateCheckAllState()">
                                                }
                                                else
                                                {
                                                    <input class="form-check-input validPrint" type="checkbox" value="@item.ValidPrint" id="flexCheckDefault" onchange="Process_UpdateCheckAllState()">
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    }
                }
            }
        </tbody>
    </table>
</div>