@{
    Layout = ViewData["UseNoLayout"] != null ? null : "_LayoutExport";
    var _lstResultXN = ViewData["ListResultXN"] as List<ResultXN>;
    var _groupResultByCategory = _lstResultXN.GroupBy(p => p.Service.CategoryId);
    var age = _lstResultXN[0]?.Patient?.IsYear == false ? _lstResultXN[0]?.Patient?.Age?.ToString("dd/MM/yyyy") : _lstResultXN[0]?.Patient?.Age?.ToString("yyyy");
    var getFirstEleOfSid = _lstResultXN[0]?.Patient?.Sid?.Split("-")[0];
    var customerSidStyle = getFirstEleOfSid + " - ";
}
@model Hospital
<div class="hospital-xn">
    <div class="hospital-logo">
        <img class="image" src="~/images/logo/@Model.Logo" />
    </div>
    <div class="hospital-info">
        <div class="hospital-info-name">
            @Model.Name.ToUpper()
        </div>
        <div class="hospital-info-address">
            @Model.Address
        </div>
        <div class="hospital-info-phonemail">
            @Model.Phone | @Model.Email | @Model.Website
        </div>
        <div class="hospital-info-title">
            <div class="hospital-info-title-text">
                KẾT QUẢ XÉT NGHIỆM
            </div>
            <div class="hospital-info-title-time">
                <div class="hospital-info-title-time-getsampletime">
                    Giờ lấy mẫu : @_lstResultXN[0]?.Patient?.GetSampleTimeXN?.ToString("dd/MM/yyyy HH:mm")
                </div>
                <div class="hospital-info-title-time-returnresulttime">
                    Giờ trả KQ &nbsp;: @_lstResultXN[0]?.Patient?.ReturnResultTimeXN?.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>
        </div>
    </div>
</div>
<div class="patient-xn">
    <div class="name-sex-age">
        <div class="name">
            <div class="label1">Họ tên</div>: @_lstResultXN[0]?.Patient?.PatientName.ToUpper()
        </div>
        <div class="sex">
            <div class="label2">Giới tính</div>: @_lstResultXN[0]?.Patient?.Sex
        </div>
        <div class="age">
            <div class="label2">Năm sinh</div>: @age
        </div>
    </div>
    <div class="sid-obj">
        <div class="sid">
            <div class="label1">Mã bệnh phẩm</div>: @customerSidStyle <span style="font-weight: bold">@_lstResultXN[0]?.Patient?.Seq</span>
        </div>
        <div class="obj">
            <div class="label2">Đối tượng</div>: @_lstResultXN[0]?.Patient?.Object?.Name
        </div>
    </div>
    <div class="address">
        <div class="label1">Địa chỉ</div>: @_lstResultXN[0]?.Patient?.Address
    </div>
@*     <div class="doctor-location">
        <div class="doctor">
            <div class="label1">Bác sĩ chỉ định</div>: @_lstResultXN[0]?.Patient.Doctor.Name
        </div>
        <div class="location">
            <div class="label2">Nơi chỉ định</div>: @_lstResultXN[0]?.Patient.Location.Name
        </div>
    </div> 
    <div class="diagnostic">
        <div class="label1">Chẩn đoán</div>: @_lstResultXN[0]?.Patient.Diagnostic
    </div>*@
</div>