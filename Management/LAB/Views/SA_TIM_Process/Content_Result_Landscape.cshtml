            <div class="child">
                <div class="label">Nhĩ phải : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_nhiphai_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">Tĩnh mạch : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_tinhmach_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">ĐM chủ : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_dmchu_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">Van ĐMP : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_vandmp_2d</label>
                </div>
            </div>
        </div>

        @* Right *@
        <div class="row-left">
            <div class="child">
                <div class="label">ĐM phổi : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_dmphoi_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">ĐM vành : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_dmvanh_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">Xoang vành : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_xoangvanh_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">Van hai lá : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_vanhaila_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">Van ba lá : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_vanbala_2d</label>
                </div>
            </div>
            <div class="child">
                <div class="label">Van ĐMC : </div>
                <div class="input">
                    <label class="result">@sieuamtimModel?.sat_vandmc_2d</label>
                </div>
            </div>
        </div>
    </div>
</div>
