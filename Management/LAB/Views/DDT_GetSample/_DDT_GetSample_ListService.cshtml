@{
    var lstresultCDHAs = ViewData["lstresultCDHAs"] as List<ResultCDHA>;
    var lstService = ViewData["lstService"] as List<Service>;
    var note = ViewData["note"] as String;

}
<!-- Modal: Import xét nghiệm ngoài -->
<div class="modal fade" id="modal-import-external" tabindex="-1" role="dialog" aria-labelledby="importExternalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="importExternalLabel">Import kết quả ngoài (PDF)</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Đóng">
                    <span aria-hidden="true ">&times;</span>
                </button>
            </div>

            <div class="modal-body pt-2">
                <form id="form-import-external" onsubmit="return false;">
                    <!-- patientId lấy từ màn hình xử lý -->
                    <input type="hidden" id="import_patientId" />
                    <input type="hidden" id="import_idTablePatient" />
                    <input type="hidden" id="import_patientName" />
                    <input type="hidden" id="import_maBenhAn" />

                    <div class="form-row row">
                        <!-- CỘT TRÁI: các input -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Tệp PDF kết quả (từ cơ sở ngoài):</label>
                                <input type="file"
                                       id="import_pdf_file"
                                       accept="application/pdf"
                                       class="form-control"
                                       onchange="GetSample_HandlePdfPreview(this)" />
                                <small class="form-text text-muted">
                                    Chỉ nhận PDF. Dung lượng lớn vui lòng chờ sau khi nhấn "Import".
                                </small>
                            </div>

                           @*  <div class="form-group">
                                <label>Nhà cung cấp (Vendor):</label>
                                <select id="import_vendor" class="form-control">
                                    <option value="TamAnLab">Tâm An Lab</option>
                                    <!-- Có thể thêm các vendor khác -->
                                </select>
                            </div> *@

                            <div class="form-group">
                                <label>Tùy chọn:</label>
                                <div class="custom-control custom-checkbox">
                                    <input type="checkbox" checked class="custom-control-input" id="import_overwrite">
                                    <label class="custom-control-label" for="import_overwrite">
                                        Ghi đè giá trị đang có (nếu trùng mã xét nghiệm)
                                    </label>
                                </div>
                                <div class="custom-control custom-checkbox mt-2">
                                    <input type="checkbox" checked class="custom-control-input" id="import_mark_valid">
                                    <label class="custom-control-label" for="import_mark_valid">
                                        Đặt trạng thái <em>Valid</em> cho các chỉ số import
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: danh sách PDF đã import -->
                        <div class="col-md-6">
                            <label>Các tệp đã import gần đây:</label>
                            <div id="imported_pdf_list"
                                 class="border rounded"
                                 style="height: 180px; overflow:auto; background:#fff;">
                                <div class="text-muted p-2">Chưa tải danh sách…</div>
                            </div>
                            <small class="text-muted">Bấm vào tên tệp để xem trước ở khung dưới.</small>
                        </div>
                    </div>
                    <div class="border rounded p-2">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Preview PDF</strong>
                            <span class="text-muted small">Hiển thị ngay khi bạn chọn file</span>
                        </div>
                        <div id="pdfPreview" class="w-100" style="height:70vh; background:#f8f9fa; display:flex; align-items:center; justify-content:center; border:1px dashed #ced4da;">
                            <em class="text-muted">Chưa có tệp được chọn…</em>
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-primary" onclick="GetSample_SubmitExternalImport()">
                    <i class="fa fa-cloud-upload mr-1"></i> Import
                </button>
            </div>
        </div>
    </div>
</div>
<div class="table-responsive">
    <table class="table table-bordered">
        <thead class="sticky-top">
            <tr class="tr-title">
                <th class="th-number" scope="col">STT</th>
                <th class="th-name" scope="col">TÊN DỊCH VỤ</th>
                <th class="th-delete" scope="col"></th>
            </tr>
        </thead>
        <tbody id="tbody-gridview-service">
            @{
                if (lstresultCDHAs != null && lstresultCDHAs.Count > 0)
                {
                    var index = 0;
                    foreach (var item in lstresultCDHAs)
                    {
                        index++;
                        <tr>
                            <td class="td-number">@index</td>
                            <td class="td-name">@item.Service.Name</td>
                            <td class="td-delete">
                                <button type="button" class="btn btn-outline-danger btn-red-in-gridview" value="@item.Id" onclick="GetSample_DeleteServiceForPatient(this.value)">x</button>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>

<!-- From thêm dịch vụ cho bệnh nhân -->
<div class="modal" id="addServiceForm" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" role="dialog" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="ddt-right-add-service-for-patient-title">
                <div class="title">THÊM DỊCH VỤ</div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="ddt-right-add-service-for-patient-service">
                <div class="title">Dịch vụ</div>
                <div class="content">
                    <select id="ddt_getsample_service" name="service" class="form-select height-28">
                        @if (lstService != null)
                        {
                            foreach (var item in lstService)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div class="ddt-right-add-service-for-patient-button">
                <button id="ddt-getsample_addserviceforpatient" class="btn btn-success btn-blue" data-bs-dismiss="modal" onclick="GetSample_AddServiceForPatient()">
                    <i class="bi bi-download"></i> Lưu
                </button>
            </div>
        </div>
    </div>
</div>
<!-- From thêm dịch vụ cho bệnh nhân -->
