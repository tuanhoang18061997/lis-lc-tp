@{
    ViewData["Title"] = "Lấy mẫu";
    Layout = "_LayoutXN";   
}

<div class="xn-container">
    <div class="xn-left">
        <div class="xn-left-search">
            @await Html.PartialAsync("_XN_GetSample_Search")
        </div>
        <div id="listPatient" class="xn-left-list">
            @await Html.PartialAsync("_XN_GetSample_ListPatient")
        </div>
    </div>
    <div class="xn-right">
        <div id="patientInfo" class="xn-right-info">
            @await Html.PartialAsync("_XN_GetSample_PatientInfo")
        </div>
        <div id="patientService" class="xn-right-service">
            <div id="xn-right-service-group" class="xn-right-service-group">
                @await Html.PartialAsync("_XN_GetSample_GroupButton")
            </div>
            <div id="xn-right-service-gridview" class="xn-right-service-gridview">
                @await Html.PartialAsync("_XN_GetSample_ListService")
            </div>
        </div>
    </div>
</div>